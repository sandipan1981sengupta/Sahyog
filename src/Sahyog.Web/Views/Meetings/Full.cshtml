@model TenantLimitsDto
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Meeting is full";
}
<div class="auth-card glass-strong center">
    <h2>This meeting is full</h2>
    <p class="muted">Your @Model.PlanName plan allows @Model.MaxMeetingParticipants people per meeting. Ask your admin to upgrade the plan for bigger meetings.</p>
    <a class="btn btn-primary" href="/meetings">Back to meetings</a>
</div>
