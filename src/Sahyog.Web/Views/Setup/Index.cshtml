@model SetupInput
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Set up ShankhNaad";
}
<section class="sn-hero">
    <strip-header heading="SHANKHNAAD" css-class="sn-brand"
                  subheading="FIRST-TIME SETUP"
                  icon-src="/images/logo.svg"
                  icon-size="84"
                  icon-image-size="74%"
                  icon-background-color="rgba(255,255,255,.55)"
                  icon-border-color="rgba(255,255,255,.9)"
                  heading-font-size="52"
                  heading-font-weight="900"
                  heading-font-family="Roboto, system-ui, sans-serif"
                  heading-gradient-start="#2563EB"
                  heading-gradient-mid="#6D28D9"
                  heading-gradient-end="#DB2777"
                  heading-gradient-start-hold-percent="10"
                  heading-gradient-mid-stop-percent="55"
                  heading-fallback-color="#1D4ED8"
                  subheading-font-size="12"
                  subheading-font-weight="700"
                  subheading-font-family="Roboto, system-ui, sans-serif"
                  subheading-gradient-start="#475569"
                  subheading-gradient-end="#475569"></strip-header>
    <p class="sn-hero-line">Welcome. <span class="sn-grad-text">Let's set up ShankhNaad.</span></p>
    <p class="sn-small" style="font-size:15px">Create the CloudWheel super admin. You can also create your first client workspace now. This page works only once.</p>
</section>

<div class="sn-window-wrap">
    <div class="sn-window-orbs" aria-hidden="true"><span class="w1"></span><span class="w2"></span><span class="w3"></span></div>
    <form method="post" asp-action="Index" class="sn-window glass-clear" novalidate>
        <div class="sn-window-top">
            <div><div class="sn-eyebrow">Step 1</div><h2>Super admin</h2></div>
            <span class="sn-lock"><i class="fa fa-shield" aria-hidden="true"></i></span>
        </div>
        <div asp-validation-summary="All" class="form-error" role="alert"></div>

        <modern-input id="AdminName" name="AdminName" label="Your name" mandatory="true" value="@Model.AdminName" max-length="100" label-font-size="13.5px"></modern-input>
        <modern-input id="AdminEmail" name="AdminEmail" label="Email" mandatory="true" value="@Model.AdminEmail" placeholder="admin@cloudwheel.com" max-length="200" label-font-size="13.5px"></modern-input>
        <modern-input id="AdminPassword" name="AdminPassword" label="Password" mandatory="true" is-password="true" placeholder="At least 8 characters" label-font-size="13.5px"></modern-input>
        <modern-input id="ConfirmPassword" name="ConfirmPassword" label="Confirm password" mandatory="true" is-password="true" label-font-size="13.5px"></modern-input>

        <modern-checkbox id="CreateWorkspace" name="CreateWorkspace" label="Also create my first client" is-toggle-button="true" checked="@Model.CreateWorkspace" label-font-size="13.5px"></modern-checkbox>

        <div id="clientFields" class="sn-reveal"><div class="sn-reveal-in" style="display:flex;flex-direction:column;gap:14px">
            <modern-input id="CompanyName" name="CompanyName" label="Client company name" value="@Model.CompanyName" placeholder="Acme Corp" max-length="120" label-font-size="13.5px"></modern-input>
            <modern-input id="Workspace" name="Workspace" label="Workspace" value="@Model.Workspace" placeholder="acme  (acme.shankhnaad.app)" max-length="40" label-font-size="13.5px"></modern-input>
            <modern-input id="ClientAdminName" name="ClientAdminName" label="Client admin name" value="@Model.ClientAdminName" max-length="100" label-font-size="13.5px"></modern-input>
            <modern-input id="ClientAdminEmail" name="ClientAdminEmail" label="Client admin email" value="@Model.ClientAdminEmail" placeholder="admin@acme.com" max-length="200" label-font-size="13.5px"></modern-input>
            <modern-input id="ClientAdminPassword" name="ClientAdminPassword" label="Client admin password" is-password="true" placeholder="At least 8 characters" label-font-size="13.5px"></modern-input>
        </div></div>
        <input type="hidden" asp-for="PlanId" />

        <button type="submit" class="cee-btn cee-btn-gradient sn-signin">Finish setup <i class="fa fa-arrow-right" aria-hidden="true"></i></button>
    </form>
</div>

@section Scripts {
    <script>
        (function () {
            var box = document.getElementById("CreateWorkspace");
            var fields = document.getElementById("clientFields");
            function apply() {
                var off = !box.checked;
                fields.classList.toggle("is-collapsed", off);
                fields.setAttribute("aria-hidden", off ? "true" : "false");
                if ("inert" in fields) fields.inert = off;
            }
            box.addEventListener("change", apply);
            document.documentElement.classList.add("sn-still");
            apply();
            requestAnimationFrame(function () { requestAnimationFrame(function () { document.documentElement.classList.remove("sn-still"); }); });
        })();
    </script>
}
