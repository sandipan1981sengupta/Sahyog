@model GuestJoinViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = Model.Title;
}
<form method="post" class="auth-card glass-strong guest-card">
    <div class="brand center-row">
        <span class="brand-mark"><img src="~/images/logo.svg" alt="" width="40" height="40" /></span>
        <span class="brand-text"><strong>ShankhNaad</strong><small>@Model.WorkspaceName</small></span>
    </div>
    <div class="center">
        <p class="muted small">@Model.HostName invited you to</p>
        <h2>@Model.Title</h2>
        <p class="muted">@Model.When</p>
    </div>
    @if (Model.Error is string err)
    {
        <div class="form-error" role="alert">@err</div>
    }
    <div class="field">
        <label for="guestName">Your name</label>
        <input id="guestName" name="name" class="input" maxlength="60" value="@Model.Name" placeholder="e.g. Ravi from Acme" required autofocus />
    </div>
    <button type="submit" class="btn btn-gradient btn-lg">Join meeting</button>
    <p class="muted center tiny">Your browser will ask to use your camera and microphone. The host may let you in from the lobby.</p>
</form>
