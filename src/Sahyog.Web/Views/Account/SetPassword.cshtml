@model SetPasswordViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Set your password";
    var link = Model.Link;
    var welcome = link?.Purpose == PasswordLinkPurpose.Welcome;
}
<partial name="_AuthHero" />

<div class="sn-window-wrap">
    <div class="sn-window-orbs" aria-hidden="true"><span class="w1"></span><span class="w2"></span><span class="w3"></span></div>

    <form method="post" asp-action="SetPassword" class="sn-window glass-clear" novalidate>
        <div class="sn-window-top">
            <div>
                <div class="sn-eyebrow">@(welcome ? "Welcome to ShankhNaad" : "ShankhNaad account")</div>
                <h2>@(welcome ? "Set your password" : "Choose a new password")</h2>
            </div>
            <span class="sn-lock"><i class="fa fa-key" aria-hidden="true"></i></span>
        </div>

        @if (link is null || link.Problem is not null)
        {
            <div class="notice warn">@(link?.Problem ?? "This link isn't valid. Check you copied the whole address from the email, or ask for a new one.")</div>
            <a class="cee-btn cee-btn-gradient sn-signin" href="/account/forgot">Get a new link <i class="fa fa-arrow-right" aria-hidden="true"></i></a>
            <p class="sn-small center"><a href="/account/login"><i class="fa fa-arrow-left" aria-hidden="true"></i> Back to sign in</a></p>
        }
        else
        {
            <div class="sn-who">
                <span class="sn-who-row"><span>Name</span><b>@link.DisplayName</b></span>
                <span class="sn-who-row"><span>Email</span><b>@link.Email</b></span>
                @if (!string.IsNullOrEmpty(link.TenantSlug))
                {
                    <span class="sn-who-row"><span>Workspace</span><b>@link.TenantSlug</b></span>
                }
            </div>
            <p class="sn-small">@(welcome ? "Choose a password of at least 8 characters. You'll use it with the workspace and email above to sign in." : "Choose a new password of at least 8 characters. This signs you out on your other devices.")</p>

            <div asp-validation-summary="ModelOnly" class="form-error" role="alert"></div>
            <input type="hidden" name="Token" value="@Model.Token" />
            <div>
                <modern-input id="NewPassword" name="NewPassword" label="New password" mandatory="true" is-password="true"
                              placeholder="At least 8 characters" label-font-size="13.5px"></modern-input>
                <span asp-validation-for="NewPassword" class="field-error"></span>
            </div>
            <div>
                <modern-input id="ConfirmPassword" name="ConfirmPassword" label="Type it again" mandatory="true" is-password="true"
                              placeholder="The same password" label-font-size="13.5px"></modern-input>
                <span asp-validation-for="ConfirmPassword" class="field-error"></span>
            </div>
            <button type="submit" class="cee-btn cee-btn-gradient sn-signin">Save password <i class="fa fa-check" aria-hidden="true"></i></button>
        }
    </form>
</div>

@section Scripts {
    <script>
        // quick checks before sending (the server checks again)
        $("form.sn-window").on("submit", function (e) {
            var a = $("#NewPassword").val() || "", b = $("#ConfirmPassword").val() || "";
            if (!$("#NewPassword").length) return;
            var problem = a.length < 8 ? "Use at least 8 characters." : a !== b ? "The two passwords don't match." : "";
            if (problem) { e.preventDefault(); Sahyog.toast(problem, { kind: "warn", title: "Check your password" }); }
        });
    </script>
}
