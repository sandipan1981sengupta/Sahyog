@{
    var section = ViewData["Section"] as string ?? "";
    var isTenantAdmin = User.IsInRole(AppRoles.TenantAdmin);
    var isSuperAdmin = User.IsInRole(AppRoles.SuperAdmin);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#2563EB" />
    <title>@(ViewData["Title"] is string t ? $"{t} · Sahyog" : "Sahyog")</title>
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Head", required: false)
</head>
<body>
    <div class="bg-blobs" aria-hidden="true"><span></span><span></span><span></span></div>
    @Html.AntiForgeryToken()

    <div class="shell">
        <nav class="rail glass" aria-label="App">
            <a class="rail-logo" href="/" aria-label="Sahyog home"><img src="~/images/logo.svg" alt="" width="34" height="34" /></a>
            @if (!isSuperAdmin)
            {
                <a class="rail-btn @(section == "chat" ? "active" : "")" href="/chat" aria-label="Chat" title="Chat">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.4A8 8 0 1 1 21 12z" /></svg>
                </a>
                <a class="rail-btn @(section == "meetings" ? "active" : "")" href="/meetings" aria-label="Meetings" title="Meetings">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="3" /><path d="M3 10h18M8 3v4M16 3v4" /></svg>
                </a>
                @if (isTenantAdmin)
                {
                    <a class="rail-btn @(section == "team" ? "active" : "")" href="/team" aria-label="Team" title="Team">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="8" r="3.5" /><path d="M2.5 20a6.5 6.5 0 0 1 13 0" /><path d="M16 4.5a3.5 3.5 0 0 1 0 7" /><path d="M18 14a6 6 0 0 1 3.5 6" /></svg>
                    </a>
                }
            }
            @if (isSuperAdmin)
            {
                <a class="rail-btn @(section == "admin" ? "active" : "")" href="/admin" aria-label="Super admin" title="Super admin">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l8 4v5c0 5-3.5 8-8 9-4.5-1-8-4-8-9V7z" /></svg>
                </a>
            }
            <div class="rail-spacer"></div>
            <button type="button" class="rail-btn" id="alertsBtn" hidden aria-label="Turn on call alerts" title="Turn on call alerts">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9" /><path d="M10.3 21a1.9 1.9 0 0 0 3.4 0" /></svg>
            </button>
            <form method="post" action="/account/logout" class="rail-me">
                <button type="submit" class="avatar av-44 tone-@(User.AvatarTone()) ring-white" title="Sign out (@User.DisplayName())" aria-label="Sign out">@User.Initials()</button>
            </form>
        </nav>

        @RenderBody()
    </div>

    <div class="call-overlay" id="callOverlay" hidden>
        <div class="call-card glass" role="alertdialog" aria-labelledby="callTitle" aria-describedby="callWho">
            <div class="call-rings"><span></span><span></span><span></span><span class="avatar av-96" id="callAvatar">?</span></div>
            <p class="call-label">Incoming call</p>
            <h2 id="callWho">Someone</h2>
            <p id="callTitle" class="muted">Meeting</p>
            <div class="call-actions">
                <button type="button" class="btn btn-danger" id="callDecline">Decline</button>
                <a class="btn btn-success" id="callAccept" href="#">Join</a>
            </div>
        </div>
    </div>
    <div class="toasts" id="toasts" aria-live="polite"></div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
