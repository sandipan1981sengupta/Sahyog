@model TeamViewModel
@{
    ViewData["Title"] = "Team";
    ViewData["Section"] = "team";
    var full = Model.ActiveUsers >= Model.Limits.MaxUsers;
    // admins add, edit, remove and restore people; members only see the list (the server enforces this too)
    var isAdmin = User.IsInRole(AppRoles.TenantAdmin);
    var m = Model.NewMember;
    var me = User.UserId();
    string Email(string id) => Model.Emails.TryGetValue(id, out var e) ? e : "";

    var rows = Model.People.Select(p => new Dictionary<string, object>
    {
        ["Id"] = p.Id,
        ["Name"] = p.Id == me ? p.Name + " (you)" : p.Name,
        ["DisplayName"] = p.Name,     // edit window (no "(you)")
        ["IsMe"] = p.Id == me,
        ["Email"] = Email(p.Id),
        ["Role"] = p.Role ?? "Member",
        ["Status"] = p.Pending ? "Invited" : p.Online ? "Online" : "Offline",
        ["Pending"] = p.Pending,
        ["Active"] = true
    }).Concat(Model.Inactive.Select(p => new Dictionary<string, object>
    {
        ["Id"] = p.Id,
        ["Name"] = p.Name,
        ["DisplayName"] = p.Name,
        ["IsMe"] = false,
        ["Email"] = Email(p.Id),
        ["Role"] = p.Role ?? "Member",
        ["Status"] = "Inactive",
        ["Pending"] = false,
        ["Active"] = false
    })).ToList();

    var online = Model.People.Count(p => p.Online);
    var invited = Model.People.Count(p => p.Pending);
    var invitedMeta = invited > 0 ? ", { text: \"" + invited + " invited\", dot: \"admin\" }" : "";
    // e-mail domains already used here, for the "Did you mean …?" hint
    var knownDomains = System.Text.Json.JsonSerializer.Serialize(Model.Emails.Values
        .Select(e => e.Contains('@') ? e.Substring(e.LastIndexOf('@') + 1) : "")
        .Where(d => d.Length > 0).Distinct());
    var admins = Model.People.Count(p => p.Role == "Admin");
    var adminsText = admins == 1 ? "1 admin" : $"{admins} admins";
    var freeSeats = Math.Max(0, Model.Limits.MaxUsers - Model.ActiveUsers);
    // right-hand gauges: seats and storage
    var seatsTotal = Model.Limits.MaxUsers;
    var seatsUsed = Model.ActiveUsers;
    var seatsPct = seatsTotal > 0 ? Math.Min(100, seatsUsed * 100.0 / seatsTotal) : 0;
    var storeTotal = Model.Limits.StorageQuotaBytes;
    var storeUsed = Model.Limits.StorageUsedBytes;
    var storeFree = Math.Max(0, storeTotal - storeUsed);
    var storePct = storeTotal > 0 ? Math.Min(100, storeUsed * 100.0 / storeTotal) : 0;
    // length of the filled part of the gauge arc (radius 84: half circle = 263.89); a sliver stays visible for tiny values
    string Arc(double pct) => ((pct <= 0 ? 0 : Math.Max(1.5, pct)) * 2.6389).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) + " 1000";
    string Pct(double pct) => pct <= 0 ? "0%" : pct < 1 ? "<1%" : $"{Math.Round(pct)}%";
}

<main class="sn-page">
    <div class="sn-head glass">
        <action-header id="TeamHeader"
                       heading="Team"
                       subtitle="@($"{Model.Limits.TenantName} · {Model.ActiveUsers} of {Model.Limits.MaxUsers} people · {Model.Limits.PlanName} plan")"
                       left-icon-css="bi bi-people-fill" left-icon-size="26"
                       left-icon-gradient-start="#2563EB" left-icon-gradient-mid="#7C3AED" left-icon-gradient-end="#DB2777"
                       background-color="transparent" box-shadow="none"
                       refresh-color="#1D4ED8" add-color="#1D4ED8" delete-color="#DC2626" export-color="#15803D" print-color="#334155"
                       show-refresh="true" refresh-on-click="SN.reload()"
                       show-add="@isAdmin" add-text="Add person" add-on-click="@(full ? "snPlanFull()" : "SN.open('addMemberDialog')")"
                       show-edit="@isAdmin" edit-text="Edit" edit-on-click="snEditPerson()"
                       show-delete="@isAdmin" delete-text="Deactivate" delete-on-click="snRemovePerson()"
                       show-import="false"
                       show-export="true" export-on-click="SN.exportTable('TeamTable','team')"
                       show-save="false" show-submit="false"
                       show-print="true" print-on-click="SN.print()">
            @if (isAdmin)
            {
                <action-btn text="Activate" icon-css="bi bi-person-check-fill" icon-color="#16A34A" tooltip="Let an inactive person sign in again" on-click="snRestorePerson()"></action-btn>
                @if (Model.CanEmail)
                {
                    <action-btn text="Resend invite" icon-css="bi bi-envelope-arrow-up-fill" icon-color="#D97706" tooltip="Send a new invite to someone who hasn't joined yet" on-click="snResendInvite()"></action-btn>
                }
            }
        </action-header>
    </div>

    @if (Model.Message is string msg)
    {
        <div hidden data-toast="@msg" data-toast-kind="success"></div>
    }
    @if (Model.Error is string err)
    {
        <div hidden data-toast="@err" data-toast-kind="error"></div>
    }
    @if (full && isAdmin)
    {
        <div hidden data-toast="Your plan's user limit is reached. Ask CloudWheel to upgrade your plan to add more people." data-toast-kind="warn" data-toast-title="Plan is full"></div>
    }
    @if (!isAdmin)
    {
        <div hidden data-toast="You can see everyone in your workspace. Only workspace admins can add, edit or remove people." data-toast-title="View only"></div>
    }

    <div class="sn-grid-4">
        <div class="sn-stat glass"><span class="sn-stat-ic" style="background:rgba(37,99,235,.1);color:#1d4ed8"><i class="fa fa-users"></i></span><div><div class="sn-eyebrow">People</div><div class="sn-stat-val">@Model.ActiveUsers / @Model.Limits.MaxUsers</div></div></div>
        <div class="sn-stat glass"><span class="sn-stat-ic" style="background:rgba(22,163,74,.1);color:#15803d"><i class="fa fa-circle"></i></span><div><div class="sn-eyebrow">Online now</div><div class="sn-stat-val">@online</div></div></div>
        <div class="sn-stat glass"><span class="sn-stat-ic" style="background:rgba(190,24,93,.1);color:#be185d"><i class="fa fa-shield"></i></span><div><div class="sn-eyebrow">Admins</div><div class="sn-stat-val">@admins</div></div></div>
        <div class="sn-stat glass"><span class="sn-stat-ic" style="background:rgba(124,58,237,.1);color:#6d28d9"><i class="fa fa-hdd-o"></i></span><div><div class="sn-eyebrow">Storage</div><div class="sn-stat-val">@UserExtensions.FormatBytes(Model.Limits.StorageUsedBytes)</div></div></div>
    </div>

    <div class="sn-row" style="flex:1 1 auto">
        <div class="sn-grow">
            <modern-table id="TeamTable" name="SelectedPerson"
                          grid-name="People" icon="users" icon-background-color="linear-gradient(115deg,#2563EB,#DB2777)" icon-color="#fff"
                          show-grid-name-and-icon="true"
                          searchable="true" search-placeholder="Search people..."
                          show-filter-button="true" filter-row-open="false"
                          column-toggle="true" selectable="true" enable-paging="true" page-size="50"
                          is-animated-scrolling="true" row-height="52px" header-height="42px"
                          row-id-field="Id" table-height="100%"
                          items="rows">
                <column field="Id" header="Id" visible="false" filterable="false" sortable="false"></column>
                <column field="Name" header="Name" width="220px"></column>
                <column field="Email" header="Email" width="260px"></column>
                <column field="Role" header="Role" type="badge" width="120px">
                    <badge value="Admin" color="#DBEAFE"></badge>
                    <badge value="Member" color="#E2E8F0"></badge>
                </column>
                <column field="Status" header="Status" type="badge" width="130px">
                    <badge value="Online" color="#DCFCE7"></badge>
                    <badge value="Offline" color="#E2E8F0"></badge>
                    <badge value="Invited" color="#FEF3C7"></badge>
                    <badge value="Inactive" color="#FFE4E6"></badge>
                </column>
                @if (isAdmin)
                {
                    <column field="Active" header="Active" type="toggle" width="100px" cell-align="center" header-align="center" filterable="false"></column>
                }
            </modern-table>
        </div>

        <div class="sn-side">
            @* ---- seats ---- *@
            <section class="sn-gauge-card glass" aria-label="Seats: @seatsUsed used, @freeSeats free, @seatsTotal total">
                <header class="sn-gauge-head">
                    <span class="sn-gauge-ic seats"><i class="fa fa-users" aria-hidden="true"></i></span>
                    <div class="sn-gauge-title">
                        <h3>Seats</h3>
                        <small>@seatsUsed used · @freeSeats free · @seatsTotal total</small>
                    </div>
                    <span class="sn-gauge-pill">@Model.Limits.PlanName plan</span>
                </header>
                <div class="sn-gauge">
                    <svg viewBox="0 0 200 112" aria-hidden="true">
                        <defs>
                            <linearGradient id="gSeats" x1="0" y1="0" x2="1" y2="0">
                                <stop offset="0" stop-color="#2563EB" /><stop offset=".55" stop-color="#7C3AED" /><stop offset="1" stop-color="#DB2777" />
                            </linearGradient>
                        </defs>
                        <path class="sn-gauge-track" d="M16 100 A84 84 0 0 1 184 100" />
                        <path class="sn-gauge-value" d="M16 100 A84 84 0 0 1 184 100" stroke="url(#gSeats)" stroke-dasharray="@Arc(seatsPct)" />
                    </svg>
                    <div class="sn-gauge-center">
                        <b>@seatsUsed<span>/@seatsTotal</span></b>
                        <small>@Pct(seatsPct) in use</small>
                    </div>
                </div>
                <div class="sn-gauge-stats">
                    <div><span class="sn-gs-label"><i class="sn-gs-dot used"></i>Used</span><b>@seatsUsed</b></div>
                    <div><span class="sn-gs-label"><i class="sn-gs-dot free"></i>Free</span><b>@freeSeats</b></div>
                    <div><span class="sn-gs-label"><i class="sn-gs-dot total"></i>Total</span><b>@seatsTotal</b></div>
                </div>
            </section>

            @* ---- storage ---- *@
            <section class="sn-gauge-card glass" aria-label="Storage: @UserExtensions.FormatBytes(storeUsed) used of @UserExtensions.FormatBytes(storeTotal)">
                <header class="sn-gauge-head">
                    <span class="sn-gauge-ic store"><i class="fa fa-hdd-o" aria-hidden="true"></i></span>
                    <div class="sn-gauge-title">
                        <h3>Storage</h3>
                        <small>@UserExtensions.FormatBytes(storeUsed) used · @UserExtensions.FormatBytes(storeFree) free · @UserExtensions.FormatBytes(storeTotal) total</small>
                    </div>
                </header>
                <div class="sn-gauge">
                    <svg viewBox="0 0 200 112" aria-hidden="true">
                        <defs>
                            <linearGradient id="gStore" x1="0" y1="0" x2="1" y2="0">
                                <stop offset="0" stop-color="#DB2777" /><stop offset=".55" stop-color="#A855F7" /><stop offset="1" stop-color="#F59E0B" />
                            </linearGradient>
                        </defs>
                        <path class="sn-gauge-track" d="M16 100 A84 84 0 0 1 184 100" />
                        <path class="sn-gauge-value" d="M16 100 A84 84 0 0 1 184 100" stroke="url(#gStore)" stroke-dasharray="@Arc(storePct)" />
                    </svg>
                    <div class="sn-gauge-center">
                        <b>@Pct(storePct)</b>
                        <small>of @UserExtensions.FormatBytes(storeTotal) used</small>
                    </div>
                </div>
                <div class="sn-gauge-stats">
                    <div><span class="sn-gs-label"><i class="sn-gs-dot used store"></i>Used</span><b>@UserExtensions.FormatBytes(storeUsed)</b></div>
                    <div><span class="sn-gs-label"><i class="sn-gs-dot free"></i>Free</span><b>@UserExtensions.FormatBytes(storeFree)</b></div>
                    <div><span class="sn-gs-label"><i class="sn-gs-dot total"></i>Total</span><b>@UserExtensions.FormatBytes(storeTotal)</b></div>
                </div>
            </section>
        </div>
    </div>
</main>

@if (isAdmin)
{
<dialog id="addMemberDialog" class="sn-dialog glass-strong" data-open-on-load="@(Context.Request.Method == "POST" && Model.Error is not null && !full ? "true" : "false")">
    <form method="post" asp-antiforgery="true" action="/team">
        <div class="sn-dlg-head">
            <div class="sn-dlg-title"><span class="sn-dlg-icon"><i class="fa fa-user-plus" aria-hidden="true"></i></span><div><h2>Add a person</h2><p>@(Model.CanEmail ? "We email them a link to set their own password." : "Share the temporary password with them privately.")</p></div></div>
            <button type="button" class="sn-close" data-close aria-label="Close"><i class="fa fa-times" aria-hidden="true"></i></button>
        </div>
        <div class="sn-dlg-body">
            <modern-group-box title="Person | details" header-bg-color="transparent" content-bg-color="transparent" border-color="rgba(255,255,255,.75)" radius="22px" content-layout="block">
                <div style="display:flex;flex-direction:column;gap:14px">
                    <modern-input id="mName" name="NewMember.DisplayName" label="Name" mandatory="true" value="@m.DisplayName" max-length="100" label-font-size="13.5px"></modern-input>
                    <div>
                        <modern-input id="mEmail" name="NewMember.Email" label="Email" mandatory="true" value="@m.Email" max-length="200" placeholder="name@company.com" label-font-size="13.5px"></modern-input>
                        <div class="sn-email-hint" id="mEmailHint" hidden aria-live="polite"></div>
                    </div>
                    <modern-checkbox id="mAdmin" name="NewMember.MakeAdmin" label="Workspace admin" desc-text="Can add, edit and remove people" is-toggle-button="true" checked="@m.MakeAdmin" label-font-size="13.5px"></modern-checkbox>
                    @if (Model.CanEmail)
                    {
                        <modern-checkbox id="mInvite" name="NewMember.SendInvite" label="Email them an invite" desc-text="They get a link to set their own password" is-toggle-button="true" checked="@m.SendInvite" label-font-size="13.5px"></modern-checkbox>
                    }
                    else
                    {
                        <span class="sn-hint"><i class="fa fa-info-circle" aria-hidden="true"></i> Email isn't set up on this server, so set a temporary password and share it with them privately.</span>
                    }
                    <div class="sn-reveal @(Model.CanEmail && m.SendInvite ? "is-collapsed" : "")" id="mPassFields">
                        <div class="sn-reveal-in">
                            <modern-input id="mPass" name="NewMember.TemporaryPassword" label="Temporary password" mandatory="true" is-password="true" placeholder="At least 8 characters" label-font-size="13.5px"></modern-input>
                        </div>
                    </div>
                </div>
            </modern-group-box>
        </div>
        <div class="sn-dlg-foot">
            <span class="muted small">@Model.ActiveUsers of @Model.Limits.MaxUsers seats used</span>
            <span style="display:flex;gap:10px">
                <button type="button" class="cee-btn sn-btn-light" data-close>Cancel</button>
                <button type="submit" class="cee-btn cee-btn-gradient"><i class="fa fa-check" aria-hidden="true"></i> Add person</button>
            </span>
        </div>
    </form>
</dialog>

@* ---- edit a person: name, email, admin role, optional new temporary password ---- *@
<dialog id="editMemberDialog" class="sn-dialog glass-strong">
    <form method="post" asp-antiforgery="true" action="#" id="editMemberForm" novalidate>
        <div class="sn-dlg-head">
            <div class="sn-dlg-title"><span class="sn-dlg-icon"><i class="fa fa-pencil" aria-hidden="true"></i></span><div><h2 id="eTitle">Edit person</h2><p id="eSub">Change their details or give them a new password.</p></div></div>
            <button type="button" class="sn-close" data-close aria-label="Close"><i class="fa fa-times" aria-hidden="true"></i></button>
        </div>
        <div class="sn-dlg-body">
            <modern-group-box title="Person | details" header-bg-color="transparent" content-bg-color="transparent" border-color="rgba(255,255,255,.75)" radius="22px" content-layout="block">
                <div style="display:flex;flex-direction:column;gap:14px">
                    <modern-input id="eName" name="displayName" label="Name" mandatory="true" max-length="100" label-font-size="13.5px"></modern-input>
                    <div>
                        <modern-input id="eEmail" name="email" label="Email" mandatory="true" max-length="200" placeholder="name@company.com" label-font-size="13.5px"></modern-input>
                        <div class="sn-email-hint" id="eEmailHint" hidden aria-live="polite"></div>
                    </div>
                    <div id="eAdminWrap">
                        <modern-checkbox id="eAdmin" name="makeAdmin" label="Workspace admin" desc-text="Can add, edit and remove people" is-toggle-button="true" label-font-size="13.5px"></modern-checkbox>
                    </div>
                    <span class="sn-hint" id="eSelfNote" hidden><i class="fa fa-info-circle" aria-hidden="true"></i> You're an admin. To hand over, make someone else an admin; they can then change your role.</span>
                </div>
            </modern-group-box>
            <div style="margin-top:14px">
                <modern-group-box title="New | password" header-bg-color="transparent" content-bg-color="transparent" border-color="rgba(255,255,255,.75)" radius="22px" content-layout="block">
                    <div style="display:flex;flex-direction:column;gap:10px">
                        <modern-input id="ePass" name="newPassword" label="New temporary password" is-password="true" placeholder="Leave empty to keep the current password" label-font-size="13.5px"></modern-input>
                        <span style="display:flex;gap:6px;align-items:center;flex-wrap:wrap">
                            <button type="button" class="sn-link" id="eGen"><i class="fa fa-magic" aria-hidden="true"></i> Generate one</button>
                            <button type="button" class="sn-link" id="eCopy" hidden><i class="fa fa-clone" aria-hidden="true"></i> Copy</button>
                            @if (Model.CanEmail)
                            {
                                <span class="sn-or">or</span>
                                <button type="button" class="sn-link" id="eSendLink"><i class="fa fa-paper-plane" aria-hidden="true"></i> Email a set-password link</button>
                            }
                        </span>
                        <span class="sn-hint" id="ePassNote"><i class="fa fa-info-circle" aria-hidden="true"></i> Changing the email, role or password signs them out; they sign in again with the new details.</span>
                    </div>
                </modern-group-box>
            </div>
        </div>
        <div class="sn-dlg-foot">
            <span class="muted small" id="eFoot"></span>
            <span style="display:flex;gap:10px">
                <button type="button" class="cee-btn sn-btn-light" data-close>Cancel</button>
                <button type="submit" class="cee-btn cee-btn-gradient"><i class="fa fa-check" aria-hidden="true"></i> Save</button>
            </span>
        </div>
    </form>
</dialog>
}

@section Scripts {
    <script>
        // ---- table heading: count badge + "online · admins · seats" line ----
        $(function () {
            SN.tableHeading("TeamTable", @Model.People.Count, [
                { text: "@online online", dot: "live" },
                { text: "@adminsText", dot: "admin" },
                { text: "@Model.ActiveUsers of @Model.Limits.MaxUsers seats", dot: "seat" }@Html.Raw(invitedMeta)
            ]);
        });

        var snIsAdmin = @(isAdmin ? "true" : "false");   // members only see the list

        // /team?add=1 (from "Add people to the team" in the Schedule window) opens Add person straight away.
        if (snIsAdmin && new URLSearchParams(location.search).get("add") === "1") {
            $(function () { setTimeout(function () { SN.open("addMemberDialog"); }, 450); history.replaceState(null, "", location.pathname); });
        }

        var snMe = "@me";

        // ---- edit a person ----
        function snEditPerson(row) {
            row = row || SN.need("TeamTable", "a person");
            if (!row) return;
            snEditRow = row;
            var isMe = row.IsMe === true || row.IsMe === "true" || row.Id === snMe;
            $("#editMemberForm").attr("action", "/team/" + row.Id + "/edit");
            $("#eTitle").text(isMe ? "Edit your details" : "Edit " + (row.DisplayName || row.Name));
            $("#eSub").text(isMe ? "Change your name, email or password." : "Change their details or give them a new password.");
            $("#eName").val(row.DisplayName || row.Name).trigger("input");
            $("#eEmail").val(row.Email).attr("data-original", row.Email).trigger("input");
            $("#ePass").val("").attr("type", "password").trigger("input");
            $("#eCopy").prop("hidden", true);
            var admin = row.Role === "Admin";
            $("#eAdmin").prop("checked", admin).trigger("change");
            $("#eAdminWrap").prop("hidden", isMe);          // you can't remove your own admin role
            $("#eSelfNote").prop("hidden", !isMe);
            $("#ePassNote").html('<i class="fa fa-info-circle" aria-hidden="true"></i> ' + (isMe
                ? "Changing your password keeps you signed in here. Use the new one next time."
                : "Changing the email, role or password signs them out; they sign in again with the new details."));
            $("#eFoot").text(row.Status === "Inactive" ? "This person is inactive. Activate them to let them sign in." : "");
            SN.open("editMemberDialog");
            setTimeout(function () { $("#eName").trigger("focus"); }, 300);
        }
        // double-click a row to edit it
        $(document).on("dblclick", "#TeamTable tbody tr", function () {
            if (!snIsAdmin) return;
            setTimeout(function () { var row = SN.selected("TeamTable"); if (row) snEditPerson(row); }, 0);
        });
        // a strong, easy-to-read temporary password (no look-alike characters)
        $("#eGen").on("click", function () {
            var chars = "ABCDEFGHJKLMNPQRSTUVWXYZabcdefghjkmnpqrstuvwxyz23456789", digits = "23456789", syms = "@@#$%&*";
            var pick = function (set) { var a = new Uint32Array(1); crypto.getRandomValues(a); return set[a[0] % set.length]; };
            var pw = ""; for (var i = 0; i < 9; i++) pw += pick(chars);
            pw += pick(digits) + pick(syms) + pick(digits);
            $("#ePass").val(pw).attr("type", "text").trigger("input");
            $("#eCopy").prop("hidden", false);
        });
        $("#eCopy").on("click", function () { SN.copy($("#ePass").val()); });

        // Edit → "Email a set-password link": they choose a new password themselves
        var snEditRow = null;
        $("#eSendLink").on("click", function () {
            if (!snEditRow) return;
            var who = snEditRow.DisplayName || snEditRow.Name;
            SN.confirmPost("/team/" + snEditRow.Id + "/send-link", {
                title: "Email a set-password link",
                text: "Email " + snEditRow.Email + " a link to choose a new password? It works once, for 3 days. " + (snEditRow.IsMe === true || snEditRow.IsMe === "true" ? "Your" : who + "'s") + " current password keeps working until the link is used.",
                confirmText: "Send link"
            });
        });

        // Add person: with the email invite on, no temporary password is needed
        (function () {
            var box = document.getElementById("mInvite");
            var fields = document.getElementById("mPassFields");
            if (!fields) return;
            function apply() {
                var invite = !!(box && box.checked);
                fields.classList.toggle("is-collapsed", invite);
                fields.inert = invite;
                if (invite) $("#mPass").val("");
            }
            if (box) $(document).on("change", "#mInvite", apply);
            apply();
        })();
        $("#editMemberForm").on("submit", function (e) {
            var name = $.trim($("#eName").val()), email = $.trim($("#eEmail").val()), pw = $("#ePass").val();
            var problem = !name ? "Enter a name."
                : !/^[^\s@@]+@@[^\s@@]+\.[^\s@@]{2,}$/.test(email) ? "Enter a valid email address."
                : pw && pw.length < 8 ? "The new password needs at least 8 characters."
                : "";
            if (problem) { e.preventDefault(); Sahyog.toast(problem, { kind: "warn", title: "Check the details" }); }
        });
        function snPlanFull() {
            Sahyog.toast("Your plan's user limit is reached. Deactivate someone or ask CloudWheel to upgrade the plan.", { kind: "warn", title: "Plan limit reached" });
        }
        // ---- active / inactive: inactive people can't sign in (their messages stay) ----
        function snIsActive(row) { return !(row.Active === false || row.Active === "false"); }
        function snRemovePerson(row) {
            row = row || SN.need("TeamTable", "a person");
            if (!row) return;
            if (row.Id === snMe) { Sahyog.toast("You can't make yourself inactive.", { kind: "info", title: "Not allowed" }); return; }
            if (!snIsActive(row)) { Sahyog.toast((row.DisplayName || row.Name) + " is already inactive.", { kind: "info", title: "Already inactive" }); return; }
            SN.confirmPost("/team/" + row.Id + "/deactivate", {
                title: "Make inactive",
                text: "Make " + (row.DisplayName || row.Name) + " inactive? They're signed out straight away and can't sign in until you activate them again. Their messages stay, and their seat is freed.",
                confirmText: "Make inactive",
                danger: true
            });
        }
        function snRestorePerson(row) {
            row = row || SN.need("TeamTable", "an inactive person");
            if (!row) return;
            if (snIsActive(row)) { Sahyog.toast((row.DisplayName || row.Name) + " is already active.", { kind: "info", title: "Already active" }); return; }
            SN.confirmPost("/team/" + row.Id + "/activate", {
                title: "Activate",
                text: "Activate " + (row.DisplayName || row.Name) + "? They can sign in again with their current password. This uses one seat.",
                confirmText: "Activate"
            });
        }
        // the Active switch in the table: click it to make someone active / inactive (admins only)
        if (snIsAdmin) {
            $("#TeamTable").addClass("sn-active-editable");
            $(document).on("click", "#TeamTable td .mt-switch", function (e) {
                e.preventDefault();
                var id = $(this).closest("tr").attr("data-row-id");
                setTimeout(function () {                       // let the table select the row first
                    var row = SN.selected("TeamTable");
                    if (!row || String(row.Id) !== String(id)) return;
                    if (snIsActive(row)) snRemovePerson(row); else snRestorePerson(row);
                }, 0);
            });
        }

        // ---- "Invited · not joined": send a fresh invite ----
        function snResendInvite(row) {
            row = row || SN.need("TeamTable", "a person who hasn't joined yet");
            if (!row) return;
            var who = row.DisplayName || row.Name;
            var pending = row.Pending === true || row.Pending === "true";
            if (!snIsActive(row)) { Sahyog.toast(who + " is inactive. Activate them first.", { kind: "info", title: "Inactive" }); return; }
            if (!pending) {
                Sahyog.toast(who + " has already joined. To help them with their password, use Edit → \"Email a set-password link\".", { kind: "info", title: "Already joined" });
                return;
            }
            SN.confirmPost("/team/" + row.Id + "/send-link?invite=true", {
                title: "Resend invite",
                text: "Send " + who + " a new invite at " + row.Email + "? It works for 7 days, and any earlier invite link stops working. If this email is wrong, cancel and use Edit to correct it first.",
                confirmText: "Send invite"
            });
        }

        // ---- email typo help in Add and Edit: "Did you mean …?" while typing, and a mail-server check ----
        (function () {
            var common = ["gmail.com", "googlemail.com", "yahoo.com", "yahoo.co.in", "yahoo.in", "ymail.com", "outlook.com", "hotmail.com",
                "live.com", "msn.com", "outlook.in", "hotmail.co.in", "icloud.com", "me.com", "aol.com", "proton.me", "protonmail.com",
                "zoho.com", "zohomail.in", "rediffmail.com", "gmx.com", "mail.com", "yandex.com", "cloudwheel.info"];
            // domains already used in this workspace count too
            $.each(@Html.Raw(knownDomains), function (_, d) {
                if (common.indexOf(d) < 0) common.push(d);
            });
            function dist(a, b) {
                if (Math.abs(a.length - b.length) > 2) return 99;
                var d = [], i, j;
                for (i = 0; i <= a.length; i++) { d[i] = [i]; }
                for (j = 0; j <= b.length; j++) d[0][j] = j;
                for (i = 1; i <= a.length; i++) for (j = 1; j <= b.length; j++) {
                    var c = a[i - 1] === b[j - 1] ? 0 : 1;
                    d[i][j] = Math.min(d[i - 1][j] + 1, d[i][j - 1] + 1, d[i - 1][j - 1] + c);
                    if (i > 1 && j > 1 && a[i - 1] === b[j - 2] && a[i - 2] === b[j - 1]) d[i][j] = Math.min(d[i][j], d[i - 2][j - 2] + 1);
                }
                return d[a.length][b.length];
            }
            function suggest(domain) {
                domain = (domain || "").toLowerCase().replace(/\.$/, "");
                if (domain.length < 3 || common.indexOf(domain) >= 0) return null;
                if (domain.indexOf(".") < 0) { for (var k = 0; k < common.length; k++) if (common[k].indexOf(domain + ".") === 0) return common[k]; }
                var best = null, bd = 99;
                common.forEach(function (c) { var max = c.length <= 8 ? 1 : 2, x = dist(domain, c); if (x <= max && x < bd) { best = c; bd = x; } });
                return best;
            }
            function wire(inputId, hintId) {
                var $in = $("#" + inputId), $hint = $("#" + hintId), timer = 0, seq = 0;
                if (!$in.length) return;
                function show(kind, html) { $hint.attr("data-kind", kind).html(html).prop("hidden", !html); }
                function offer(email, msg, kind) {
                    show(kind, '<i class="fa ' + (kind === "bad" ? "fa-exclamation-circle" : "fa-lightbulb-o") + '" aria-hidden="true"></i> ' + msg);
                }
                function useBtn(fixed) {
                    return ' <button type="button" class="sn-email-fix" data-fix="' + Sahyog.escape(fixed) + '">Did you mean <b>' + Sahyog.escape(fixed) + '</b>?</button>';
                }
                function run(final) {
                    var email = $.trim($in.val()).toLowerCase(), at = email.lastIndexOf("@@");
                    if (at <= 0 || at === email.length - 1) { show("", ""); return; }
                    if ($in.attr("data-original") && email === String($in.attr("data-original")).toLowerCase()) { show("", ""); return; }
                    var local = email.slice(0, at), domain = email.slice(at + 1), s = suggest(domain);
                    if (s) offer(email, useBtn(local + "@@" + s), "tip"); else show("", "");
                    if (!final || domain.indexOf(".") < 0 && !s) return;
                    var my = ++seq;
                    $.getJSON("/team/check-email", { email: email }).done(function (r) {
                        if (my !== seq || $.trim($in.val()).toLowerCase() !== email) return;
                        if (r.status === "nomail" || r.status === "invalid")
                            offer(email, Sahyog.escape(r.message) + (r.suggestion ? useBtn(r.suggestion) : ""), "bad");
                        else if (r.status === "ok" && !r.suggestion) show("ok", '<i class="fa fa-check-circle" aria-hidden="true"></i> ' + Sahyog.escape(r.domain) + " can receive email.");
                    });
                }
                $in.on("input", function () { clearTimeout(timer); run(false); timer = setTimeout(function () { run(true); }, 700); });
                $in.on("blur", function () { clearTimeout(timer); run(true); });
                $hint.on("click", ".sn-email-fix", function () { $in.val($(this).attr("data-fix")).trigger("input").trigger("focus"); });
                $in.closest("dialog").on("close", function () { show("", ""); });
            }
            wire("mEmail", "mEmailHint");
            wire("eEmail", "eEmailHint");
        })();
    </script>
}
