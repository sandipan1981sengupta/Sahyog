<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Web app: controllers, Razor views, SignalR hub. All business functions are in Sahyog.ServiceLibrary. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Sahyog.Web</RootNamespace>
    <!-- Shown in About ShankhNaad -->
    <Version>1.0.0</Version>
    <Product>ShankhNaad</Product>
    <Company>CloudWheel Ltd</Company>
    <UserSecretsId>sahyog-web-cloudwheel-2026</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sahyog.DtoLibrary\Sahyog.DtoLibrary.csproj" />
    <ProjectReference Include="..\Sahyog.ServiceLibrary\Sahyog.ServiceLibrary.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="App_Data\**" CopyToPublishDirectory="Never" />
  </ItemGroup>

</Project>
