<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Web app: controllers, Razor views, SignalR hub. All business functions are in ShankhNaad.ServiceLibrary. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ShankhNaad.Web</RootNamespace>
    <!-- Shown in About ShankhNaad -->
    <Version>1.0.0</Version>
    <Product>ShankhNaad</Product>
    <Company>CloudWheel Ltd</Company>
    <!-- kept from Sahyog so your saved secrets (Smtp password etc.) keep working -->
    <UserSecretsId>sahyog-web-cloudwheel-2026</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ShankhNaad.DtoLibrary\ShankhNaad.DtoLibrary.csproj" />
    <ProjectReference Include="..\ShankhNaad.ServiceLibrary\ShankhNaad.ServiceLibrary.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="App_Data\**" CopyToPublishDirectory="Never" />
    <!-- the JaaS private key (Jaas:PrivateKeyPath = Key/jaas.pk) must go to the server with the app,
         otherwise every call opens "Something went wrong". It's outside wwwroot, so it is never downloadable. -->
    <None Update="Key\**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Several web servers (optional, appsettings "Redis"): live updates and login keys shared through Redis -->
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.StackExchangeRedis" Version="10.0.15" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.StackExchangeRedis" Version="10.0.15" />
  </ItemGroup>

</Project>
