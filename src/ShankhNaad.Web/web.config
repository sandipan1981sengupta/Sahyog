<?xml version="1.0" encoding="utf-8"?>
<!-- IIS settings for Sahyog. Visual Studio publish merges this with the ASP.NET Core module settings. -->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <!-- SignalR chat needs WebSockets: also turn on "WebSocket Protocol" in Windows Server roles. -->
      <webSocket enabled="true" />
      <security>
        <requestFiltering>
          <!-- allow uploads up to 200 MB (the app itself limits to Storage:MaxUploadMb) -->
          <requestLimits maxAllowedContentLength="209715200" />
        </requestFiltering>
      </security>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\ShankhNaad.Web.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" />
    </system.webServer>
  </location>
</configuration>
