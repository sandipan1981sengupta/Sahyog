@model LoginViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Sign in";
}
<partial name="_AuthHero" />

<div class="sn-window-wrap">
    @* colour behind the glass window *@
    <div class="sn-window-orbs" aria-hidden="true"><span class="w1"></span><span class="w2"></span><span class="w3"></span></div>

    <div class="sn-float sn-float-a glass-clear" aria-hidden="true">
        <span class="sn-float-ic live"><i class="fa fa-video-camera"></i></span>
        <span><b>Daily stand-up</b><small>Live · your team is in the call</small></span>
    </div>
    <div class="sn-float sn-float-b glass-clear" aria-hidden="true">
        <span class="sn-float-ic"><i class="fa fa-comments"></i></span>
        <span><b>3 new messages</b><small>Waiting in #general</small></span>
    </div>

    <form method="post" asp-action="Login" class="sn-window glass-clear" novalidate>
        <div class="sn-window-top">
            <div>
                <div class="sn-eyebrow">Welcome back</div>
                <h2>Sign in</h2>
                <p class="sn-window-sub">to your team's ShankhNaad workspace</p>
            </div>
            <span class="sn-lock"><i class="fa fa-lock" aria-hidden="true"></i></span>
        </div>

        @if (TempData["SetupMessage"] is string setupMessage)
        {
            <div hidden data-toast="@setupMessage" data-toast-kind="success" data-toast-title="All set"></div>
        }
        <div asp-validation-summary="ModelOnly" class="form-error" role="alert"></div>
        <input type="hidden" asp-for="ReturnUrl" />

        @* No workspace box: every email belongs to exactly one person, so the email tells us the workspace
           (and whether this is a CloudWheel admin). *@

        <div>
            <modern-input id="Email" name="Email" label="Work email" mandatory="true" placeholder="you@company.com"
                          value="@Model.Email" max-length="200" label-font-size="13.5px"></modern-input>
            <span asp-validation-for="Email" class="field-error"></span>
        </div>

        <div>
            <modern-input id="Password" name="Password" label="Password" mandatory="true" is-password="true"
                          placeholder="Enter your password" label-font-size="13.5px"></modern-input>
            <span asp-validation-for="Password" class="field-error"></span>
        </div>

        <div class="sn-window-row sn-window-row-split">
            <modern-checkbox id="RememberMe" name="RememberMe" label="Keep me signed in" is-toggle-button="true"
                             checked="@Model.RememberMe" label-font-size="13.5px"></modern-checkbox>
            <a class="sn-forgot" href="/account/forgot" id="forgotLink">Forgot password?</a>
        </div>

        <button type="submit" class="cee-btn cee-btn-gradient sn-signin">Sign in <i class="fa fa-arrow-right" aria-hidden="true"></i></button>

        <div class="sn-divider"><span></span><i class="fa fa-shield" aria-hidden="true"></i> Secured with encryption<span></span></div>
        <p class="sn-small center">New here? Ask your workspace admin for an invite.</p>
        <p class="sn-small center" data-install-only><button type="button" class="sn-install-btn" onclick="SN.installApp()"><i class="fa fa-desktop" aria-hidden="true"></i> Install the desktop app</button></p>
    </form>
</div>
<p class="sn-setup-link">Installing ShankhNaad for the first time? <a href="/setup">Run setup</a></p>

@section Scripts {
    <script>
        (function () {
            // "Forgot password?" takes the email typed so far
            $("#forgotLink").on("click", function () {
                var email = ($("#Email").val() || "").trim();
                if (email) this.href = "/account/forgot?email=" + encodeURIComponent(email);
            });
            // Remember the last email on this device, so next time only the password is needed.
            var KEY = "sn-last-email", box = document.getElementById("Email"), pass = document.getElementById("Password");
            try {
                if (box && !box.value) { var last = localStorage.getItem(KEY); if (last) { box.value = last; $(box).trigger("input"); } }
                if (box && box.value && pass) setTimeout(function () { pass.focus(); }, 60);
            } catch (e) { }
            $(box).closest("form").on("submit", function () {
                try {
                    var keep = document.getElementById("RememberMe");
                    if (!keep || keep.checked) localStorage.setItem(KEY, (box.value || "").trim().toLowerCase());
                    else localStorage.removeItem(KEY);
                } catch (e) { }
            });
        })();
    </script>
}
