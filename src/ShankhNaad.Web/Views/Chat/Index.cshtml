@model ChatViewModel
@using System.Text.Json
@{
    ViewData["Title"] = Model.Current is null ? "Chat" : Model.Current.Name;
    ViewData["Section"] = "chat";
    var jsonOptions = new JsonSerializerOptions(JsonSerializerDefaults.Web);
    var c = Model.Current;
    var subtitle = c is null ? "" : c.IsDirect
        ? (c.DirectWith!.Online ? "Online now" : "Direct message")
        : $"{Model.Members.Count} members{(string.IsNullOrWhiteSpace(Model.CurrentDescription) ? "" : " · " + Model.CurrentDescription)}";
    var isAdmin = User.IsInRole(AppRoles.TenantAdmin);
    string Js(string? text) => System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(text ?? "");

    // the list: pinned chats first, then every other chat (groups and people) newest first
    var allChats = Model.Channels.Concat(Model.Directs).ToList();
    var pinned = allChats.Where(x => x.IsPinned).OrderByDescending(x => x.LastUtc).ToList();
    var recent = allChats.Where(x => !x.IsPinned).OrderByDescending(x => x.LastUtc).ToList();
    var chatted = Model.Directs.Where(d => d.DirectWith is not null).Select(d => d.DirectWith!.Id).ToHashSet();
    var newPeople = Model.Team.Where(t => !chatted.Contains(t.Id)).OrderByDescending(t => t.Online).ThenBy(t => t.Name).ToList();
}

@* ---------- page header: same look as Team and Meetings; every action for this conversation is here ---------- *@
<div class="sn-chat-page">
<div class="sn-head glass">
    @if (c is null)
    {
        <action-header id="ChatHeader" heading="Chat" subtitle="@($"{User.TenantName()} · groups and one-to-one chats")"
                       left-icon-css="bi bi-chat-dots-fill" left-icon-size="26"
                       left-icon-gradient-start="#2563EB" left-icon-gradient-mid="#7C3AED" left-icon-gradient-end="#DB2777"
                       background-color="transparent" box-shadow="none" add-color="#1D4ED8"
                       show-refresh="false" show-add="true" add-text="New group" add-on-click="SN.open('newChannelDialog')"
                       show-edit="false" show-delete="false" show-import="false" show-export="false" show-save="false" show-submit="false" show-print="false">
            <action-btn text="New chat" icon-css="bi bi-chat-text-fill" icon-color="#7C3AED" tooltip="Message a teammate" on-click="SN.open('newDmDialog')"></action-btn>
        </action-header>
    }
    else
    {
        <action-header id="ChatHeader"
                       heading="@c.Name"
                       subtitle="@subtitle"
                       left-icon-css="@(c.IsDirect ? "bi bi-person-fill" : c.IsEveryone ? "bi bi-globe2" : "bi bi-people-fill")" left-icon-size="26"
                       left-icon-gradient-start="#2563EB" left-icon-gradient-mid="#7C3AED" left-icon-gradient-end="#DB2777"
                       background-color="transparent" box-shadow="none"
                       add-color="#1D4ED8" delete-color="#DC2626"
                       show-refresh="false"
                       show-add="true" add-text="New group" add-on-click="SN.open('newChannelDialog')"
                       show-edit="@(!c.IsDirect && Model.CanEditChannel)" edit-text="Edit" edit-on-click="SN.open('editChannelDialog')"
                       show-delete="@(c.IsDirect || Model.CanDeleteChannel || (Model.CurrentIsMain && isAdmin))" delete-text="@(c.IsDirect ? "Delete chat" : "Delete")"
                       delete-on-click="@(c.IsDirect ? "snDeleteChat()" : "snDeleteChannel()")"
                       show-import="false" show-export="false" show-save="false" show-submit="false" show-print="false">
            @if (c.IsDirect)
            {
                <action-btn text="Add people" icon-css="bi bi-person-plus-fill" icon-color="#7C3AED" tooltip="Make a group with @c.Name and more people"
                            on-click="snAddPeople()"></action-btn>
            }
            <action-btn text="@(c.IsPinned ? "Unpin" : "Pin")" icon-css="bi bi-pin-angle-fill" icon-color="#D97706" tooltip="Keep this chat at the top of your list"
                        on-click="snTogglePin()"></action-btn>
            <action-btn text="Call" icon-css="bi bi-telephone-fill" icon-color="#1D4ED8" tooltip="Start a call with everyone here"
                        on-click="document.getElementById('meetNowForm').submit()"></action-btn>
            <action-btn text="Meet now" icon-css="bi bi-camera-video-fill" icon-color="#16A34A" tooltip="Start a video meeting here"
                        on-click="document.getElementById('meetNowForm').submit()" has-separator-after="true"></action-btn>
            <action-btn text="Files" icon-css="bi bi-paperclip" icon-color="#1D4ED8" tooltip="Attach a file"
                        on-click="document.getElementById('attachBtn').click()"></action-btn>
            <action-btn text="Details" icon-css="bi bi-info-circle-fill" icon-color="#BE185D" tooltip="Show or hide details"
                        on-click="SN.toggleDetails()"></action-btn>
        </action-header>
    }
</div>
<div class="sn-chat-row">

@* ---------- one chat row (group or person) with its hover buttons ---------- *@
@{
    async Task ChatRow(ChannelVm ch)
    {
        var p = ch.DirectWith;
        var active = ch.Id == c?.Id;
        <div class="side-item person sn-person-row @(active ? "active" : "") @(ch.Unread > 0 ? "unread" : "")"
             data-channel="@ch.Id" data-person="@(p?.Id)" data-filter="@ch.Name" data-last="@ch.LastUtc.ToString("o")" data-pinned="@(ch.IsPinned ? "true" : "false")">
            <a class="sn-person-open" href="/chat/@ch.Id" aria-current="@(active ? "page" : null)" title="Open @ch.Name">
                @if (p is not null)
                {
                    <span class="avatar av-34 tone-@(p.Tone)" data-presence="@p.Id">@p.Initials<i class="dot @(p.Online ? "on" : "")"></i></span>
                }
                else
                {
                    <span class="avatar av-34 tone-0 hash-avatar group-avatar @(ch.IsEveryone ? "everyone" : "")" title="@(ch.IsEveryone ? "Everyone in the workspace" : "Group")"><i class="fa @(ch.IsEveryone ? "fa-globe" : "fa-users")" aria-hidden="true"></i></span>
                }
                <span class="grow ellipsis">@ch.Name</span>
                <i class="fa fa-thumb-tack sn-pin-mark" aria-hidden="true"></i>
                <span class="badge" hidden="@(ch.Unread == 0)">@ch.Unread</span>
            </a>
            <span class="sn-team-actions">
                <button type="button" class="sn-team-btn pin" data-pin="@ch.Id" title="@(ch.IsPinned ? "Unpin" : "Pin to the top")" aria-label="@(ch.IsPinned ? "Unpin" : "Pin to the top")"><i class="fa fa-thumb-tack" aria-hidden="true"></i></button>
                @if (p is not null)
                {
                    <button type="button" class="sn-team-btn ping" data-ping="@p.Id" data-name="@p.Name" title="Ping @p.Name" aria-label="Ping @p.Name"><i class="fa fa-bell" aria-hidden="true"></i></button>
                    <form method="post" asp-antiforgery="true" action="/meetings/instant">
                        <input type="hidden" name="userId" value="@p.Id" />
                        <button type="submit" class="sn-team-btn call" title="Video call @p.Name" aria-label="Video call @p.Name"><i class="fa fa-video-camera" aria-hidden="true"></i></button>
                    </form>
                    <button type="button" class="sn-team-btn del" data-del-chat="@ch.Id" data-name="@p.Name" title="Delete your chat with @p.Name" aria-label="Delete your chat with @p.Name"><i class="fa fa-trash-o" aria-hidden="true"></i></button>
                }
                else
                {
                    <form method="post" asp-antiforgery="true" action="/meetings/instant">
                        <input type="hidden" name="channelId" value="@ch.Id" />
                        <button type="submit" class="sn-team-btn call" title="Video call everyone in @ch.Name" aria-label="Video call everyone in @ch.Name"><i class="fa fa-video-camera" aria-hidden="true"></i></button>
                    </form>
                }
            </span>
        </div>
    }
}

@* ---------- conversations: Pinned, then Chats (groups and people, newest first), then Team ---------- *@
<aside class="chat-side glass" aria-label="Conversations">
    <div class="side-head">
        <div class="side-title">Chats</div>
        <button type="button" class="sn-icon-btn grad" data-open="newChannelDialog" aria-label="New group" title="New group">
            <i class="fa fa-plus" aria-hidden="true"></i>
        </button>
    </div>
    <label class="search">
        <i class="fa fa-search" aria-hidden="true"></i>
        <input type="search" id="sideFilter" placeholder="Search people or groups" aria-label="Filter chats" />
    </label>

    <div class="side-scroll">
    <div class="side-section sn-pinned" id="pinnedSection" hidden="@(pinned.Count == 0)">
        <span class="side-label"><i class="fa fa-thumb-tack" aria-hidden="true"></i> Pinned</span>
        <div id="pinnedList">
            @foreach (var ch in pinned) { await ChatRow(ch); }
        </div>
    </div>
    <hr class="sn-pin-divider" id="pinDivider" hidden="@(pinned.Count == 0)" />

    <div class="side-section">
        <div class="side-label-row">
            <span class="side-label">Chats <span class="sn-accent">| <span id="chatCount">@recent.Count</span></span></span>
            <button type="button" class="link-btn" data-open="newDmDialog">New chat</button>
        </div>
        <div id="chatList">
            @foreach (var ch in recent) { await ChatRow(ch); }
        </div>
        @if (allChats.Count == 0)
        {
            <p class="muted small pad-x">No chats yet. Pick someone below to see your messages with them, or press + to make a group.</p>
        }
    </div>

    @* ---- teammates you haven't chatted with yet ---- *@
    <div class="side-section">
        <div class="side-label-row">
            <span class="side-label">Team <span class="sn-accent">| @newPeople.Count</span></span>
            <span class="muted tiny"><span id="teamOnline">@Model.Team.Count(t => t.Online)</span> online</span>
        </div>
        @foreach (var t in newPeople)
        {
            <div class="side-item person sn-team-row" data-filter="@t.Name">
                <form method="post" asp-antiforgery="true" action="/chat/direct/@t.Id" class="sn-team-open">
                    <button type="submit" title="Message @t.Name">
                        <span class="avatar av-34 tone-@(t.Tone)" data-presence="@t.Id">@t.Initials<i class="dot @(t.Online ? "on" : "")"></i></span>
                        <span class="grow ellipsis">@t.Name</span>
                    </button>
                </form>
                <span class="sn-team-actions">
                    <button type="button" class="sn-team-btn ping" data-ping="@t.Id" data-name="@t.Name" title="Ping @t.Name" aria-label="Ping @t.Name"><i class="fa fa-bell" aria-hidden="true"></i></button>
                    <form method="post" asp-antiforgery="true" action="/chat/direct/@t.Id">
                        <button type="submit" class="sn-team-btn chat" title="Message @t.Name" aria-label="Message @t.Name"><i class="fa fa-comment" aria-hidden="true"></i></button>
                    </form>
                    <form method="post" asp-antiforgery="true" action="/meetings/instant">
                        <input type="hidden" name="userId" value="@t.Id" />
                        <button type="submit" class="sn-team-btn call" title="Video call @t.Name" aria-label="Video call @t.Name"><i class="fa fa-video-camera" aria-hidden="true"></i></button>
                    </form>
                </span>
            </div>
        }
        @if (Model.Team.Count == 0)
        {
            <p class="muted small pad-x">No one else is here yet. Add people on the Team page.</p>
        }
        else if (newPeople.Count == 0)
        {
            <p class="muted small pad-x">You have a chat with everyone. Find them under Chats.</p>
        }
    </div>
    </div>
</aside>

@* ---------- conversation ---------- *@
<main class="chat-main glass" id="chat"
      data-channel="@(c?.Id)" data-has-older="@(Model.HasOlder ? "true" : "false")" data-max-mb="@Model.MaxUploadMb" data-me="@User.UserId()" data-other="@(c?.DirectWith?.Id)" data-admin="@(User.IsInRole(AppRoles.TenantAdmin) ? "true" : "false")">
    @if (c is null)
    {
        <div class="empty">
            <img src="~/images/logo.svg" alt="" width="72" height="72" style="margin:0 auto 14px" />
            <h1>Welcome to ShankhNaad</h1>
            <p class="muted">Pick a teammate on the left, or press + to make a group.</p>
        </div>
    }
    else
    {
        <form method="post" asp-antiforgery="true" action="/meetings/instant" id="meetNowForm" hidden>
            <input type="hidden" name="channelId" value="@c.Id" />
        </form>

        <section class="messages" id="messages" aria-label="Messages" aria-live="polite">
            <button type="button" class="btn btn-ghost btn-sm load-older" id="loadOlder" hidden="@(!Model.HasOlder)">Load older messages</button>
            <div id="messageList"></div>
            <div class="typing" id="typing" hidden><span class="typing-dots"><i></i><i></i><i></i></span><span id="typingText"></span></div>
        </section>

        <form class="composer" id="composer" autocomplete="off">
            <input type="file" id="fileInput" hidden />
            <button type="button" class="btn-icon soft" id="attachBtn" aria-label="Attach a file" title="Attach a file">
                <i class="fa fa-paperclip" style="font-size:18px" aria-hidden="true"></i>
            </button>
            <label for="messageBox" class="sr-only">Message</label>
            <textarea id="messageBox" rows="1" maxlength="4000" placeholder="Message @c.Name"></textarea>
            <button type="submit" class="cee-btn cee-btn-gradient sn-send-btn" aria-label="Send" title="Send"><i class="fa fa-paper-plane" aria-hidden="true"></i></button>
        </form>
        <div class="upload-progress" id="uploadProgress" hidden><span id="uploadName"></span><div class="bar"><i id="uploadBar"></i></div></div>
    }
</main>

@* ---------- details (modern-group-box) ---------- *@
<aside class="chat-info" aria-label="Details">
    <modern-group-box title="Members | @Model.Members.Count" header-bg-color="transparent" content-bg-color="transparent" border-color="rgba(255,255,255,.75)" radius="24px" content-layout="block">
        <div class="people-grid">
            @foreach (var m in Model.Members.Take(12))
            {
                <span class="person-chip">
                    <span class="avatar av-44 tone-@(m.Tone) ring-white" data-presence="@m.Id">@m.Initials<i class="dot @(m.Online ? "on" : "")"></i></span>
                    <span class="tiny">@m.Name.Split(' ')[0]</span>
                </span>
            }
        </div>
    </modern-group-box>

    <modern-group-box title="Files | shared" header-bg-color="transparent" content-bg-color="transparent" border-color="rgba(255,255,255,.75)" radius="24px" content-layout="block">
        <div id="recentFiles" class="file-list">
            @foreach (var f in Model.RecentFiles)
            {
                <a class="file-row" href="@f.Url" target="_blank" rel="noopener">
                    <i class="fa fa-file-o" aria-hidden="true"></i>
                    <span class="grow ellipsis">@f.FileName</span><span class="muted tiny">@UserExtensions.FormatBytes(f.SizeBytes)</span>
                </a>
            }
            @if (Model.RecentFiles.Count == 0)
            {
                <p class="muted small">Files shared here will appear in this list.</p>
            }
        </div>
    </modern-group-box>

    <modern-group-box title="Storage | @Model.Limits.PlanName plan" header-bg-color="transparent" content-bg-color="transparent" border-color="rgba(255,255,255,.75)" radius="24px" content-layout="block">
        <div class="row between small"><strong>@UserExtensions.FormatBytes(Model.Limits.StorageUsedBytes)</strong><span class="muted">of @UserExtensions.FormatBytes(Model.Limits.StorageQuotaBytes)</span></div>
        <div class="meter" role="img" aria-label="@Model.Limits.StoragePercent percent of storage used"><i style="width:@(Model.Limits.StoragePercent)%" class="@(Model.Limits.StoragePercent >= 80 ? "warn" : "")"></i></div>
        <span class="muted tiny">Your admin can upgrade the plan.</span>
    </modern-group-box>
</aside>
</div>
</div>

@* ---------- pop-up forms ---------- *@
<dialog id="newChannelDialog" class="sn-dialog glass-strong">
    <form method="post" asp-antiforgery="true" action="/chat/groups" id="newChannelForm">
        <div class="sn-dlg-head">
            <div class="sn-dlg-title"><span class="sn-dlg-icon"><i class="fa fa-users" aria-hidden="true"></i></span><div><h2>New group</h2><p>Only the people you pick (and you) can see it.</p></div></div>
            <button type="button" class="sn-close" data-close aria-label="Close"><i class="fa fa-times" aria-hidden="true"></i></button>
        </div>
        <div class="sn-dlg-body">
            <modern-group-box title="Group | details" header-bg-color="transparent" content-bg-color="transparent" border-color="rgba(255,255,255,.75)" radius="22px" content-layout="block">
                <div style="display:flex;flex-direction:column;gap:14px">
                    <modern-input id="channelName" name="name" label="Group name" mandatory="true" placeholder="Project Alpha" max-length="60" label-font-size="13.5px"></modern-input>
                    <modern-input id="channelDesc" name="description" label="Description" placeholder="What is this group for?" max-length="300" label-font-size="13.5px"></modern-input>
                </div>
            </modern-group-box>
            <div id="groupPeople" style="margin-top:14px;display:flex;flex-direction:column;gap:10px">
                <div class="sn-pick-head">
                    <span><b>People</b> <span class="muted small" id="pickCount">0 picked</span></span>
                    <span style="display:flex;gap:8px;align-items:center">
                        <input type="search" class="sn-pick-search" id="pickSearch" placeholder="Find someone" aria-label="Find someone" />
                        <button type="button" class="sn-link" id="pickAll">All</button>
                    </span>
                </div>
                <div class="sn-pick-list">
                    @foreach (var t in Model.Team.OrderBy(t => t.Name))
                    {
                        <label class="sn-pick" data-name="@t.Name.ToLowerInvariant()">
                            <input type="checkbox" name="members" value="@t.Id" />
                            <span class="avatar av-34 tone-@(t.Tone)" data-presence="@t.Id">@t.Initials<i class="dot @(t.Online ? "on" : "")"></i></span>
                            <span class="grow">@t.Name</span>
                            <i class="fa fa-check sn-pick-tick" aria-hidden="true"></i>
                        </label>
                    }
                    @if (Model.Team.Count == 0)
                    {
                        <p class="muted small">No one else is in this workspace yet. Add people on the Team page first.</p>
                    }
                </div>
                <span class="sn-hint"><i class="fa fa-lock" aria-hidden="true"></i> New teammates aren't added automatically. Everybody is always in "Everyone".</span>
            </div>
        </div>
        <div class="sn-dlg-foot">
            <span></span>
            <span style="display:flex;gap:10px">
                <button type="button" class="cee-btn sn-btn-light" data-close>Cancel</button>
                <button type="submit" class="cee-btn cee-btn-gradient"><i class="fa fa-check" aria-hidden="true"></i> Create group</button>
            </span>
        </div>
    </form>
</dialog>

@if (c is { IsDirect: false } && Model.CanEditChannel)
{
<dialog id="editChannelDialog" class="sn-dialog glass-strong">
    <form method="post" asp-antiforgery="true" action="/chat/@c.Id/edit-channel">
        <div class="sn-dlg-head">
            <div class="sn-dlg-title"><span class="sn-dlg-icon"><i class="fa fa-users" aria-hidden="true"></i></span><div><h2>Edit @c.Name</h2><p>Everyone in it sees the new name straight away. Messages and files stay.</p></div></div>
            <button type="button" class="sn-close" data-close aria-label="Close"><i class="fa fa-times" aria-hidden="true"></i></button>
        </div>
        <div class="sn-dlg-body">
            <modern-group-box title="Group | details" header-bg-color="transparent" content-bg-color="transparent" border-color="rgba(255,255,255,.75)" radius="22px" content-layout="block">
                <div style="display:flex;flex-direction:column;gap:14px">
                    <modern-input id="editChannelName" name="name" label="Name" mandatory="true" value="@c.Name" placeholder="Project Alpha" max-length="60" label-font-size="13.5px"></modern-input>
                    <modern-input id="editChannelDesc" name="description" label="Description" value="@Model.CurrentDescription" placeholder="What is this group for?" max-length="300" label-font-size="13.5px"></modern-input>
                    @if (Model.CurrentIsMain)
                    {
                        <span class="sn-hint"><i class="fa fa-lock" aria-hidden="true"></i> Your whole workspace is in this group (new people join it automatically), so it can be renamed but not deleted.</span>
                    }
                </div>
            </modern-group-box>
        </div>
        <div class="sn-dlg-foot">
            @if (Model.CanDeleteChannel)
            {
                <button type="button" class="cee-btn sn-btn-danger-soft" onclick="snDeleteChannel()"><i class="fa fa-trash-o" aria-hidden="true"></i> Delete group</button>
            }
            else
            {
                <span></span>
            }
            <span style="display:flex;gap:10px">
                <button type="button" class="cee-btn sn-btn-light" data-close>Cancel</button>
                <button type="submit" class="cee-btn cee-btn-gradient"><i class="fa fa-check" aria-hidden="true"></i> Save</button>
            </span>
        </div>
    </form>
</dialog>
}

<dialog id="newDmDialog" class="sn-dialog glass-strong">
    <div>
        <div class="sn-dlg-head">
            <div class="sn-dlg-title"><span class="sn-dlg-icon"><i class="fa fa-comment-o" aria-hidden="true"></i></span><div><h2>New chat</h2><p>Pick a teammate. Your past messages with them open too.</p></div></div>
            <button type="button" class="sn-close" data-close aria-label="Close"><i class="fa fa-times" aria-hidden="true"></i></button>
        </div>
        <div class="sn-dlg-body">
            <div class="dm-pick">
                @foreach (var p in Model.Team)
                {
                    <form method="post" asp-antiforgery="true" action="/chat/direct/@p.Id">
                        <button type="submit" class="dm-row">
                            <span class="avatar av-38 tone-@(p.Tone)" data-presence="@p.Id">@p.Initials<i class="dot @(p.Online ? "on" : "")"></i></span>
                            <span class="grow">@p.Name</span>
                            <i class="fa fa-angle-right muted" aria-hidden="true"></i>
                        </button>
                    </form>
                }
                @if (Model.Team.Count == 0)
                {
                    <p class="muted small">No one else is in this workspace yet.</p>
                }
            </div>
        </div>
    </div>
</dialog>

<script id="initialMessages" type="application/json">@Html.Raw(JsonSerializer.Serialize(Model.Messages, jsonOptions))</script>
<script id="readState" type="application/json">@Html.Raw(JsonSerializer.Serialize(Model.ReadState.Select(r => new { id = r.UserId.ToString(), name = r.DisplayName, lastReadUtc = r.LastReadUtc }), jsonOptions))</script>
@if (TempData["Error"] is string error)
{
    <div hidden data-toast="@error" data-toast-kind="error"></div>
}
@if (TempData["Message"] is string okMessage)
{
    <div hidden data-toast="@okMessage" data-toast-kind="success"></div>
}

@section Scripts {
    <script src="~/js/chat.js" asp-append-version="true"></script>
    <script>
        // ---- hover buttons on people: Ping (a quick nudge) and Delete chat ----
        $(document).on("click", "[data-ping]", function (e) {
            e.preventDefault(); e.stopPropagation();
            var btn = this, name = btn.getAttribute("data-name");
            if (btn.classList.contains("busy")) return;
            btn.classList.add("busy", "pinging");
            fetch("/chat/ping/" + btn.getAttribute("data-ping"), { method: "POST", headers: { "RequestVerificationToken": Sahyog.antiforgery() } })
                .then(function (r) { return r.json().then(function (d) { return { ok: r.ok, d: d }; }); })
                .then(function (x) {
                    if (x.ok) Sahyog.toast(x.d.online ? name + " got your ping." : name + " is offline. They'll see it next time they open ShankhNaad.", { kind: x.d.online ? "success" : "info", title: "Ping sent" });
                    else Sahyog.toast(x.d.error || "The ping wasn't sent.", { kind: "warn", title: "Ping" });
                })
                .catch(function () { Sahyog.toast("The ping wasn't sent. Check your connection.", { kind: "error" }); })
                .finally(function () { setTimeout(function () { btn.classList.remove("busy", "pinging"); }, 700); });
        });
        $(document).on("click", "[data-del-chat]", function (e) {
            e.preventDefault(); e.stopPropagation();
            var name = this.getAttribute("data-name");
            SN.confirmPost("/chat/" + this.getAttribute("data-del-chat") + "/delete", {
                title: "Delete chat",
                text: "Delete your chat with " + name + "? All messages and shared files in it are removed for both of you. " + name + " stays in your team, and you can start a new chat any time.",
                confirmText: "Delete chat",
                danger: true
            });
        });

        // ---- New group: pick the people ----
        (function () {
            var form = document.getElementById("newChannelForm");
            if (!form) return;
            function count() {
                var n = form.querySelectorAll('input[name="members"]:checked').length;
                document.getElementById("pickCount").textContent = n + " picked";
                return n;
            }
            form.addEventListener("change", function (e) { if (e.target.name === "members") count(); });
            document.getElementById("pickSearch").addEventListener("input", function () {
                var q = this.value.trim().toLowerCase();
                form.querySelectorAll(".sn-pick").forEach(function (row) { row.hidden = q && row.dataset.name.indexOf(q) < 0; });
            });
            document.getElementById("pickAll").addEventListener("click", function () {
                var boxes = form.querySelectorAll('.sn-pick:not([hidden]) input[name="members"]');
                var all = Array.prototype.every.call(boxes, function (b) { return b.checked; });
                boxes.forEach(function (b) { b.checked = !all; });
                count();
            });
            form.addEventListener("submit", function (e) {
                if (!$.trim($("#channelName").val())) { e.preventDefault(); Sahyog.toast("Give the group a name, for example Project Alpha.", { kind: "warn", title: "Name needed" }); return; }
                if (count() === 0) { e.preventDefault(); Sahyog.toast("Pick at least one person for the group.", { kind: "warn", title: "Who's in it?" }); }
            });
            if (new URLSearchParams(location.search).get("new") === "group") setTimeout(function () { SN.open("newChannelDialog"); }, 350);
        })();

        // ---- Add people (in a one-to-one chat): New group with this person already ticked ----
        function snAddPeople() {
            var form = document.getElementById("newChannelForm");
            form.querySelectorAll('input[name="members"]').forEach(function (b) { b.checked = b.value === "@(c?.DirectWith?.Id)"; });
            form.dispatchEvent(new Event("change", { bubbles: true }));
            var pick = form.querySelector('input[name="members"]:checked');
            document.getElementById("pickCount").textContent = (pick ? 1 : 0) + " picked";
            SN.open("newChannelDialog");
            setTimeout(function () { $("#channelName").trigger("focus"); }, 250);
        }

        // ---- Pin: pinned chats sit at the top of your list, above a thin line ----
        function snPlaceRow(row) {
            var pinnedNow = row.getAttribute("data-pinned") === "true";
            var target = document.getElementById(pinnedNow ? "pinnedList" : "chatList");
            var last = row.getAttribute("data-last") || "";
            var before = Array.prototype.find.call(target.children, function (r) { return r !== row && (r.getAttribute("data-last") || "") < last; });
            row.classList.add("sn-moving");
            target.insertBefore(row, before || null);
            setTimeout(function () { row.classList.remove("sn-moving"); }, 500);
            var any = document.getElementById("pinnedList").children.length > 0;
            document.getElementById("pinnedSection").hidden = !any;
            document.getElementById("pinDivider").hidden = !any;
            document.getElementById("chatCount").textContent = document.getElementById("chatList").children.length;
        }
        function snSetPin(id, pinned) {
            return fetch("/chat/" + id + "/pin?pinned=" + pinned, { method: "POST", headers: { "RequestVerificationToken": Sahyog.antiforgery() } })
                .then(function (r) { return r.json().then(function (d) { return { ok: r.ok, d: d }; }); })
                .then(function (x) {
                    if (!x.ok) { Sahyog.toast(x.d.error || "That didn't work. Try again.", { kind: "warn", title: "Pin" }); return; }
                    document.querySelectorAll('.sn-person-row[data-channel="' + id + '"]').forEach(function (row) {
                        row.setAttribute("data-pinned", pinned ? "true" : "false");
                        var b = row.querySelector("[data-pin]");
                        if (b) { b.title = pinned ? "Unpin" : "Pin to the top"; b.setAttribute("aria-label", b.title); }
                        snPlaceRow(row);
                    });
                    if (id === "@(c?.Id)") {
                        document.querySelectorAll("#ChatHeader .hdr-btn").forEach(function (btn) {
                            var label = btn.querySelector("span");
                            if (label && (label.textContent === "Pin" || label.textContent === "Unpin")) label.textContent = pinned ? "Unpin" : "Pin";
                        });
                    }
                    Sahyog.toast(pinned ? "Pinned to the top of your chats." : "Unpinned.", { kind: "success", ms: 2500 });
                })
                .catch(function () { Sahyog.toast("That didn't work. Check your connection.", { kind: "error" }); });
        }
        $(document).on("click", "[data-pin]", function (e) {
            e.preventDefault(); e.stopPropagation();
            var row = this.closest(".sn-person-row");
            snSetPin(this.getAttribute("data-pin"), row.getAttribute("data-pinned") !== "true");
        });
        function snTogglePin() {
            var row = document.querySelector('.sn-person-row[data-channel="@(c?.Id)"]');
            if (row) snSetPin("@(c?.Id)", row.getAttribute("data-pinned") !== "true");
        }
    </script>
    @if (c is { IsDirect: false } && Model.CurrentIsMain && isAdmin)
    {
        <script>
            function snDeleteChannel() {
                Sahyog.toast("\u201C@Html.Raw(Js(c.Name))\u201D is the group your whole workspace is in, so it can't be deleted. You can rename it with Edit.", { kind: "info", title: "Can't delete" });
            }
        </script>
    }
    @if (c is { IsDirect: false } && Model.CanDeleteChannel)
    {
        <script>
            function snDeleteChannel() {
                SN.confirmPost("/chat/@c.Id/delete-channel", {
                    title: "Delete group",
                    text: "Delete \u201C@Html.Raw(Js(c.Name))\u201D for everyone in it? All its messages and shared files are removed. This cannot be undone.",
                    confirmText: "Delete group",
                    danger: true
                });
            }
        </script>
    }
    @if (c is { IsDirect: true })
    {
        <script>
            function snDeleteChat() {
                SN.confirmPost("/chat/@c.Id/delete", {
                    title: "Delete chat",
                    text: "Delete your chat with @Html.Raw(Js(c.Name))? All messages and shared files are removed for both of you. This cannot be undone.",
                    confirmText: "Delete chat",
                    danger: true
                });
            }
        </script>
    }
}
