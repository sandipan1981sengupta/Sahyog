@model OrgViewModel
@using System.Text.Encodings.Web
@{
    ViewData["Title"] = "Organization";
    ViewData["Section"] = "org";
    var isAdmin = Model.IsAdmin && Model.Ready;
    var me = User.UserId();
    var html = HtmlEncoder.Default;
    var inv = System.Globalization.CultureInfo.InvariantCulture;

    // dropdown items for the tag helpers (their text isn't encoded by the control, so encode it here)
    var deptItems = new List<(string Value, string Text)> { ("", "No department") };
    deptItems.AddRange(Model.Departments.Select(d => (d.DepartmentId.ToString(), html.Encode(d.Name))));
    var managerItems = new List<(string Value, string Text)> { ("", "No manager (top of the chart)") };
    managerItems.AddRange(Model.People.Select(p => (p.Id, html.Encode(string.IsNullOrWhiteSpace(p.JobTitle) ? p.DisplayName : $"{p.DisplayName} · {p.JobTitle}"))));
    var headItems = new List<(string Value, string Text)> { ("", "No head yet") };
    headItems.AddRange(Model.People.Select(p => (p.Id, html.Encode(p.DisplayName))));

    var people = Model.People.Select(p => new
    {
        id = p.Id, n = p.DisplayName, i = p.Initials, t = p.AvatarTone, title = p.JobTitle ?? "", dept = p.DepartmentName ?? "",
        deptId = p.DepartmentId?.ToString() ?? "", mgr = p.ManagerId?.ToString() ?? "", email = p.Email, phone = p.Phone ?? "",
        emp = p.EmployeeCode ?? "", joined = p.JoinedOn?.ToString("dd-MM-yyyy", inv) ?? "",
        joinedText = p.JoinedOn?.ToString("d MMM yyyy", inv) ?? "", admin = p.Role == ShankhNaad.DtoLibrary.AppRoles.TenantAdmin,
        on = Model.Online.Contains(p.Id)
    });
    var depts = Model.Departments.Select(d => new { id = d.DepartmentId.ToString(), n = d.Name, head = d.HeadUserId?.ToString() ?? "", count = d.People });
    var withDept = Model.People.Count(p => p.DepartmentId is not null);
    var subtitle = $"{Model.TenantName} · {Model.People.Count} {(Model.People.Count == 1 ? "person" : "people")} · {Model.Departments.Count} {(Model.Departments.Count == 1 ? "department" : "departments")}";
}

<main class="sn-page sn-page-fixed sn-org-page">
    <div class="sn-head glass">
        <action-header id="OrgHeader"
                       heading="Organization"
                       subtitle="@subtitle"
                       left-icon-css="bi bi-diagram-3-fill" left-icon-size="26"
                       left-icon-gradient-start="#2563EB" left-icon-gradient-mid="#7C3AED" left-icon-gradient-end="#DB2777"
                       background-color="transparent" box-shadow="none"
                       refresh-color="#1D4ED8"
                       show-refresh="true" refresh-on-click="SN.reload()"
                       show-add="false" show-edit="false" show-delete="false" show-import="false"
                       show-export="false" show-save="false" show-submit="false" show-print="true" print-on-click="SN.print()">
            <action-btn text="Export CSV" icon-css="bi bi-download" icon-color="#0EA5E9" tooltip="Download everyone (or the people you picked in Directory) as a spreadsheet" on-click="snOrgExport()"></action-btn>
            @if (isAdmin)
            {
                <action-btn text="Edit person" icon-css="bi bi-person-gear" icon-color="#2563EB" tooltip="Job title, department, manager and contact details of the selected person" on-click="snOrgEdit()"></action-btn>
                <action-btn text="Departments" icon-css="bi bi-briefcase-fill" icon-color="#7C3AED" tooltip="Add, rename or delete departments and choose their head" on-click="snOrgNewDept()"></action-btn>
                <action-btn text="Import CSV" icon-css="bi bi-filetype-csv" icon-color="#15803D" tooltip="Add or update many people at once from a spreadsheet saved as CSV" on-click="snOrgImport()"></action-btn>
            }
        </action-header>
    </div>

    @if (Model.Message is string msg)
    {
        <div hidden data-toast="@msg" data-toast-kind="success"></div>
    }
    @if (Model.Error is string err)
    {
        <div hidden data-toast="@err" data-toast-kind="error" data-toast-title="Not saved"></div>
    }

    @if (!Model.Ready)
    {
        <div class="sn-org-notice glass" role="status">
            <span class="sn-org-notice-ic"><i class="fa fa-database" aria-hidden="true"></i></span>
            <div><b>The organization chart isn't switched on yet</b><p>It needs the database update <code>database/40_OrgStructure.sql</code>. Until then, everyone shows at the top of the chart without a title or department.</p></div>
        </div>
    }

    <div class="sn-org">
        <section class="sn-org-main glass" aria-label="Organization">
            <div class="sn-org-bar">
                <div class="sn-org-bar-t"><b>@Model.TenantName</b><span>@Model.People.Count @(Model.People.Count == 1 ? "person" : "people") · @Model.Departments.Count @(Model.Departments.Count == 1 ? "department" : "departments")</span></div>
                <tab-control id="orgTabs" height="44px" font-size="13.5px" font-weight="600" active-font-weight="700" transition-duration=".38s">
                    <tab id="mgr" text="Chart" icon="bi bi-diagram-3" active="true"></tab>
                    <tab id="dir" text="Directory" icon="bi bi-list-nested" badge="@Model.People.Count.ToString()"></tab>
                    <tab id="dept" text="Departments" icon="bi bi-briefcase" badge="@Model.Departments.Count.ToString()"></tab>
                    <tab id="ins" text="Insights" icon="bi bi-lightbulb"></tab>
                </tab-control>
                <label class="sn-org-search">
                    <i class="fa fa-search" aria-hidden="true"></i>
                    <span class="sr-only">Find a person</span>
                    <input type="search" id="orgSearch" placeholder="Find a person, title or department" autocomplete="off" />
                </label>
            </div>
            <div class="sn-org-sub" id="orgSub">
                <nav class="org-path" id="orgPath" aria-label="Where the selected person sits"></nav>
                <div class="org-filters">
                    <button type="button" class="org-filter" id="orgDeptFilter" aria-haspopup="menu"><span>Department: All</span> <i class="fa fa-angle-down" aria-hidden="true"></i></button>
                    <button type="button" class="org-filter" id="orgOnlineFilter" aria-pressed="false"><i class="org-on-dot on" aria-hidden="true"></i> Online now</button>
                    <button type="button" class="org-filter" id="orgIssueFilter" hidden><span></span> <i class="fa fa-times" aria-hidden="true"></i></button>
                    <span class="org-treebtns" id="orgTreeBtns" role="group" aria-label="Open or close the tree">
                        <button type="button" class="org-filter" data-org-tree="all" title="Open every team, all the way down"><i class="fa fa-plus-square-o" aria-hidden="true"></i> Expand all</button>
                        <button type="button" class="org-filter" data-org-tree="top" title="Close everything below the first level"><i class="fa fa-minus-square-o" aria-hidden="true"></i> Collapse to first level</button>
                    </span>
                </div>
                <div class="org-legend" id="orgLegend" aria-label="Department colours"></div>
            </div>
            <div class="sn-org-viewport" id="orgViewport" tabindex="0" aria-label="Chart: drag to move around, Ctrl + mouse wheel to zoom">
                <div class="sn-org-canvas" id="orgCanvas"></div>
            </div>
            <div class="sn-org-pane" id="orgPane" hidden></div>
            <div class="sn-org-zoom" role="group" aria-label="Zoom">
                <button type="button" data-org-zoom="-1" aria-label="Zoom out" title="Zoom out"><i class="fa fa-minus" aria-hidden="true"></i></button>
                <span id="orgZoomText">100%</span>
                <button type="button" data-org-zoom="1" aria-label="Zoom in" title="Zoom in"><i class="fa fa-plus" aria-hidden="true"></i></button>
                <button type="button" data-org-zoom="fit" aria-label="Fit to screen" title="Fit the whole chart on screen"><i class="fa fa-expand" aria-hidden="true"></i></button>
            </div>
            @if (isAdmin)
            {
                <button type="button" class="org-selmode" id="orgSelMode" aria-pressed="false" title="Pick several people, then drag them together (or Ctrl + click)"><i class="fa fa-check-square-o" aria-hidden="true"></i> <span>Select several</span></button>
                <div class="org-csel glass" id="orgChartSel" hidden role="toolbar" aria-label="People picked in the chart">
                    <span class="org-csel-faces" id="orgCselFaces" aria-hidden="true"></span>
                    <span class="org-csel-t"><b id="orgCselN"></b><small>Drag any of them onto their new manager</small></span>
                    <button type="button" data-csel="dept"><i class="bi bi-briefcase" aria-hidden="true"></i> Department…</button>
                    <button type="button" data-csel="clear" aria-label="Clear the picks"><i class="fa fa-times" aria-hidden="true"></i> Clear</button>
                </div>
            }
            <span class="sn-org-tip" id="orgTip">Click a person for their card · drag the background to move around@(isAdmin ? " · drag a person onto another to change their manager · Ctrl + click to pick several" : "")</span>
            <button type="button" class="org-minimap" id="orgMini" aria-label="Map of the whole chart. Click to go there." title="Map of the whole chart · click to go there"></button>
            <div class="org-bulk" id="orgBulk" hidden role="toolbar" aria-label="Picked people">
                <b id="orgBulkN"></b>
                @if (isAdmin)
                {
                    <button type="button" data-org-bulk="mgr"><i class="bi bi-diagram-2" aria-hidden="true"></i> Change manager…</button>
                    <button type="button" data-org-bulk="dept"><i class="bi bi-briefcase" aria-hidden="true"></i> Move to department…</button>
                }
                <button type="button" data-org-bulk="group"><i class="fa fa-users" aria-hidden="true"></i> Start a group chat</button>
                <button type="button" data-org-bulk="export"><i class="bi bi-download" aria-hidden="true"></i> Export</button>
                <button type="button" class="org-bulk-x" data-org-bulk="clear" aria-label="Clear the picked people"><i class="fa fa-times" aria-hidden="true"></i></button>
            </div>
        </section>

        <div class="sn-org-side glass">
            <div class="org-side-tabs" role="tablist" aria-label="Side panel">
                <button type="button" role="tab" aria-selected="true" data-side="card"><i class="fa fa-id-card-o" aria-hidden="true"></i> Profile</button>
                <button type="button" role="tab" aria-selected="false" data-side="depts"><i class="bi bi-briefcase" aria-hidden="true"></i> Departments <em>@Model.Departments.Count</em></button>
            </div>
            <div class="org-side-body" id="orgSideBody">
            <aside class="sn-org-card" id="orgCard" aria-label="Profile card" aria-live="polite" data-side-pane="card"></aside>

            <aside class="sn-org-depts" aria-label="Departments" data-side-pane="depts" hidden>
                <div class="sn-org-depts-head">
                    <b>Departments</b>
                    <small>@withDept of @Model.People.Count placed</small>
                    @if (isAdmin)
                    {
                        <button type="button" class="sn-org-mini-btn" onclick="snOrgNewDept()"><i class="fa fa-plus" aria-hidden="true"></i> New</button>
                    }
                </div>
                <div class="sn-org-dept-list">
                    @if (Model.Departments.Count == 0)
                    {
                        <p class="sn-org-empty">@(isAdmin ? "No departments yet. Add one with New, or import a CSV: departments in the file are created for you." : "No departments yet.")</p>
                    }
                    @foreach (var d in Model.Departments)
                    {
                        <div class="sn-org-dept" data-dept-row="@d.DepartmentId">
                            <button type="button" class="sn-org-dept-main" data-dept-show="@d.DepartmentId" title="Show @d.Name">
                                <span class="sn-org-dept-ic" aria-hidden="true" data-dept-color="@d.DepartmentId"><i class="bi bi-briefcase-fill"></i></span>
                                <span class="sn-org-dept-t"><b>@d.Name</b><small>@d.People @(d.People == 1 ? "person" : "people")@(d.HeadName is null ? "" : " · Head: " + d.HeadName)</small></span>
                                @if (d.People == 0)
                                {
                                    <span class="org-empty-tag">Empty</span>
                                }
                            </button>
                            @if (isAdmin)
                            {
                                <button type="button" class="sn-org-dept-edit" data-dept-edit="@d.DepartmentId" aria-label="Edit @d.Name" title="Rename, change head or delete"><i class="fa fa-pencil" aria-hidden="true"></i></button>
                            }
                        </div>
                    }
                </div>
            </aside>
            </div>
        </div>
    </div>

    @* Chat, Call, Video and group chat from the page *@
    <div id="orgForms" hidden>
        <form method="post" asp-antiforgery="true" action="/chat" id="orgChatForm"></form>
        <form method="post" asp-antiforgery="true" action="/meetings/instant" id="orgCallForm"><input type="hidden" name="userId" id="orgCallUser" /><input type="hidden" name="video" id="orgCallVideo" value="false" /></form>
    </div>
</main>

@* ---- Directory: start a group chat with the picked people ---- *@
<dialog id="orgGroupDialog" class="sn-dialog glass-strong">
    <form method="post" asp-antiforgery="true" action="/chat/groups" id="orgGroupForm" novalidate>
        <div class="sn-dlg-head">
            <div class="sn-dlg-title"><span class="sn-dlg-icon"><i class="fa fa-users" aria-hidden="true"></i></span><div><h2>New group chat <span class="sn-dlg-tag new">New chat</span></h2><p id="orgGroupSub">With the people you picked</p></div></div>
            <button type="button" class="sn-close" data-close aria-label="Close"><i class="fa fa-times" aria-hidden="true"></i></button>
        </div>
        <div class="sn-dlg-body">
            <modern-group-box title="Group | details" header-bg-color="transparent" content-bg-color="transparent" border-color="rgba(255,255,255,.75)" radius="22px" content-layout="block">
                <div style="display:flex;flex-direction:column;gap:14px">
                    <modern-input id="orgGroupName" name="name" label="Group name" mandatory="true" placeholder="e.g. Engineering leads" max-length="60" label-font-size="13.5px"></modern-input>
                    <div class="org-group-faces" id="orgGroupFaces"></div>
                </div>
            </modern-group-box>
            <div id="orgGroupMembers" hidden></div>
        </div>
        <div class="sn-dlg-foot">
            <span class="muted small">You are added too.</span>
            <span style="display:flex;gap:10px;margin-left:auto">
                <button type="button" class="cee-btn sn-btn-light" data-close>Cancel</button>
                <button type="submit" class="cee-btn cee-btn-gradient"><i class="fa fa-check" aria-hidden="true"></i> Create group</button>
            </span>
        </div>
    </form>
</dialog>

@if (isAdmin)
{
@* ---- Directory: change the manager / department of the picked people ---- *@
<dialog id="orgMoveDialog" class="sn-dialog glass-strong">
    <form method="post" action="#" id="orgMoveForm" novalidate>
        <div class="sn-dlg-head">
            <div class="sn-dlg-title"><span class="sn-dlg-icon"><i class="bi bi-diagram-2" aria-hidden="true"></i></span><div><h2 id="orgMoveH">Change manager</h2><p id="orgMoveSub"></p></div></div>
            <button type="button" class="sn-close" data-close aria-label="Close"><i class="fa fa-times" aria-hidden="true"></i></button>
        </div>
        <div class="sn-dlg-body">
            @* Change manager: one person; suggestions first, search for anyone, see where they will sit *@
            <div id="orgMoveMgrWrap" class="org-cm">
                <div class="org-cm-top">
                    <div class="org-cm-who" id="cmWho"></div>
                    <div class="org-cm-path" id="cmPath" aria-live="polite"></div>
                </div>
                <div class="org-cm-h"><b>Choose the new manager</b><span id="cmSub"></span></div>
                <label class="org-cm-find"><i class="fa fa-search" aria-hidden="true"></i><span class="sr-only">Find a manager</span>
                    <input type="search" id="cmFind" autocomplete="off" /><kbd id="cmEsc" hidden>esc to clear</kbd></label>
                <div class="org-cm-chips" id="cmChips" role="tablist" aria-label="Show"></div>
                <div class="org-cm-list sn-glass-scroll" id="cmList" role="listbox" aria-label="Managers"></div>
            </div>
            <div id="orgMoveDeptWrap">
                <modern-group-box title="Move | people" header-bg-color="transparent" content-bg-color="transparent" border-color="rgba(255,255,255,.75)" radius="22px" content-layout="block">
                    <div style="display:flex;flex-direction:column;gap:14px">
                        <modern-dropdown-with-label id="mvDept" name="departmentId" label="New department" placeholder="No department" items="deptItems" menu-height="240px"></modern-dropdown-with-label>
                        <span class="sn-hint"><i class="fa fa-info-circle" aria-hidden="true"></i> <span id="orgMoveHint">Only the department changes. Who they report to stays the same.</span></span>
                    </div>
                </modern-group-box>
            </div>
        </div>
        <div class="sn-dlg-foot">
            <span class="muted small" id="cmFoot"></span>
            <span style="display:flex;gap:10px;margin-left:auto">
                <button type="button" class="cee-btn sn-btn-light" data-close>Cancel</button>
                <button type="submit" class="cee-btn cee-btn-gradient" id="cmGo"><i class="fa fa-check" aria-hidden="true"></i> <span>Move</span></button>
            </span>
        </div>
    </form>
</dialog>
}

@if (isAdmin)
{
@* ---- edit a person: details, job and place in the organization ---- *@
<dialog id="orgEditDialog" class="sn-dialog glass-strong sn-org-dialog">
    <form method="post" asp-antiforgery="true" action="#" id="orgEditForm" novalidate>
        <div class="sn-dlg-head">
            <div class="sn-dlg-title"><span class="sn-dlg-icon"><i class="fa fa-user" aria-hidden="true"></i></span><div><h2 id="oTitleH">Edit person</h2><p>Details, job and where they sit in the organization</p></div></div>
            <button type="button" class="sn-close" data-close aria-label="Close"><i class="fa fa-times" aria-hidden="true"></i></button>
        </div>
        <div class="sn-dlg-body">
            <modern-group-box title="Person | details" header-bg-color="transparent" content-bg-color="transparent" border-color="rgba(255,255,255,.75)" radius="22px" content-layout="block">
                <div class="sn-org-grid2">
                    <modern-input id="oName" name="displayName" label="Name" mandatory="true" max-length="100" label-font-size="13.5px"></modern-input>
                    <modern-input id="oEmail" name="email" label="Email" mandatory="true" max-length="200" placeholder="name@company.com" label-font-size="13.5px"></modern-input>
                </div>
            </modern-group-box>
            <div style="margin-top:14px">
                <modern-group-box title="Work | details" header-bg-color="transparent" content-bg-color="transparent" border-color="rgba(255,255,255,.75)" radius="22px" content-layout="block">
                    <div style="display:flex;flex-direction:column;gap:14px">
                        <div class="sn-org-grid2">
                            <modern-input id="oJob" name="jobTitle" label="Job title" max-length="100" placeholder="e.g. Senior Developer" label-font-size="13.5px"></modern-input>
                            <modern-dropdown-with-label id="oDept" name="departmentId" label="Department" placeholder="No department" items="deptItems" menu-height="240px"></modern-dropdown-with-label>
                        </div>
                        <modern-dropdown-with-label id="oMgr" name="managerId" label="Reports to (manager)" placeholder="No manager (top of the chart)" items="managerItems" menu-height="260px"></modern-dropdown-with-label>
                        <span class="sn-hint"><i class="fa fa-info-circle" aria-hidden="true"></i> <span id="oMgrHint">The list never offers this person or anyone who reports to them, so the chart can't go round in a circle.</span></span>
                        <div class="sn-org-grid2">
                            <modern-input id="oPhone" name="phone" label="Phone (optional)" max-length="40" input-type="phone" placeholder="+91 98xxx xxxxx" label-font-size="13.5px"></modern-input>
                            <modern-input id="oEmp" name="employeeCode" label="Employee ID" max-length="40" is-read-only="true" placeholder="Given automatically" label-font-size="13.5px"></modern-input>
                        </div>
                        <div class="sn-org-grid2">
                            <modern-datepicker-with-label id="oJoined" name="joined" label="Joined (optional)" placeholder="dd-mm-yyyy"></modern-datepicker-with-label>
                            <span></span>
                        </div>
                        <div>
                            <span class="sn-hint sn-org-emp-hint"><i class="fa fa-check" aria-hidden="true"></i> Employee IDs are given automatically, in order: EMP-000001, EMP-000002, … <span id="oEmpNext"></span></span>
                        </div>
                        <div id="oAdminWrap">
                            <modern-checkbox id="oAdmin" name="makeAdmin" label="Admin of this workspace" desc-text="Off: a normal team member. On: they can also add, edit and remove people and manage groups." is-toggle-button="true" on-text="ON" off-text="OFF" label-font-size="13.5px"></modern-checkbox>
                        </div>
                    </div>
                </modern-group-box>
            </div>
        </div>
        <div class="sn-dlg-foot">
            <span class="muted small">Changing the email or admin role signs them out once.</span>
            <span style="display:flex;gap:10px;margin-left:auto">
                <button type="button" class="cee-btn sn-btn-light" data-close>Cancel</button>
                <button type="submit" class="cee-btn cee-btn-gradient"><i class="fa fa-check" aria-hidden="true"></i> Save</button>
            </span>
        </div>
    </form>
</dialog>

@* ---- a department: name and head ---- *@
<dialog id="orgDeptDialog" class="sn-dialog glass-strong">
    <form method="post" asp-antiforgery="true" action="/org/departments" id="orgDeptForm" novalidate>
        <input type="hidden" name="id" id="dId" />
        <div class="sn-dlg-head">
            <div class="sn-dlg-title"><span class="sn-dlg-icon"><i class="fa fa-briefcase" aria-hidden="true"></i></span><div><h2 id="dTitleH">New department</h2><p>A team people belong to, with the person who leads it</p></div></div>
            <button type="button" class="sn-close" data-close aria-label="Close"><i class="fa fa-times" aria-hidden="true"></i></button>
        </div>
        <div class="sn-dlg-body">
            <modern-group-box title="Department | details" header-bg-color="transparent" content-bg-color="transparent" border-color="rgba(255,255,255,.75)" radius="22px" content-layout="block">
                <div style="display:flex;flex-direction:column;gap:14px">
                    <modern-input id="dName" name="name" label="Name" mandatory="true" max-length="100" placeholder="e.g. Engineering" label-font-size="13.5px"></modern-input>
                    <modern-dropdown-with-label id="dHead" name="headUserId" label="Head of department (optional)" placeholder="No head yet" items="headItems" menu-height="240px"></modern-dropdown-with-label>
                    <span class="sn-hint"><i class="fa fa-info-circle" aria-hidden="true"></i> The head is shown first in the department. Put people in it with Edit person, or with a CSV import.</span>
                </div>
            </modern-group-box>
        </div>
        <div class="sn-dlg-foot">
            <button type="button" class="cee-btn sn-btn-light sn-org-del" id="dDelete" hidden><i class="fa fa-trash" aria-hidden="true"></i> Delete department</button>
            <span style="display:flex;gap:10px;margin-left:auto">
                <button type="button" class="cee-btn sn-btn-light" data-close>Cancel</button>
                <button type="submit" class="cee-btn cee-btn-gradient"><i class="fa fa-check" aria-hidden="true"></i> Save</button>
            </span>
        </div>
    </form>
</dialog>

@* ---- import people from a CSV: Upload → Check → Import ---- *@
<dialog id="orgImportDialog" class="sn-dialog glass-strong sn-org-import">
    <div class="sn-dlg-head">
        <div class="sn-dlg-title"><span class="sn-dlg-icon"><i class="fa fa-file-text-o" aria-hidden="true"></i></span><div><h2>Import people from CSV</h2><p>Add a whole team at once, with titles, departments and managers</p></div></div>
        <button type="button" class="sn-close" data-close aria-label="Close"><i class="fa fa-times" aria-hidden="true"></i></button>
    </div>
    <div class="sn-dlg-body">
        <ol class="sn-org-steps" id="impSteps">
            <li data-step="1" class="on"><span>1</span>Upload</li>
            <li data-step="2"><span>2</span>Check</li>
            <li data-step="3"><span>3</span>Import</li>
        </ol>

        <div data-imp-pane="1">
            <label class="sn-org-drop" id="impDrop">
                <input type="file" id="impFile" accept=".csv,text/csv" />
                <span class="sn-org-drop-ic" aria-hidden="true"><i class="fa fa-cloud-upload"></i></span>
                <b>Drop a CSV file here, or click to choose one</b>
                <small>Columns: name, email, title, department, manager_email, phone, employee_id, joined. Only email is required; name is needed for new people.</small>
            </label>
            <ul class="sn-org-rules">
                <li><i class="fa fa-check" aria-hidden="true"></i> People already in the workspace (same email) are updated. Empty cells keep what they have.</li>
                <li><i class="fa fa-check" aria-hidden="true"></i> <b>manager_email</b> can be the manager's email or their exact name; managers can be in the same file.</li>
                <li><i class="fa fa-check" aria-hidden="true"></i> New departments are created for you. Dates like 15-06-2024 or 2024-06-15.</li>
                <li><i class="fa fa-check" aria-hidden="true"></i> Nothing changes until you press Import on the next step.</li>
            </ul>
        </div>

        <div data-imp-pane="2" hidden>
            <div class="sn-org-file">
                <span class="sn-org-file-ic" aria-hidden="true"><i class="fa fa-file-text-o"></i></span>
                <span class="sn-org-file-t"><b id="impName"></b><small id="impCols"></small></span>
                <button type="button" class="sn-org-mini-btn" id="impAgain">Choose another file</button>
            </div>
            <div class="sn-org-chips" id="impChips"></div>
            <div class="sn-org-table-wrap">
                <table class="sn-org-table">
                    <thead><tr><th>Line</th><th>Name</th><th>Email</th><th>Title</th><th>Department</th><th>Reports to</th><th>Check</th></tr></thead>
                    <tbody id="impRows"></tbody>
                </table>
            </div>
            <p class="sn-org-note">Rows marked in red or yellow are skipped. Fix them in the file and upload again, or import the rest now.</p>
            @if (Model.CanEmail)
            {
                <modern-checkbox id="impInvite" name="sendInvites" label="Email new people a welcome link" desc-text="They set their own password with it (the link works for 7 days)." is-toggle-button="true" on-text="ON" off-text="OFF" checked="true" label-font-size="13.5px"></modern-checkbox>
            }
            else
            {
                <p class="sn-org-note"><i class="fa fa-info-circle" aria-hidden="true"></i> Email isn't set up on this server, so new people get no welcome email. Give them a password from the Team page.</p>
            }
        </div>

        <div data-imp-pane="3" hidden>
            <div class="sn-org-done" id="impDone"></div>
        </div>
    </div>
    <div class="sn-dlg-foot">
        <a class="cee-btn sn-btn-light" href="/org/import/template.csv" download><i class="fa fa-download" aria-hidden="true"></i> Download template</a>
        <span style="display:flex;gap:10px;margin-left:auto">
            <button type="button" class="cee-btn sn-btn-light" id="impBack" hidden>Back</button>
            <button type="button" class="cee-btn sn-btn-light" data-close id="impCancel">Cancel</button>
            <button type="button" class="cee-btn cee-btn-gradient" id="impGo" hidden><i class="fa fa-check" aria-hidden="true"></i> <span>Import</span></button>
        </span>
    </div>
</dialog>
}

@section Scripts {
    <script>
    (function () {
        var people = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(people));
        var depts = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(depts));
        var ME = "@me", IS_ADMIN = @(isAdmin ? "true" : "false");
        var qs = new URLSearchParams(location.search);
        var START = "@(Model.Select ?? "")", START_VIEW = ({ dept: "dept", dir: "dir", ins: "ins" })[qs.get("view")] || "mgr";
        if (location.search) history.replaceState(null, "", location.pathname);

        // ---------- data ----------
        var byId = {}, kids = {};
        people.forEach(function (p) { byId[p.id] = p; });
        function rebuild() {
            kids = {};
            people.forEach(function (p) {
                if (p.mgr && !byId[p.mgr]) p.mgr = "";          // manager not active any more → top of the chart
                if (p.mgr) (kids[p.mgr] = kids[p.mgr] || []).push(p);
            });
        }
        rebuild();
        var deptById = {}; depts.forEach(function (d) { deptById[d.id] = d; });
        // one colour per department (by name), used on the card edge, the tags, the legend and the map
        var PAL = ["#3B82F6", "#10B981", "#F59E0B", "#8B5CF6", "#EC4899", "#06B6D4", "#F97316", "#84CC16"];
        var dcol = {};
        depts.slice().sort(function (a, b) { return a.n.localeCompare(b.n); }).forEach(function (d, i) { dcol[d.id] = PAL[i % PAL.length]; });
        function colorOf(p) { return (p && dcol[p.deptId]) || "#94A3B8"; }
        function deptName(p) { return p.deptId && deptById[p.deptId] ? deptById[p.deptId].n : ""; }

        function esc(s) { return String(s == null ? "" : s).replace(/[&<>"']/g, function (c) { return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]; }); }
        function av(p, size) {
            return '<span class="avatar av-' + size + ' tone-' + (p.t % 6) + '" data-presence="' + p.id + '">' + esc(p.i) + '<i class="dot' + (p.on ? " on" : "") + '"></i></span>';
        }
        function sub(p) { return p.title || deptName(p) || (p.admin ? "Admin" : "Team member"); }
        function dpill(p) {
            var d = deptName(p);
            return d ? '<span class="org-dp" style="--dc:' + colorOf(p) + '"><i aria-hidden="true"></i>' + esc(d) + '</span>' : "";
        }
        function teamSize(id) { var n = 0; (kids[id] || []).forEach(function (c) { n += 1 + teamSize(c.id); }); return n; }
        function descendants(id) {
            var out = {}, stack = [id];
            while (stack.length) { (kids[stack.pop()] || []).forEach(function (c) { if (!out[c.id]) { out[c.id] = 1; stack.push(c.id); } }); }
            return out;
        }
        function chainOf(p) {
            var chain = [], guard = 0;
            for (var m = p.mgr; m && byId[m] && guard < 50; m = byId[m].mgr, guard++) chain.unshift(byId[m]);
            return chain;
        }
        function text(p) { return (p.n + " " + p.title + " " + deptName(p) + " " + p.email).toLowerCase(); }
        function byName(a, b) { return a.n.localeCompare(b.n); }

        // ---------- filters (search, department, online, a "needs a look" list) ----------
        var q = "", deptFilter = "", onlineOnly = false, issue = null;   // issue: { label, ids }
        function passes(p) {
            if (deptFilter === "none" ? !!(p.deptId && deptById[p.deptId]) : (deptFilter && p.deptId !== deptFilter)) return false;
            if (onlineOnly && !p.on) return false;
            if (issue && !issue.ids[p.id]) return false;
            return true;
        }
        function filtering() { return !!(q || deptFilter || onlineOnly || issue); }

        // ---------- a person in the chart ----------
        function node(p, cls) {
            var n = (kids[p.id] || []).length;
            return '<div class="org-node' + (cls ? " " + cls : "") + (p.id === ME ? " me" : "") + (cpick[p.id] ? " cpick" : "") + '" aria-pressed="' + !!cpick[p.id] + '" style="--dc:' + colorOf(p) + '" data-id="' + p.id + '" role="button" tabindex="0" aria-label="' + esc(p.n + ", " + sub(p)) + '">' +
                '<i class="org-node-ck" aria-hidden="true"><i class="fa fa-check"></i></i>' + av(p, 38) + '<span class="org-node-t"><b>' + esc(p.n) + '</b><small>' + esc(p.title || (p.admin ? "Admin" : "Team member")) + '</small>' + dpill(p) + '</span>' +
                (n ? '<button type="button" class="org-badge" data-toggle="' + p.id + '" title="' + teamSize(p.id) + ' in ' + esc(p.n.split(" ")[0]) + '\'s team (' + n + ' direct). Click to show or hide them." aria-label="' + n + (n === 1 ? " report" : " reports") + ', show or hide"><i class="fa fa-users" aria-hidden="true"></i> ' + teamSize(p.id) + '</button>' : "") +
                '</div>';
        }

        // ---------- Chart: pick several people (Ctrl/⌘/Shift + click, or "Select several"), then drag them together ----------
        var cpick = {}, selMode = false;
        function cpickIds() { return Object.keys(cpick).filter(function (id) { return byId[id]; }); }
        // the people that actually move: a picked person inside another picked person's team moves with that team
        function cpickTops(ids) {
            return ids.filter(function (id) { return !chainOf(byId[id]).some(function (c) { return cpick[c.id]; }); });
        }
        function csel() {
            var bar = document.getElementById("orgChartSel"); if (!bar) return;
            var ids = cpickIds();
            bar.hidden = !usesCanvas() || !ids.length;
            $("#orgSelMode").toggleClass("on", selMode).attr("aria-pressed", selMode).prop("hidden", !usesCanvas())
                .find("span").text(selMode ? "Done picking" : "Select several");
            vp.classList.toggle("picking", selMode);
            if (!ids.length) return;
            document.getElementById("orgCselN").textContent = ids.length + (ids.length === 1 ? " person picked" : " people picked");
            document.getElementById("orgCselFaces").innerHTML = ids.slice(0, 4).map(function (id) { return av(byId[id], 28); }).join("") + (ids.length > 4 ? '<i>+' + (ids.length - 4) + '</i>' : "");
            Sahyog.paintPhotos && Sahyog.paintPhotos(bar);
        }
        function cToggle(id) {
            if (cpick[id]) delete cpick[id]; else cpick[id] = 1;
            var el = canvas.querySelector('.org-node[data-id="' + id + '"]');
            if (el) { el.classList.toggle("cpick", !!cpick[id]); el.setAttribute("aria-pressed", !!cpick[id]); }
            csel();
        }
        function cClear() { cpick = {}; $(canvas).find(".org-node.cpick").removeClass("cpick").attr("aria-pressed", "false"); csel(); }
        // ---------- Chart: a tree; people whose reports have no reports of their own get a compact column ----------
        var collapsed = {};
        function branch(p, depth) {
            var list = (kids[p.id] || []).slice().sort(byName);
            if (!list.length) return '<li>' + node(p) + '</li>';
            var leafy = list.every(function (c) { return !(kids[c.id] || []).length; });
            var shut = collapsed[p.id] === true || (collapsed[p.id] === undefined && depth >= 4);
            var inner = leafy
                ? '<ul class="org-stack">' + list.map(function (c) { return '<li>' + node(c, "small") + '</li>'; }).join("") + '</ul>'
                : '<ul>' + list.map(function (c) { return branch(c, depth + 1); }).join("") + '</ul>';
            return '<li class="' + (leafy ? "has-stack" : "") + (shut ? " shut" : "") + '" data-li="' + p.id + '">' + node(p) + inner + '</li>';
        }
        function tops() {
            var roots = people.filter(function (p) { return !p.mgr; }).sort(function (a, b) { return (teamSize(b.id) - teamSize(a.id)) || byName(a, b); });
            return { tops: roots.filter(function (p) { return (kids[p.id] || []).length; }), loose: roots.filter(function (p) { return !(kids[p.id] || []).length; }).sort(byName) };
        }
        function drawManagers() {
            var t = tops();
            var h = t.tops.length ? '<ul class="org-tree org-root">' + t.tops.map(function (p) { return branch(p, 1); }).join("") + '</ul>' : "";
            if (t.loose.length) {
                h += '<div class="org-loose"><div class="org-loose-h"><b>' + (t.tops.length ? "Not placed yet" : "Everyone") + '</b><small>' + t.loose.length +
                    (t.loose.length === 1 ? " person" : " people") + ' without a manager' + (IS_ADMIN ? " · drag them onto their manager, or use Edit person" : "") + '</small></div>' +
                    '<div class="org-loose-grid">' + t.loose.map(function (p) { return node(p, "small"); }).join("") + '</div></div>';
            }
            return h;
        }

        // ---------- Directory: the tree as a table, with tick boxes ----------
        var dirShut = {}, picked = {};
        function dirRows() {
            var out = [];
            if (filtering()) {
                people.filter(function (p) { return passes(p) && (!q || text(p).indexOf(q) >= 0); }).sort(byName).forEach(function (p) { out.push({ p: p, lv: 0, flat: true }); });
                return out;
            }
            function walk(p, lv) {
                out.push({ p: p, lv: lv });
                if (dirShut[p.id]) return;
                (kids[p.id] || []).slice().sort(byName).forEach(function (c) { walk(c, lv + 1); });
            }
            var t = tops();
            t.tops.forEach(function (p) { walk(p, 0); });
            t.loose.forEach(function (p) { walk(p, 0); });
            return out;
        }
        function drawDirectory() {
            var rows = dirRows();
            var allPicked = rows.length && rows.every(function (r) { return picked[r.p.id]; });
            var h = '<div class="org-dir-wrap"><table class="org-dir"><thead><tr>' +
                '<th class="org-dir-ck"><label class="org-ck"><input type="checkbox" data-dir-all' + (allPicked ? " checked" : "") + ' aria-label="Pick everyone shown" /><span></span></label></th>' +
                '<th>Name</th><th>Title</th><th>Department</th><th>Reports to</th><th class="num">Team</th><th>Status</th></tr></thead><tbody>';
            if (!rows.length) h += '<tr><td colspan="7" class="org-dir-empty">No one matches. Clear the search or the filters.</td></tr>';
            rows.forEach(function (r) {
                var p = r.p, n = (kids[p.id] || []).length, team = teamSize(p.id), m = byId[p.mgr];
                h += '<tr data-row="' + p.id + '" class="' + (picked[p.id] ? "picked" : "") + (p.id === selected ? " sel" : "") + '">' +
                    '<td class="org-dir-ck"><label class="org-ck"><input type="checkbox" data-dir-pick="' + p.id + '"' + (picked[p.id] ? " checked" : "") + ' aria-label="Pick ' + esc(p.n) + '" /><span></span></label></td>' +
                    '<td><div class="org-dir-name" style="padding-left:' + (r.lv * 22) + 'px">' +
                    (!r.flat && n ? '<button type="button" class="org-dir-tog' + (dirShut[p.id] ? " shut" : "") + '" data-dir-tog="' + p.id + '" aria-label="' + (dirShut[p.id] ? "Show" : "Hide") + ' ' + esc(p.n.split(" ")[0]) + '\'s team" aria-expanded="' + !dirShut[p.id] + '"><i class="fa fa-angle-down" aria-hidden="true"></i></button>' : '<span class="org-dir-tog-sp"></span>') +
                    av(p, 32) + '<span><b>' + esc(p.n) + (p.id === ME ? ' <em>(you)</em>' : "") + '</b><small>' + esc(p.email) + '</small></span></div></td>' +
                    '<td>' + esc(p.title || "—") + '</td><td>' + (dpill(p) || '<span class="muted">—</span>') + '</td>' +
                    '<td>' + (m ? '<button type="button" class="org-link" data-pick="' + m.id + '">' + esc(m.n) + '</button>' : '<span class="muted">—</span>') + '</td>' +
                    '<td class="num">' + (team ? team + (n !== team ? ' <small class="muted">(' + n + ' direct)</small>' : "") : '<span class="muted">—</span>') + '</td>' +
                    '<td><span class="org-st' + (p.on ? " on" : "") + '" data-presence-text="' + p.id + '"><i class="org-on-dot' + (p.on ? " on" : "") + '" aria-hidden="true"></i>' + (p.on ? "Online" : "Offline") + '</span></td></tr>';
            });
            h += '</tbody></table></div>';
            var shown = rows.length;
            h = '<div class="org-pane-note">' + shown + ' of ' + people.length + ' people' + (filtering() ? " · filtered, shown A–Z" : " · shown as a tree, managers first") + '</div>' + h;
            return h;
        }
        function bulk() {
            var ids = Object.keys(picked).filter(function (id) { return byId[id]; });
            var bar = document.getElementById("orgBulk");
            bar.hidden = view !== "dir" || !ids.length;
            document.getElementById("orgBulkN").textContent = ids.length + " picked";
            $('[data-org-bulk="mgr"]').prop("disabled", ids.length !== 1).attr("title", ids.length === 1 ? "Choose who " + byId[ids[0]].n.split(" ")[0] + " reports to" : "Pick one person to change their manager");
        }

        // ---------- Departments: one card per department ----------
        var deptOpen = {};
        function drawDeptCards() {
            var total = people.length || 1;
            var cols = depts.slice().sort(function (a, b) { return (b.count - a.count) || a.n.localeCompare(b.n); }).map(function (d) {
                return { id: d.id, n: d.n, head: d.head, list: people.filter(function (p) { return p.deptId === d.id; }) };
            });
            var none = people.filter(function (p) { return !p.deptId || !deptById[p.deptId]; });
            if (none.length) cols.push({ id: "", n: "No department", head: "", list: none });
            var list = issues();
            var top = kpis(list);
            var side = '<aside class="org-dview-side" aria-label="Needs a look"><div class="org-dview-side-h"><b>Needs a look</b>' + (list.length ? '<em class="org-ins-n">' + list.length + '</em>' : "") + '</div>' +
                '<p class="org-dview-side-p">Things that make the chart wrong or confusing. Fix them in one click.</p>' + issueCards(list) + '</aside>';
            if (!cols.length) return '<div class="org-dview"><div class="org-dview-main">' + top + '<p class="org-empty-chart">No departments yet.' + (IS_ADMIN ? " Add one with Departments in the bar above, or import a CSV." : "") + '</p></div>' + side + '</div>';
            return '<div class="org-dview"><div class="org-dview-main">' + top + '<div class="org-dcards">' + cols.map(function (c) {
                var color = c.id ? dcol[c.id] : "#94A3B8";
                var head = c.head && byId[c.head] ? byId[c.head] : null;
                var list = c.list.filter(passes).filter(function (p) { return !q || text(p).indexOf(q) >= 0; });
                var rest = list.filter(function (p) { return !head || p.id !== head.id; }).sort(byName);
                var open = deptOpen[c.id || "none"], showN = open ? rest.length : 5;
                var pct = Math.round(c.list.length / total * 100);
                var managers = c.list.filter(function (p) { return (kids[p.id] || []).length; }).length;
                return '<article class="org-dcard" data-dcol="' + c.id + '" style="--dc:' + color + '">' +
                    '<header><span class="org-dcard-ic" aria-hidden="true"><i class="bi bi-briefcase-fill"></i></span><span class="org-dcard-t"><b>' + esc(c.n) + '</b><small>' +
                    c.list.length + (c.list.length === 1 ? " person" : " people") + ' · ' + pct + '%' + (managers ? ' · ' + managers + (managers === 1 ? " team" : " teams") : "") + '</small></span>' +
                    '<span class="org-dcard-faces" aria-hidden="true">' + c.list.slice().sort(byName).slice(0, 4).map(function (p) { return av(p, 28); }).join("") + (c.list.length > 4 ? '<i>+' + (c.list.length - 4) + '</i>' : "") + '</span>' +
                    (IS_ADMIN && c.id ? '<button type="button" class="sn-org-dept-edit" data-dept-edit="' + c.id + '" aria-label="Edit ' + esc(c.n) + '" title="Rename, change head or delete"><i class="fa fa-pencil" aria-hidden="true"></i></button>' : "") + '</header>' +
                    '<div class="org-dcard-bar" aria-hidden="true"><span style="width:' + Math.max(pct, 2) + '%"></span></div>' +
                    (c.id ? (head ? '<button type="button" class="org-dcard-head' + (head.deptId !== c.id ? " away" : "") + '" data-pick="' + head.id + '">' + av(head, 34) + '<span><small>Head</small><b>' + esc(head.n) + '</b></span><em>' + esc(head.title || "") + '</em></button>' +
                        (head.deptId !== c.id ? '<p class="org-dcard-away"><i class="fa fa-exclamation-triangle" aria-hidden="true"></i><span>Head is in ' + (deptName(head) ? '<b>' + esc(deptName(head)) + '</b>' : "no department") + ', not a member of ' + esc(c.n) + '.</span></p>' : "")
                        : '<div class="org-dcard-head none"><i class="fa fa-user-o" aria-hidden="true"></i><span><small>Head</small><b>No head yet</b></span></div>') : "") +
                    '<div class="org-dcard-list">' + rest.slice(0, showN).map(function (p) {
                        var m = byId[p.mgr];
                        return '<button type="button" class="org-dcard-row" data-pick="' + p.id + '">' + av(p, 28) + '<span><b>' + esc(p.n) + '</b><small>' + esc(p.title || "—") + '</small></span>' + (m ? '<em>→ ' + esc(m.n.split(" ")[0]) + '</em>' : "") + '</button>';
                    }).join("") +
                    (!list.length ? '<p class="org-dcol-empty">' + (c.list.length ? "No one here matches the filters." : "No one here yet.") + '</p>' : "") + '</div>' +
                    (rest.length > 5 ? '<button type="button" class="org-link" data-dept-more="' + (c.id || "none") + '">' + (open ? "Show fewer" : "+" + (rest.length - 5) + " more") + '</button>' : "") +
                    '</article>';
            }).join("") + '</div></div>' + side + '</div>';
        }

        // ---------- Insights: numbers and "Needs a look" ----------
        function issues() {
            var out = [];
            var t = tops();
            depts.forEach(function (d) {
                var n = people.filter(function (p) { return p.deptId === d.id; }).length;
                var hd = d.head && byId[d.head];
                if (!n && hd) out.push({ kind: "warn", title: "“" + d.n + "” is empty, but " + hd.n + " is its head", text: hd.n.split(" ")[0] + " is in " + (deptName(hd) || "no department") + ", not " + d.n + ", so the head isn't a member here. If “" + d.n + "” is really a job title, delete it and put the title on " + hd.n.split(" ")[0] + " instead. If it is a real department, move " + hd.n.split(" ")[0] + " into it.",
                    acts: IS_ADMIN ? [{ t: "Delete it", a: "deldept", id: d.id }, { t: "Move " + hd.n.split(" ")[0] + " here", a: "headin", id: hd.id, dept: d.id }, { t: "Edit", a: "dept", id: d.id }] : [] });
                else if (!n) out.push({ kind: "warn", title: "“" + d.n + "” has nobody in it", text: "An empty department makes the chart and the filters harder to read. If it is really a job title, delete it and put the title on the person instead.", acts: IS_ADMIN ? [{ t: "Delete it", a: "deldept", id: d.id }, { t: "Edit", a: "dept", id: d.id }] : [] });
                else if (!d.head || !byId[d.head]) out.push({ kind: "info", title: d.n + " has no head", text: "Choose who leads it; they are shown first in the department.", acts: IS_ADMIN ? [{ t: "Choose a head", a: "dept", id: d.id }] : [] });
                else if (hd.deptId !== d.id) out.push({ kind: "warn", title: "Head isn't a member of " + d.n, text: hd.n + " leads " + d.n + " but is in " + (deptName(hd) || "no department") + ". Usually the head belongs to the department they lead.", acts: IS_ADMIN ? [{ t: "Move " + hd.n.split(" ")[0] + " here", a: "headin", id: hd.id, dept: d.id }, { t: "Choose another head", a: "dept", id: d.id }] : [] });
            });
            if (depts.length) {
                var noDept = people.filter(function (p) { return !p.deptId || !deptById[p.deptId]; });
                if (noDept.length) out.push({ kind: "warn", title: noDept.length + (noDept.length === 1 ? " person has" : " people have") + " no department", text: noDept.slice(0, 4).map(function (p) { return p.n; }).join(", ") + (noDept.length > 4 ? " and " + (noDept.length - 4) + " more" : "") + ".", acts: [{ t: "Show them", a: "list", ids: noDept, label: "No department" }] });
            }
