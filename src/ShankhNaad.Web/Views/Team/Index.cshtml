@model TeamViewModel
@{
    ViewData["Title"] = "Team";
    ViewData["Section"] = "team";
    var full = Model.ActiveUsers >= Model.Limits.MaxUsers;
    // admins add, edit, remove and restore people; members only see the list (the server enforces this too)
    var isAdmin = User.IsInRole(AppRoles.TenantAdmin);
    var m = Model.NewMember;
    var me = User.UserId();
    string Email(string id) => Model.Emails.TryGetValue(id, out var e) ? e : "";
    // team location column: "In office · Bengaluru", "Remote · Pune", "Not shared"
    var locOn = Model.LocationEnabled;
    string Loc(string id)
    {
        if (!Model.Locations.TryGetValue(id, out var l)) return "Not shared";
        if (l.SeenUtc is null) return "Shared";
        var where = l.InOffice switch { true => "In office", false => "Remote", _ => null };
        return where is null ? (l.Place ?? "Shared") : l.City is { Length: > 0 } c ? $"{where} · {c}" : where;
    }

    var rows = Model.People.Select(p => new Dictionary<string, object>
    {
        ["Id"] = p.Id,
        ["Name"] = p.Id == me ? p.Name + " (you)" : p.Name,
        ["DisplayName"] = p.Name,     // edit window (no "(you)")
        ["IsMe"] = p.Id == me,
        ["Email"] = Email(p.Id),
        ["Role"] = p.Role ?? "Member",
        ["Status"] = p.Pending ? "Invited" : p.Online ? "Online" : "Offline",
        ["Pending"] = p.Pending,
        ["Location"] = locOn ? Loc(p.Id) : "",
        ["Active"] = true
    }).Concat(Model.Inactive.Select(p => new Dictionary<string, object>
    {
        ["Id"] = p.Id,
        ["Name"] = p.Name,
        ["DisplayName"] = p.Name,
        ["IsMe"] = false,
        ["Email"] = Email(p.Id),
        ["Role"] = p.Role ?? "Member",
        ["Status"] = "Inactive",
        ["Pending"] = false,
        ["Location"] = "",
        ["Active"] = false
    })).ToList();

    var online = Model.People.Count(p => p.Online);
    var invited = Model.People.Count(p => p.Pending);
    var invitedMeta = invited > 0 ? ", { text: \"" + invited + " invited\", dot: \"admin\" }" : "";
    // e-mail domains already used here, for the "Did you mean …?" hint
    var knownDomains = System.Text.Json.JsonSerializer.Serialize(Model.Emails.Values
        .Select(e => e.Contains('@') ? e.Substring(e.LastIndexOf('@') + 1) : "")
        .Where(d => d.Length > 0).Distinct());
    var admins = Model.People.Count(p => p.Role == "Admin");
    var adminsText = admins == 1 ? "1 admin" : $"{admins} admins";
    var freeSeats = Math.Max(0, Model.Limits.MaxUsers - Model.ActiveUsers);
    // right-hand gauges: seats and storage
    var seatsTotal = Model.Limits.MaxUsers;
    var seatsUsed = Model.ActiveUsers;
    var seatsPct = seatsTotal > 0 ? Math.Min(100, seatsUsed * 100.0 / seatsTotal) : 0;
    var storeTotal = Model.Limits.StorageQuotaBytes;
    var storeUsed = Model.Limits.StorageUsedBytes;
    var storeFree = Math.Max(0, storeTotal - storeUsed);
    var storePct = storeTotal > 0 ? Math.Min(100, storeUsed * 100.0 / storeTotal) : 0;
    // length of the filled part of the gauge arc (radius 84: half circle = 263.89); a sliver stays visible for tiny values
    string Arc(double pct) => ((pct <= 0 ? 0 : Math.Max(1.5, pct)) * 2.6389).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) + " 1000";
    string Pct(double pct) => pct <= 0 ? "0%" : pct < 1 ? "<1%" : $"{Math.Round(pct)}%";
}

<main class="sn-page">
    <div class="sn-head glass">
        <action-header id="TeamHeader"
                       heading="Team"
                       subtitle="@($"{Model.Limits.TenantName} · {Model.ActiveUsers} of {Model.Limits.MaxUsers} people · {Model.Limits.PlanName} plan")"
                       left-icon-css="bi bi-people-fill" left-icon-size="26"
                       left-icon-gradient-start="#2563EB" left-icon-gradient-mid="#7C3AED" left-icon-gradient-end="#DB2777"
                       background-color="transparent" box-shadow="none"
                       refresh-color="#1D4ED8" add-color="#1D4ED8" delete-color="#DC2626" export-color="#15803D" print-color="#334155"
                       show-refresh="true" refresh-on-click="SN.reload()"
                       show-add="@isAdmin" add-text="Add person" add-on-click="@(full ? "snPlanFull()" : "SN.open('addMemberDialog')")"
                       show-edit="@isAdmin" edit-text="Edit" edit-on-click="snEditPerson()"
                       show-delete="@isAdmin" delete-text="Deactivate" delete-on-click="snRemovePerson()"
                       show-import="false"
                       show-export="true" export-on-click="SN.exportTable('TeamTable','team')"
                       show-save="false" show-submit="false"
                       show-print="true" print-on-click="SN.print()">
            <action-btn text="My photo" icon-css="bi bi-person-bounding-box" icon-color="#7C3AED" tooltip="Add or change your profile photo" on-click="snPhotoFor(snMe, snMyName)"></action-btn>
            <action-btn text="Profile" icon-css="bi bi-person-vcard-fill" icon-color="#2563EB" tooltip="@(locOn ? "Photo, details and location of the selected person" : "Photo and details of the selected person")" on-click="snPersonCard()"></action-btn>
            @if (locOn && isAdmin)
            {
                <action-btn text="Office address" icon-css="bi bi-building-fill-check" icon-color="#DB2777" tooltip="The office's internet address: people connecting from it show as In office" on-click="snOfficeSettings()"></action-btn>
            }
            @if (isAdmin)
            {
                <action-btn text="Activate" icon-css="bi bi-person-check-fill" icon-color="#16A34A" tooltip="Let an inactive person sign in again" on-click="snRestorePerson()"></action-btn>
                @if (Model.CanEmail)
                {
                    <action-btn text="Resend invite" icon-css="bi bi-envelope-arrow-up-fill" icon-color="#D97706" tooltip="Send a new invite to someone who hasn't joined yet" on-click="snResendInvite()"></action-btn>
                }
            }
        </action-header>
    </div>

    @if (Model.Message is string msg)
    {
        <div hidden data-toast="@msg" data-toast-kind="success"></div>
    }
    @if (Model.Error is string err)
    {
        <div hidden data-toast="@err" data-toast-kind="error"></div>
    }
    @if (full && isAdmin)
    {
        <div hidden data-toast="Your plan's user limit is reached. Ask CloudWheel to upgrade your plan to add more people." data-toast-kind="warn" data-toast-title="Plan is full"></div>
    }
    @if (!isAdmin)
    {
        <div hidden data-toast="You can see everyone in your workspace. Only workspace admins can add, edit or remove people." data-toast-title="View only"></div>
    }

    <div class="sn-grid-4">
        <div class="sn-stat glass"><span class="sn-stat-ic" style="background:rgba(37,99,235,.1);color:#1d4ed8"><i class="fa fa-users"></i></span><div><div class="sn-eyebrow">People</div><div class="sn-stat-val">@Model.ActiveUsers / @Model.Limits.MaxUsers</div></div></div>
        <div class="sn-stat glass"><span class="sn-stat-ic" style="background:rgba(22,163,74,.1);color:#15803d"><i class="fa fa-circle"></i></span><div><div class="sn-eyebrow">Online now</div><div class="sn-stat-val">@online</div></div></div>
        <div class="sn-stat glass"><span class="sn-stat-ic" style="background:rgba(190,24,93,.1);color:#be185d"><i class="fa fa-shield"></i></span><div><div class="sn-eyebrow">Admins</div><div class="sn-stat-val">@admins</div></div></div>
        <div class="sn-stat glass"><span class="sn-stat-ic" style="background:rgba(124,58,237,.1);color:#6d28d9"><i class="fa fa-hdd-o"></i></span><div><div class="sn-eyebrow">Storage</div><div class="sn-stat-val">@UserExtensions.FormatBytes(Model.Limits.StorageUsedBytes)</div></div></div>
    </div>

    <div class="sn-row" style="flex:1 1 auto">
        <div class="sn-grow">
            <modern-table id="TeamTable" name="SelectedPerson"
                          grid-name="People" icon="users" icon-background-color="linear-gradient(115deg,#2563EB,#DB2777)" icon-color="#fff"
                          show-grid-name-and-icon="true"
                          searchable="true" search-placeholder="Search people..."
                          show-filter-button="true" filter-row-open="false"
                          column-toggle="true" selectable="true" enable-paging="true" page-size="50"
                          is-animated-scrolling="true" row-height="52px" header-height="42px"
                          row-id-field="Id" table-height="100%"
                          items="rows">
                <column field="Id" header="Id" visible="false" filterable="false" sortable="false"></column>
                <column field="Name" header="Name" width="220px"></column>
                <column field="Email" header="Email" width="260px"></column>
                <column field="Role" header="Role" type="badge" width="120px">
                    <badge value="Admin" color="#DBEAFE"></badge>
                    <badge value="Member" color="#E2E8F0"></badge>
                </column>
                <column field="Status" header="Status" type="badge" width="130px">
                    <badge value="Online" color="#DCFCE7"></badge>
                    <badge value="Offline" color="#E2E8F0"></badge>
                    <badge value="Invited" color="#FEF3C7"></badge>
                    <badge value="Inactive" color="#FFE4E6"></badge>
                </column>
                @if (locOn)
                {
                    <column field="Location" header="Location" width="200px"></column>
                }
                @if (isAdmin)
                {
                    <column field="Active" header="Active" type="toggle" width="100px" cell-align="center" header-align="center" filterable="false"></column>
                }
            </modern-table>
        </div>

        <div class="sn-side">
            @* ---- seats ---- *@
            <section class="sn-gauge-card glass" aria-label="Seats: @seatsUsed used, @freeSeats free, @seatsTotal total">
                <header class="sn-gauge-head">
                    <span class="sn-gauge-ic seats"><i class="fa fa-users" aria-hidden="true"></i></span>
                    <div class="sn-gauge-title">
                        <h3>Seats</h3>
                        <small>@seatsUsed used · @freeSeats free · @seatsTotal total</small>
                    </div>
                    <span class="sn-gauge-pill">@Model.Limits.PlanName plan</span>
                </header>
                <div class="sn-gauge">
                    <svg viewBox="0 0 200 112" aria-hidden="true">
                        <defs>
                            <linearGradient id="gSeats" x1="0" y1="0" x2="1" y2="0">
                                <stop offset="0" stop-color="#2563EB" /><stop offset=".55" stop-color="#7C3AED" /><stop offset="1" stop-color="#DB2777" />
                            </linearGradient>
                        </defs>
                        <path class="sn-gauge-track" d="M16 100 A84 84 0 0 1 184 100" />
                        <path class="sn-gauge-value" d="M16 100 A84 84 0 0 1 184 100" stroke="url(#gSeats)" stroke-dasharray="@Arc(seatsPct)" />
                    </svg>
                    <div class="sn-gauge-center">
                        <b>@seatsUsed<span>/@seatsTotal</span></b>
                        <small>@Pct(seatsPct) in use</small>
                    </div>
                </div>
                <div class="sn-gauge-stats">
                    <div><span class="sn-gs-label"><i class="sn-gs-dot used"></i>Used</span><b>@seatsUsed</b></div>
                    <div><span class="sn-gs-label"><i class="sn-gs-dot free"></i>Free</span><b>@freeSeats</b></div>
                    <div><span class="sn-gs-label"><i class="sn-gs-dot total"></i>Total</span><b>@seatsTotal</b></div>
                </div>
            </section>

            @* ---- storage ---- *@
            <section class="sn-gauge-card glass" aria-label="Storage: @UserExtensions.FormatBytes(storeUsed) used of @UserExtensions.FormatBytes(storeTotal)">
                <header class="sn-gauge-head">
                    <span class="sn-gauge-ic store"><i class="fa fa-hdd-o" aria-hidden="true"></i></span>
                    <div class="sn-gauge-title">
                        <h3>Storage</h3>
                        <small>@UserExtensions.FormatBytes(storeUsed) used · @UserExtensions.FormatBytes(storeFree) free · @UserExtensions.FormatBytes(storeTotal) total</small>
                    </div>
                </header>
                <div class="sn-gauge">
                    <svg viewBox="0 0 200 112" aria-hidden="true">
                        <defs>
                            <linearGradient id="gStore" x1="0" y1="0" x2="1" y2="0">
                                <stop offset="0" stop-color="#DB2777" /><stop offset=".55" stop-color="#A855F7" /><stop offset="1" stop-color="#F59E0B" />
                            </linearGradient>
                        </defs>
                        <path class="sn-gauge-track" d="M16 100 A84 84 0 0 1 184 100" />
                        <path class="sn-gauge-value" d="M16 100 A84 84 0 0 1 184 100" stroke="url(#gStore)" stroke-dasharray="@Arc(storePct)" />
                    </svg>
                    <div class="sn-gauge-center">
                        <b>@Pct(storePct)</b>
                        <small>of @UserExtensions.FormatBytes(storeTotal) used</small>
                    </div>
                </div>
                <div class="sn-gauge-stats">
                    <div><span class="sn-gs-label"><i class="sn-gs-dot used store"></i>Used</span><b>@UserExtensions.FormatBytes(storeUsed)</b></div>
                    <div><span class="sn-gs-label"><i class="sn-gs-dot free"></i>Free</span><b>@UserExtensions.FormatBytes(storeFree)</b></div>
                    <div><span class="sn-gs-label"><i class="sn-gs-dot total"></i>Total</span><b>@UserExtensions.FormatBytes(storeTotal)</b></div>
                </div>
            </section>
        </div>
    </div>
</main>

@if (isAdmin)
{
<dialog id="addMemberDialog" class="sn-dialog glass-strong" data-open-on-load="@(Context.Request.Method == "POST" && Model.Error is not null && !full ? "true" : "false")">
    <form method="post" asp-antiforgery="true" action="/team">
        <div class="sn-dlg-head">
            <div class="sn-dlg-title"><span class="sn-dlg-icon"><i class="fa fa-user-plus" aria-hidden="true"></i></span><div><h2>Add a person</h2><p>@(Model.CanEmail ? "We email them a link to set their own password." : "Share the temporary password with them privately.")</p></div></div>
            <button type="button" class="sn-close" data-close aria-label="Close"><i class="fa fa-times" aria-hidden="true"></i></button>
        </div>
        <div class="sn-dlg-body">
            <modern-group-box title="Person | details" header-bg-color="transparent" content-bg-color="transparent" border-color="rgba(255,255,255,.75)" radius="22px" content-layout="block">
                <div style="display:flex;flex-direction:column;gap:14px">
                    <modern-input id="mName" name="NewMember.DisplayName" label="Name" mandatory="true" value="@m.DisplayName" max-length="100" label-font-size="13.5px"></modern-input>
                    <div>
                        <modern-input id="mEmail" name="NewMember.Email" label="Email" mandatory="true" value="@m.Email" max-length="200" placeholder="name@company.com" label-font-size="13.5px"></modern-input>
                        <div class="sn-email-hint" id="mEmailHint" hidden aria-live="polite"></div>
                    </div>
                    <modern-checkbox id="mAdmin" name="NewMember.MakeAdmin" label="Workspace admin" desc-text="Can add, edit and remove people" is-toggle-button="true" checked="@m.MakeAdmin" label-font-size="13.5px"></modern-checkbox>
                    @if (Model.CanEmail)
                    {
                        <modern-checkbox id="mInvite" name="NewMember.SendInvite" label="Email them an invite" desc-text="They get a link to set their own password" is-toggle-button="true" checked="@m.SendInvite" label-font-size="13.5px"></modern-checkbox>
                    }
                    else
                    {
                        <span class="sn-hint"><i class="fa fa-info-circle" aria-hidden="true"></i> Email isn't set up on this server, so set a temporary password and share it with them privately.</span>
                    }
                    <div class="sn-reveal @(Model.CanEmail && m.SendInvite ? "is-collapsed" : "")" id="mPassFields">
                        <div class="sn-reveal-in">
                            <modern-input id="mPass" name="NewMember.TemporaryPassword" label="Temporary password" mandatory="true" is-password="true" placeholder="At least 8 characters" label-font-size="13.5px"></modern-input>
                        </div>
                    </div>
                </div>
            </modern-group-box>
        </div>
        <div class="sn-dlg-foot">
            <span class="muted small">@Model.ActiveUsers of @Model.Limits.MaxUsers seats used</span>
            <span style="display:flex;gap:10px">
                <button type="button" class="cee-btn sn-btn-light" data-close>Cancel</button>
                <button type="submit" class="cee-btn cee-btn-gradient"><i class="fa fa-check" aria-hidden="true"></i> Add person</button>
            </span>
        </div>
    </form>
</dialog>

@* ---- edit a person: name, email, admin role, optional new temporary password ---- *@
<dialog id="editMemberDialog" class="sn-dialog glass-strong">
    <form method="post" asp-antiforgery="true" action="#" id="editMemberForm" novalidate>
        <div class="sn-dlg-head">
            <div class="sn-dlg-title"><span class="sn-dlg-icon"><i class="fa fa-pencil" aria-hidden="true"></i></span><div><h2 id="eTitle">Edit person</h2><p id="eSub">Change their details or give them a new password.</p></div></div>
            <button type="button" class="sn-close" data-close aria-label="Close"><i class="fa fa-times" aria-hidden="true"></i></button>
        </div>
        <div class="sn-dlg-body">
            <modern-group-box title="Person | details" header-bg-color="transparent" content-bg-color="transparent" border-color="rgba(255,255,255,.75)" radius="22px" content-layout="block">
                <div style="display:flex;flex-direction:column;gap:14px">
                    <modern-input id="eName" name="displayName" label="Name" mandatory="true" max-length="100" label-font-size="13.5px"></modern-input>
                    <div>
                        <modern-input id="eEmail" name="email" label="Email" mandatory="true" max-length="200" placeholder="name@company.com" label-font-size="13.5px"></modern-input>
                        <div class="sn-email-hint" id="eEmailHint" hidden aria-live="polite"></div>
                    </div>
                    <div id="eAdminWrap">
                        <modern-checkbox id="eAdmin" name="makeAdmin" label="Workspace admin" desc-text="Can add, edit and remove people" is-toggle-button="true" label-font-size="13.5px"></modern-checkbox>
                    </div>
                    <span class="sn-hint" id="eSelfNote" hidden><i class="fa fa-info-circle" aria-hidden="true"></i> You're an admin. To hand over, make someone else an admin; they can then change your role.</span>
                </div>
            </modern-group-box>
            <div style="margin-top:14px">
                <modern-group-box title="New | password" header-bg-color="transparent" content-bg-color="transparent" border-color="rgba(255,255,255,.75)" radius="22px" content-layout="block">
                    <div style="display:flex;flex-direction:column;gap:10px">
                        <modern-input id="ePass" name="newPassword" label="New temporary password" is-password="true" placeholder="Leave empty to keep the current password" label-font-size="13.5px"></modern-input>
                        <span style="display:flex;gap:6px;align-items:center;flex-wrap:wrap">
                            <button type="button" class="sn-link" id="eGen"><i class="fa fa-magic" aria-hidden="true"></i> Generate one</button>
                            <button type="button" class="sn-link" id="eCopy" hidden><i class="fa fa-clone" aria-hidden="true"></i> Copy</button>
                            @if (Model.CanEmail)
                            {
                                <span class="sn-or">or</span>
                                <button type="button" class="sn-link" id="eSendLink"><i class="fa fa-paper-plane" aria-hidden="true"></i> Email a set-password link</button>
                            }
                        </span>
                        <span class="sn-hint" id="ePassNote"><i class="fa fa-info-circle" aria-hidden="true"></i> Changing the email, role or password signs them out; they sign in again with the new details.</span>
                    </div>
                </modern-group-box>
            </div>
        </div>
        <div class="sn-dlg-foot">
            <span class="muted small" id="eFoot"></span>
            <span style="display:flex;gap:10px">
                <button type="button" class="cee-btn sn-btn-light" data-close>Cancel</button>
                <button type="submit" class="cee-btn cee-btn-gradient"><i class="fa fa-check" aria-hidden="true"></i> Save</button>
            </span>
        </div>
    </form>
</dialog>
}

@* ---- profile photo: shrunk to a small square in the browser, then stored in the database ---- *@
<dialog id="photoDialog" class="sn-dialog glass-strong sn-photo-dialog">
    <div>
        <div class="sn-dlg-head">
            <div class="sn-dlg-title"><span class="sn-dlg-icon"><i class="fa fa-camera" aria-hidden="true"></i></span><div><h2 id="phTitle">Profile photo</h2><p>Only you can change your photo. JPG, PNG or WebP; it's cropped to a square and made small automatically.</p></div></div>
            <button type="button" class="sn-close" data-close aria-label="Close"><i class="fa fa-times" aria-hidden="true"></i></button>
        </div>
        <div class="sn-dlg-body">
            <label class="sn-photo-drop" id="phDrop">
                <input type="file" id="phFile" accept="image/jpeg,image/png,image/webp,image/*" hidden />
                <span class="sn-photo-big" id="phPreview"><span id="phInitials">?</span></span>
                <span class="sn-photo-hint"><i class="fa fa-cloud-upload" aria-hidden="true"></i> Click to choose a picture, or drop one here</span>
            </label>
        </div>
        <div class="sn-dlg-foot">
            <button type="button" class="cee-btn sn-btn-danger-soft" id="phRemove"><i class="fa fa-trash-o" aria-hidden="true"></i> Remove photo</button>
            <span style="display:flex;gap:10px">
                <button type="button" class="cee-btn sn-btn-light" data-close>Cancel</button>
                <button type="button" class="cee-btn cee-btn-gradient" id="phSave" disabled><i class="fa fa-check" aria-hidden="true"></i> Save photo</button>
            </span>
        </div>
    </div>
</dialog>

@* ---- one person: photo, details and (when switched on) where they are ---- *@
<dialog id="personDialog" class="sn-dialog glass-strong sn-person-dialog" aria-labelledby="pcName">
    <div class="sn-dlg-head">
        <div class="sn-dlg-title"><span class="sn-dlg-icon"><i class="bi bi-person-vcard-fill" aria-hidden="true"></i></span><div><h2>Profile</h2><p id="pcSub">@(locOn ? "Details and location" : "Details")</p></div></div>
        <button type="button" class="sn-close" data-close aria-label="Close"><i class="fa fa-times" aria-hidden="true"></i></button>
    </div>
    <div class="sn-dlg-body sn-pc">
        <div class="sn-pc-who">
            <span class="sn-pc-photo avatar sn-photo-big" id="pcPhoto"><span id="pcIni">?</span></span>
            <div class="sn-pc-id">
                <h3 id="pcName">-</h3>
                <div class="sn-pc-tags"><span class="sn-pc-tag" id="pcRole">Member</span><span class="sn-pc-tag" id="pcStatus" data-status="Offline"><i></i><span>Offline</span></span></div>
                <a class="sn-pc-mail" id="pcEmail" href="#"><i class="fa fa-envelope-o" aria-hidden="true"></i> <span></span></a>
            </div>
        </div>
        @if (locOn)
        {
            <section class="sn-pc-loc" id="pcLoc" aria-live="polite">
                <div class="sn-pc-loc-head">
                    <span class="sn-pc-where" id="pcWhere" data-kind="none"><i class="bi bi-geo-alt-fill" aria-hidden="true"></i><span>Loading…</span></span>
                    <small id="pcSeen"></small>
                </div>
                <div class="sn-pc-map" id="pcMap" hidden></div>
                <dl class="sn-pc-kv" id="pcKv" hidden>
                    <div id="pcRowAddr"><dt>Address</dt><dd id="pcAddr">-</dd></div>
                    <div id="pcRowArea"><dt>Area</dt><dd id="pcArea">-</dd></div>
                    <div><dt>City</dt><dd id="pcCity">-</dd></div>
                    <div><dt>State</dt><dd id="pcRegion">-</dd></div>
                    <div><dt>Country</dt><dd id="pcCountry">-</dd></div>
                    <div id="pcRowAcc"><dt>Accuracy</dt><dd id="pcAcc">-</dd></div>
                    <div id="pcRowCoord"><dt>Coordinates</dt><dd id="pcCoord">-</dd></div>
                </dl>
                <p class="sn-pc-empty" id="pcEmpty" hidden></p>
                <div class="sn-pc-acts">
                    <a class="cee-btn sn-btn-light" id="pcGmaps" href="#" target="_blank" rel="noopener" hidden><i class="bi bi-map" aria-hidden="true"></i> Open in Google Maps</a>
                    <button type="button" class="cee-btn sn-btn-light" id="pcShareMe" hidden><i class="bi bi-geo-alt" aria-hidden="true"></i> <span>Share my location</span></button>
                    <button type="button" class="cee-btn sn-btn-light" id="pcUpdate" hidden><i class="fa fa-refresh" aria-hidden="true"></i> Update my location now</button>
                </div>
            </section>
        }
    </div>
</dialog>

@if (locOn && isAdmin)
{
    @* ---- the office's internet address(es): people connecting from one show "In office" ---- *@
    <dialog id="officeDialog" class="sn-dialog glass-strong">
        <form id="officeForm" novalidate>
            <div class="sn-dlg-head">
                <div class="sn-dlg-title"><span class="sn-dlg-icon"><i class="bi bi-building-fill-check" aria-hidden="true"></i></span><div><h2>Office address</h2><p>People connecting from one of these show as <b>In office</b>; everyone else as <b>Remote</b>.</p></div></div>
                <button type="button" class="sn-close" data-close aria-label="Close"><i class="fa fa-times" aria-hidden="true"></i></button>
            </div>
            <div class="sn-dlg-body">
                <label class="sn-field-label" for="ofIps">Internet addresses of the office (one per line)</label>
                <textarea id="ofIps" class="sn-textarea" rows="5" spellcheck="false" placeholder="203.0.113.10&#10;198.51.100.0/24"></textarea>
                <div class="sn-of-me">
                    <span>This computer is connecting from <b id="ofMyIp">…</b> <span class="sn-of-badge" id="ofMyBadge" hidden>In office</span></span>
                    <button type="button" class="sn-link" id="ofAddMine"><i class="fa fa-plus" aria-hidden="true"></i> Add this address</button>
                </div>
                <span class="sn-hint"><i class="fa fa-info-circle" aria-hidden="true"></i> Easiest: open this from a computer in the office and press <b>Add this address</b>. A range like 203.0.113.0/24 covers several. If ShankhNaad runs on a server inside the office, use the office network's range (for example 192.168.1.0/24).</span>
            </div>
            <div class="sn-dlg-foot">
                <span class="muted small" id="ofFoot"></span>
                <span style="display:flex;gap:10px">
                    <button type="button" class="cee-btn sn-btn-light" data-close>Cancel</button>
                    <button type="submit" class="cee-btn cee-btn-gradient"><i class="fa fa-check" aria-hidden="true"></i> Save</button>
                </span>
            </div>
        </form>
    </dialog>
}

@section Scripts {
    <script>
        // ---- table heading: count badge + "online · admins · seats" line ----
        $(function () {
            SN.tableHeading("TeamTable", @Model.People.Count, [
                { text: "@online online", dot: "live" },
                { text: "@adminsText", dot: "admin" },
                { text: "@Model.ActiveUsers of @Model.Limits.MaxUsers seats", dot: "seat" }@Html.Raw(invitedMeta)
            ]);
        });

        var snIsAdmin = @(isAdmin ? "true" : "false");   // members only see the list
        var snLocOn = @(locOn ? "true" : "false");        // team location switched on for this client (super admin)

        // /team?add=1 (from "Add people to the team" in the Schedule window) opens Add person straight away.
        if (snIsAdmin && new URLSearchParams(location.search).get("add") === "1") {
            $(function () { setTimeout(function () { SN.open("addMemberDialog"); }, 450); history.replaceState(null, "", location.pathname); });
        }

        var snMe = "@me";
        // avatar data for the grid: initials and colour per person
        var snPeopleAv = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.People.Concat(Model.Inactive).ToDictionary(p => p.Id, p => new { i = p.Initials, t = p.Tone })));
        (function () {
            var table = document.getElementById("TeamTable");
            if (!table) return;
            function decorate() {
                table.querySelectorAll("tbody tr[data-row-id]").forEach(function (tr) {
                    if (tr.querySelector(".sn-grid-av")) return;
                    var id = tr.getAttribute("data-row-id"), av = snPeopleAv[id];
                    var cell = Array.prototype.find.call(tr.children, function (td) { return !td.classList.contains("mt-col-hidden"); });
                    if (!av || !cell) return;
                    var span = document.createElement("span");
                    span.className = "avatar av-34 tone-" + av.t + " sn-grid-av";
                    span.setAttribute("data-presence", id);
                    span.textContent = av.i;
                    var dot = document.createElement("i"); dot.className = "dot"; span.appendChild(dot);
                    var wrap = document.createElement("span");
                    wrap.className = "sn-grid-name";
                    while (cell.firstChild) wrap.appendChild(cell.firstChild);
                    wrap.insertBefore(span, wrap.firstChild);
                    cell.appendChild(wrap);
                });
                if (snLocOn) decorateLocation();
                Sahyog.paintPhotos && Sahyog.paintPhotos(table);
                Sahyog.paintPresence && Sahyog.paintPresence();
            }
            // the Location column: a coloured pin you can click (opens the profile card)
            function decorateLocation() {
                var heads = Array.prototype.slice.call(table.querySelectorAll("thead th"));
                var col = heads.findIndex(function (th) { return th.textContent.trim() === "Location"; });
                if (col < 0) return;
                table.querySelectorAll("tbody tr[data-row-id]").forEach(function (tr) {
                    var td = tr.children[col];
                    if (!td || td.querySelector(".sn-loc-cell")) return;
                    var text = td.textContent.trim();
                    if (!text) return;
                    var kind = /^In office/.test(text) ? "office" : /^Remote/.test(text) ? "remote" : /^Not shared/.test(text) ? "none" : "shared";
                    td.innerHTML = "";
                    var wrap = document.createElement("span");
                    wrap.className = "sn-loc-cell"; wrap.setAttribute("data-kind", kind);
                    var btn = document.createElement("button");
                    btn.type = "button"; btn.className = "sn-loc-cell-btn"; btn.title = "Open profile and location";
                    btn.setAttribute("aria-label", "Open profile and location");
                    btn.innerHTML = '<i class="bi bi-geo-alt-fill" aria-hidden="true"></i>';
                    var t = document.createElement("span"); t.textContent = text;
                    wrap.appendChild(btn); wrap.appendChild(t); td.appendChild(wrap);
                });
            }
            new MutationObserver(decorate).observe(table, { childList: true, subtree: true });
            $(decorate);
            document.addEventListener("sahyog:connected", decorate);
        })();
        var snMyName = "@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(User.DisplayName()))";

        // ---- edit a person ----
        function snEditPerson(row) {
            row = row || SN.need("TeamTable", "a person");
            if (!row) return;
            snEditRow = row;
            var isMe = row.IsMe === true || row.IsMe === "true" || row.Id === snMe;
            $("#editMemberForm").attr("action", "/team/" + row.Id + "/edit");
            $("#eTitle").text(isMe ? "Edit your details" : "Edit " + (row.DisplayName || row.Name));
            $("#eSub").text(isMe ? "Change your name, email or password." : "Change their details or give them a new password.");
            $("#eName").val(row.DisplayName || row.Name).trigger("input");
            $("#eEmail").val(row.Email).attr("data-original", row.Email).trigger("input");
            $("#ePass").val("").attr("type", "password").trigger("input");
            $("#eCopy").prop("hidden", true);
            var admin = row.Role === "Admin";
            $("#eAdmin").prop("checked", admin).trigger("change");
            $("#eAdminWrap").prop("hidden", isMe);          // you can't remove your own admin role
            $("#eSelfNote").prop("hidden", !isMe);
            $("#ePassNote").html('<i class="fa fa-info-circle" aria-hidden="true"></i> ' + (isMe
                ? "Changing your password keeps you signed in here. Use the new one next time."
                : "Changing the email, role or password signs them out; they sign in again with the new details."));
            $("#eFoot").text(row.Status === "Inactive" ? "This person is inactive. Activate them to let them sign in." : "");
            SN.open("editMemberDialog");
            setTimeout(function () { $("#eName").trigger("focus"); }, 300);
        }
        // double-click a row to edit it
        $(document).on("dblclick", "#TeamTable tbody tr", function () {
            if (!snIsAdmin) return;
            setTimeout(function () { var row = SN.selected("TeamTable"); if (row) snEditPerson(row); }, 0);
        });
        // a strong, easy-to-read temporary password (no look-alike characters)
        $("#eGen").on("click", function () {
            var chars = "ABCDEFGHJKLMNPQRSTUVWXYZabcdefghjkmnpqrstuvwxyz23456789", digits = "23456789", syms = "@@#$%&*";
            var pick = function (set) { var a = new Uint32Array(1); crypto.getRandomValues(a); return set[a[0] % set.length]; };
            var pw = ""; for (var i = 0; i < 9; i++) pw += pick(chars);
            pw += pick(digits) + pick(syms) + pick(digits);
            $("#ePass").val(pw).attr("type", "text").trigger("input");
            $("#eCopy").prop("hidden", false);
        });
        $("#eCopy").on("click", function () { SN.copy($("#ePass").val()); });

        // Edit → "Email a set-password link": they choose a new password themselves
        var snEditRow = null;
        $("#eSendLink").on("click", function () {
            if (!snEditRow) return;
            var who = snEditRow.DisplayName || snEditRow.Name;
            SN.confirmPost("/team/" + snEditRow.Id + "/send-link", {
                title: "Email a set-password link",
                text: "Email " + snEditRow.Email + " a link to choose a new password? It works once, for 3 days. " + (snEditRow.IsMe === true || snEditRow.IsMe === "true" ? "Your" : who + "'s") + " current password keeps working until the link is used.",
                confirmText: "Send link"
            });
        });

        // Add person: with the email invite on, no temporary password is needed
        (function () {
            var box = document.getElementById("mInvite");
            var fields = document.getElementById("mPassFields");
            if (!fields) return;
            function apply() {
                var invite = !!(box && box.checked);
                fields.classList.toggle("is-collapsed", invite);
                fields.inert = invite;
                if (invite) $("#mPass").val("");
            }
            if (box) $(document).on("change", "#mInvite", apply);
            apply();
        })();
        $("#editMemberForm").on("submit", function (e) {
            var name = $.trim($("#eName").val()), email = $.trim($("#eEmail").val()), pw = $("#ePass").val();
            var problem = !name ? "Enter a name."
                : !/^[^\s@@]+@@[^\s@@]+\.[^\s@@]{2,}$/.test(email) ? "Enter a valid email address."
                : pw && pw.length < 8 ? "The new password needs at least 8 characters."
                : "";
            if (problem) { e.preventDefault(); Sahyog.toast(problem, { kind: "warn", title: "Check the details" }); }
        });
        function snPlanFull() {
            Sahyog.toast("Your plan's user limit is reached. Deactivate someone or ask CloudWheel to upgrade the plan.", { kind: "warn", title: "Plan limit reached" });
        }
        // ---- active / inactive: inactive people can't sign in (their messages stay) ----
        function snIsActive(row) { return !(row.Active === false || row.Active === "false"); }
        function snRemovePerson(row) {
            row = row || SN.need("TeamTable", "a person");
            if (!row) return;
            if (row.Id === snMe) { Sahyog.toast("You can't make yourself inactive.", { kind: "info", title: "Not allowed" }); return; }
            if (!snIsActive(row)) { Sahyog.toast((row.DisplayName || row.Name) + " is already inactive.", { kind: "info", title: "Already inactive" }); return; }
            SN.confirmPost("/team/" + row.Id + "/deactivate", {
                title: "Make inactive",
                text: "Make " + (row.DisplayName || row.Name) + " inactive? They're signed out straight away and can't sign in until you activate them again. Their messages stay, and their seat is freed.",
                confirmText: "Make inactive",
                danger: true
            });
        }
        function snRestorePerson(row) {
            row = row || SN.need("TeamTable", "an inactive person");
            if (!row) return;
            if (snIsActive(row)) { Sahyog.toast((row.DisplayName || row.Name) + " is already active.", { kind: "info", title: "Already active" }); return; }
            SN.confirmPost("/team/" + row.Id + "/activate", {
                title: "Activate",
                text: "Activate " + (row.DisplayName || row.Name) + "? They can sign in again with their current password. This uses one seat.",
                confirmText: "Activate"
            });
        }
        // the Active switch in the table: click it to make someone active / inactive (admins only)
        if (snIsAdmin) {
            $("#TeamTable").addClass("sn-active-editable");
            $(document).on("click", "#TeamTable td .mt-switch", function (e) {
                e.preventDefault();
                var id = $(this).closest("tr").attr("data-row-id");
                setTimeout(function () {                       // let the table select the row first
                    var row = SN.selected("TeamTable");
                    if (!row || String(row.Id) !== String(id)) return;
                    if (snIsActive(row)) snRemovePerson(row); else snRestorePerson(row);
                }, 0);
            });
        }

        // ---- "Invited · not joined": send a fresh invite ----
        function snResendInvite(row) {
            row = row || SN.need("TeamTable", "a person who hasn't joined yet");
            if (!row) return;
            var who = row.DisplayName || row.Name;
            var pending = row.Pending === true || row.Pending === "true";
            if (!snIsActive(row)) { Sahyog.toast(who + " is inactive. Activate them first.", { kind: "info", title: "Inactive" }); return; }
            if (!pending) {
                Sahyog.toast(who + " has already joined. To help them with their password, use Edit → \"Email a set-password link\".", { kind: "info", title: "Already joined" });
                return;
            }
            SN.confirmPost("/team/" + row.Id + "/send-link?invite=true", {
                title: "Resend invite",
                text: "Send " + who + " a new invite at " + row.Email + "? It works for 7 days, and any earlier invite link stops working. If this email is wrong, cancel and use Edit to correct it first.",
                confirmText: "Send invite"
            });
        }

        // ---- email typo help in Add and Edit: "Did you mean …?" while typing, and a mail-server check ----
        (function () {
            var common = ["gmail.com", "googlemail.com", "yahoo.com", "yahoo.co.in", "yahoo.in", "ymail.com", "outlook.com", "hotmail.com",
                "live.com", "msn.com", "outlook.in", "hotmail.co.in", "icloud.com", "me.com", "aol.com", "proton.me", "protonmail.com",
                "zoho.com", "zohomail.in", "rediffmail.com", "gmx.com", "mail.com", "yandex.com", "cloudwheel.info"];
            // domains already used in this workspace count too
            $.each(@Html.Raw(knownDomains), function (_, d) {
                if (common.indexOf(d) < 0) common.push(d);
            });
            function dist(a, b) {
                if (Math.abs(a.length - b.length) > 2) return 99;
                var d = [], i, j;
                for (i = 0; i <= a.length; i++) { d[i] = [i]; }
                for (j = 0; j <= b.length; j++) d[0][j] = j;
                for (i = 1; i <= a.length; i++) for (j = 1; j <= b.length; j++) {
                    var c = a[i - 1] === b[j - 1] ? 0 : 1;
                    d[i][j] = Math.min(d[i - 1][j] + 1, d[i][j - 1] + 1, d[i - 1][j - 1] + c);
                    if (i > 1 && j > 1 && a[i - 1] === b[j - 2] && a[i - 2] === b[j - 1]) d[i][j] = Math.min(d[i][j], d[i - 2][j - 2] + 1);
                }
                return d[a.length][b.length];
            }
            function suggest(domain) {
                domain = (domain || "").toLowerCase().replace(/\.$/, "");
                if (domain.length < 3 || common.indexOf(domain) >= 0) return null;
                if (domain.indexOf(".") < 0) { for (var k = 0; k < common.length; k++) if (common[k].indexOf(domain + ".") === 0) return common[k]; }
                var best = null, bd = 99;
                common.forEach(function (c) { var max = c.length <= 8 ? 1 : 2, x = dist(domain, c); if (x <= max && x < bd) { best = c; bd = x; } });
                return best;
            }
            function wire(inputId, hintId) {
                var $in = $("#" + inputId), $hint = $("#" + hintId), timer = 0, seq = 0;
                if (!$in.length) return;
                function show(kind, html) { $hint.attr("data-kind", kind).html(html).prop("hidden", !html); }
                function offer(email, msg, kind) {
                    show(kind, '<i class="fa ' + (kind === "bad" ? "fa-exclamation-circle" : "fa-lightbulb-o") + '" aria-hidden="true"></i> ' + msg);
                }
                function useBtn(fixed) {
                    return ' <button type="button" class="sn-email-fix" data-fix="' + Sahyog.escape(fixed) + '">Did you mean <b>' + Sahyog.escape(fixed) + '</b>?</button>';
                }
                function run(final) {
                    var email = $.trim($in.val()).toLowerCase(), at = email.lastIndexOf("@@");
                    if (at <= 0 || at === email.length - 1) { show("", ""); return; }
                    if ($in.attr("data-original") && email === String($in.attr("data-original")).toLowerCase()) { show("", ""); return; }
                    var local = email.slice(0, at), domain = email.slice(at + 1), s = suggest(domain);
                    if (s) offer(email, useBtn(local + "@@" + s), "tip"); else show("", "");
                    if (!final || domain.indexOf(".") < 0 && !s) return;
                    var my = ++seq;
                    $.getJSON("/team/check-email", { email: email }).done(function (r) {
                        if (my !== seq || $.trim($in.val()).toLowerCase() !== email) return;
                        if (r.status === "nomail" || r.status === "invalid")
                            offer(email, Sahyog.escape(r.message) + (r.suggestion ? useBtn(r.suggestion) : ""), "bad");
                        else if (r.status === "ok" && !r.suggestion) show("ok", '<i class="fa fa-check-circle" aria-hidden="true"></i> ' + Sahyog.escape(r.domain) + " can receive email.");
                    });
                }
                $in.on("input", function () { clearTimeout(timer); run(false); timer = setTimeout(function () { run(true); }, 700); });
                $in.on("blur", function () { clearTimeout(timer); run(true); });
                $hint.on("click", ".sn-email-fix", function () { $in.val($(this).attr("data-fix")).trigger("input").trigger("focus"); });
                $in.closest("dialog").on("close", function () { show("", ""); });
            }
            wire("mEmail", "mEmailHint");
            wire("eEmail", "eEmailHint");
        })();

        // ---- profile photo: pick → crop to a square → shrink to 192 px JPEG → upload ----
        var snPhotoUser = null, snPhotoBlob = null;
        function snPhotoFor(id, name) {
            snPhotoUser = id; snPhotoBlob = null;
            if (id !== snMe) return;   // only your own photo
            document.getElementById("phTitle").textContent = "Your profile photo";
            var prev = document.getElementById("phPreview");
            prev.style.removeProperty("background-image");
            prev.setAttribute("data-user", id);
            prev.classList.remove("has-photo");
            document.getElementById("phInitials").textContent = (name || "?").split(" ").map(function (w) { return w[0] || ""; }).join("").slice(0, 2).toUpperCase();
            Sahyog.paintPhotos && Sahyog.paintPhotos(prev.parentElement);
            document.getElementById("phSave").disabled = true;
            document.getElementById("phRemove").hidden = !(Sahyog.photos && Sahyog.photos[id]);
            document.getElementById("phFile").value = "";
            SN.open("photoDialog");
        }
        function snShrink(file) {
            return new Promise(function (resolve, reject) {
                if (!file || !/^image\//.test(file.type)) { reject("Choose a picture (JPG, PNG or WebP)."); return; }
                if (file.size > 25 * 1024 * 1024) { reject("That file is very large. Pick a smaller picture."); return; }
                var url = URL.createObjectURL(file), img = new Image();
                img.onload = function () {
                    var size = 192, side = Math.min(img.naturalWidth, img.naturalHeight);
                    var sx = (img.naturalWidth - side) / 2, sy = (img.naturalHeight - side) / 2;
                    var canvas = document.createElement("canvas"); canvas.width = size; canvas.height = size;
                    var ctx = canvas.getContext("2d");
                    ctx.fillStyle = "#fff"; ctx.fillRect(0, 0, size, size);   // transparent PNGs get a white background
                    ctx.imageSmoothingQuality = "high";
                    ctx.drawImage(img, sx, sy, side, side, 0, 0, size, size);
                    URL.revokeObjectURL(url);
                    canvas.toBlob(function (b) { b ? resolve(b) : reject("That picture couldn't be read."); }, "image/jpeg", 0.85);
                };
                img.onerror = function () { URL.revokeObjectURL(url); reject("That picture couldn't be read."); };
                img.src = url;
            });
        }
        function snUsePhoto(file) {
            snShrink(file).then(function (blob) {
                snPhotoBlob = blob;
                var prev = document.getElementById("phPreview");
                prev.style.setProperty("background-image", "url(" + URL.createObjectURL(blob) + ")", "important");
                prev.style.setProperty("background-size", "cover", "important");
                prev.style.setProperty("background-position", "center", "important");
                prev.classList.add("has-photo", "sn-photo-new");
                setTimeout(function () { prev.classList.remove("sn-photo-new"); }, 500);
                document.getElementById("phSave").disabled = false;
            }).catch(function (msg) { Sahyog.toast(msg, { kind: "warn", title: "Photo" }); });
        }
        document.getElementById("phFile").addEventListener("change", function () { if (this.files[0]) snUsePhoto(this.files[0]); });
        (function () {
            var drop = document.getElementById("phDrop");
            ["dragenter", "dragover"].forEach(function (t) { drop.addEventListener(t, function (e) { e.preventDefault(); drop.classList.add("over"); }); });
            ["dragleave", "drop"].forEach(function (t) { drop.addEventListener(t, function (e) { e.preventDefault(); drop.classList.remove("over"); }); });
            drop.addEventListener("drop", function (e) { var f = e.dataTransfer.files[0]; if (f) snUsePhoto(f); });
        })();
        document.getElementById("phSave").addEventListener("click", function () {
            if (!snPhotoBlob || !snPhotoUser) return;
            var btn = this, fd = new FormData();
            fd.append("photo", snPhotoBlob, "photo.jpg");
            btn.disabled = true;
            fetch("/team/" + snPhotoUser + "/photo", { method: "POST", body: fd, headers: { "RequestVerificationToken": Sahyog.antiforgery() } })
                .then(function (r) { return r.json().then(function (d) { return { ok: r.ok, d: d }; }); })
                .then(function (x) {
                    if (!x.ok) { Sahyog.toast(x.d.error || "The photo wasn't saved.", { kind: "error", title: "Photo" }); btn.disabled = false; return; }
                    Sahyog.setPhoto && Sahyog.setPhoto(snPhotoUser, x.d.v);
                    document.getElementById("photoDialog").close();
                    Sahyog.toast("Photo saved. Everyone sees it next to the name.", { kind: "success", title: "Profile photo" });
                })
                .catch(function () { Sahyog.toast("The photo wasn't saved. Check your connection.", { kind: "error" }); btn.disabled = false; });
        });
        document.getElementById("phRemove").addEventListener("click", function () {
            if (!snPhotoUser) return;
            fetch("/team/" + snPhotoUser + "/photo/delete", { method: "POST", headers: { "RequestVerificationToken": Sahyog.antiforgery() } })
                .then(function (r) { if (!r.ok) throw 0; Sahyog.setPhoto && Sahyog.setPhoto(snPhotoUser, null); document.getElementById("photoDialog").close(); Sahyog.toast("Photo removed.", { kind: "success" }); })
                .catch(function () { Sahyog.toast("The photo wasn't removed. Try again.", { kind: "error" }); });
        });

        // ================= profile card: photo, details and location =================
        var snMap = null, snMapLayer = null;
        function snLoadLeaflet() {
            if (window.L) return Promise.resolve(window.L);
            if (window.__snLeaflet) return window.__snLeaflet;
            window.__snLeaflet = new Promise(function (ok, fail) {
                var css = document.createElement("link");
                css.rel = "stylesheet"; css.href = "https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css";
                document.head.appendChild(css);
                var js = document.createElement("script");
                js.src = "https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js";
                js.onload = function () { ok(window.L); };
                js.onerror = function () { window.__snLeaflet = null; fail(); };
                document.head.appendChild(js);
            });
            return window.__snLeaflet;
        }
        function snAgo(iso) {
            if (!iso) return "";
            var s = Math.max(0, (Date.now() - new Date(iso).getTime()) / 1000);
            if (s < 90) return "just now";
            if (s < 3600) return Math.round(s / 60) + " min ago";
            if (s < 86400) return Math.round(s / 3600) + " h ago";
            return new Date(iso).toLocaleString([], { day: "numeric", month: "short", hour: "2-digit", minute: "2-digit" });
        }
        function snSetText(id, v) { var el = document.getElementById(id); if (el) el.textContent = v || "-"; return el; }
        function snPersonCard(row) {
            row = row || SN.need("TeamTable", "a person");
            if (!row) return;
            var id = row.Id, av = snPeopleAv[id] || { i: "?", t: 0 };
            var photo = document.getElementById("pcPhoto");
            photo.className = "sn-pc-photo avatar sn-photo-big tone-" + av.t;
            photo.setAttribute("data-user", id);
            photo.style.backgroundImage = "";
            document.getElementById("pcIni").textContent = av.i;
            Sahyog.paintPhotos && Sahyog.paintPhotos(photo.parentElement);
            snSetText("pcName", row.DisplayName || row.Name);
            snSetText("pcRole", row.Role === "Admin" ? "Workspace admin" : "Member");
            var st = document.getElementById("pcStatus");
            st.setAttribute("data-status", row.Status); st.querySelector("span").textContent = row.Status;
            var mail = document.getElementById("pcEmail");
            mail.href = row.Email ? "mailto:" + row.Email : "#"; mail.querySelector("span").textContent = row.Email || "";
            mail.hidden = !row.Email;
            SN.open("personDialog");
            if (snLocOn) snLoadLocation(id, row);
        }
        function snLoadLocation(id, row) {
            var where = document.getElementById("pcWhere"), mapEl = document.getElementById("pcMap");
            var kv = document.getElementById("pcKv"), empty = document.getElementById("pcEmpty");
            var isMe = id === snMe;
            where.setAttribute("data-kind", "none"); where.querySelector("span").textContent = "Loading…";
            snSetText("pcSeen", ""); mapEl.hidden = true; kv.hidden = true; empty.hidden = true;
            ["pcGmaps", "pcShareMe", "pcUpdate"].forEach(function (b) { document.getElementById(b).hidden = true; });
            fetch("/location/person/" + id, { headers: { Accept: "application/json" } })
                .then(function (r) { return r.ok ? r.json() : null; })
                .then(function (d) {
                    if (!d || !d.enabled) { where.querySelector("span").textContent = "Location isn't available"; return; }
                    if (d.sharing !== true) {
                        where.querySelector("span").textContent = "Not shared";
                        empty.hidden = false;
                        empty.textContent = isMe
                            ? "You aren't sharing your location. Share it so your team can see whether you're in the office or remote."
                            : (row.DisplayName || row.Name) + (d.sharing === false ? " chose not to share their location." : " hasn't chosen yet whether to share their location.");
                        if (isMe) document.getElementById("pcShareMe").hidden = false;
                        return;
                    }
                    var kind = d.inOffice === true ? "office" : d.inOffice === false ? "remote" : "shared";
                    where.setAttribute("data-kind", kind);
                    where.querySelector("span").textContent = (kind === "office" ? "In office" : kind === "remote" ? "Remote" : "Location shared")
                        + (d.place ? " · " + d.place : "");
                    snSetText("pcSeen", d.seenUtc ? (d.online ? "Online · checked in " : "Last seen ") + snAgo(d.seenUtc) : "Waiting for the first check-in");
                    if (isMe) document.getElementById("pcUpdate").hidden = false;
                    // details
                    kv.hidden = false;
                    document.getElementById("pcRowAddr").hidden = !d.address;
                    document.getElementById("pcRowArea").hidden = !d.area;
                    document.getElementById("pcRowAcc").hidden = !d.accuracy;
                    document.getElementById("pcRowCoord").hidden = d.lat == null;
                    snSetText("pcAddr", d.address); snSetText("pcArea", d.area); snSetText("pcCity", d.city);
                    snSetText("pcRegion", d.region); snSetText("pcCountry", d.country);
                    // only the rows that have something in them
                    document.getElementById("pcCity").parentElement.hidden = !d.city;
                    document.getElementById("pcRegion").parentElement.hidden = !d.region;
                    document.getElementById("pcCountry").parentElement.hidden = !d.country;
                    kv.hidden = !(d.address || d.area || d.city || d.region || d.country || d.accuracy || d.lat != null);
                    snSetText("pcAcc", d.accuracy ? "± " + (d.accuracy >= 1000 ? (d.accuracy / 1000).toFixed(1) + " km" : d.accuracy + " m") + (d.preciseUtc ? " · " + snAgo(d.preciseUtc) : "") : "");
                    snSetText("pcCoord", d.lat != null ? d.lat.toFixed(5) + ", " + d.lng.toFixed(5) : "");
                    var notes = [];
                    if (d.lat == null && d.canSeeMap) {
                        // your own card: say exactly why and how to fix it
                        var fix = isMe && SN.location && SN.location.howToFix ? SN.location.howToFix() : null;
                        notes.push(isMe
                            ? (fix || "No map position yet. Press Update my location now; allow location when the browser asks.")
                            : "No map position yet: their browser or computer hasn't given a location (office / remote still works).");
                    }
                    if (snIsAdmin && d.officeSet === false)
                        notes.push("Add your office's internet address (Office address, at the top) to show In office / Remote.");
                    if (notes.length) { empty.hidden = false; empty.textContent = notes.join(" "); }
                    if (d.lat == null) return;
                    var g = document.getElementById("pcGmaps");
                    g.href = "https://www.google.com/maps?q=" + d.lat + "," + d.lng; g.hidden = false;
                    mapEl.hidden = false;
                    snLoadLeaflet().then(function (L) {
                        if (!snMap) {
                            snMap = L.map(mapEl, { zoomControl: true, attributionControl: true, scrollWheelZoom: false });
                            L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", { maxZoom: 19, attribution: "&copy; OpenStreetMap contributors" }).addTo(snMap);
                        }
                        if (snMapLayer) snMapLayer.remove();
                        var pin = L.divIcon({ className: "sn-map-pin", iconSize: [46, 56], iconAnchor: [23, 54],
                            html: '<span class="sn-map-pin-face avatar tone-' + ((snPeopleAv[id] || {}).t || 0) + '" data-user="' + id + '">' + ((snPeopleAv[id] || {}).i || "") + '</span>' });
                        snMapLayer = L.layerGroup([
                            L.circle([d.lat, d.lng], { radius: Math.min(d.accuracy || 30, 3000), color: "#7C3AED", weight: 1, fillColor: "#8B5CF6", fillOpacity: .12 }),
                            L.marker([d.lat, d.lng], { icon: pin, title: row.DisplayName || row.Name })
                        ]).addTo(snMap);
                        setTimeout(function () {
                            snMap.invalidateSize();
                            snMap.setView([d.lat, d.lng], d.accuracy && d.accuracy > 800 ? 13 : 16);
                            Sahyog.paintPhotos && Sahyog.paintPhotos(mapEl);
                        }, 60);
                    }).catch(function () { mapEl.hidden = true; empty.hidden = false; empty.textContent = "The map couldn't load (no internet access to the map service). The address is below."; });
                })
                .catch(function () { where.querySelector("span").textContent = "Couldn't load the location"; });
        }
        // the photo / name in a row, or the pin in the Location column, opens the card; members double-click a row
        $(document).on("click", "#TeamTable .sn-grid-av, #TeamTable .sn-loc-cell-btn", function () {
            var id = $(this).closest("tr").attr("data-row-id");
            // the click also selects the row (the table handles that first); then open that person's card
            setTimeout(function () { var r = SN.selected("TeamTable"); if (r && String(r.Id) === String(id)) snPersonCard(r); }, 30);
        });
        $(document).on("dblclick", "#TeamTable tbody tr", function () {
            if (snIsAdmin) return;
            setTimeout(function () { var row = SN.selected("TeamTable"); if (row) snPersonCard(row); }, 0);
        });
        // your own sharing, from your card
        $("#pcShareMe").on("click", function () {
            if (!window.SN || !SN.location) return;
            SN.location.setSharing(true).then(function () { var r = SN.selected("TeamTable"); if (r) setTimeout(function () { snLoadLocation(r.Id, r); }, 1500); });
        });
        $("#pcUpdate").on("click", function () {
            var b = this; b.disabled = true;
            (SN.location ? SN.location.checkIn(true) : Promise.resolve(null)).then(function (res) {
                var r = SN.selected("TeamTable"); if (r) snLoadLocation(r.Id, r);
                if (res && res.position) Sahyog.toast("Your location was updated" + (res.place ? ": " + res.place : "") + ".", { kind: "success", title: "Location" });
                else Sahyog.toast((res && res.problem) || "No map position this time. Office / remote was updated.", { kind: "warn", title: "No map position", ms: 12000 });
            }).finally(function () { b.disabled = false; });
        });

        // ================= admins: the office's internet address =================
        function snOfficeSettings() {
            fetch("/location/office", { headers: { Accept: "application/json" } })
                .then(function (r) { return r.json(); })
                .then(function (d) {
                    $("#ofIps").val(d.ips || "");
                    $("#ofMyIp").text(d.myIp || "unknown");
                    $("#ofMyBadge").prop("hidden", !d.myIpInOffice);
                    $("#ofAddMine").prop("hidden", !d.myIp || d.myIpInOffice).data("ip", d.myIp);
                    $("#ofFoot").text((d.ips || "").trim() ? "" : "No office address yet: everyone shows the city only.");
                    SN.open("officeDialog");
                })
                .catch(function () { Sahyog.toast("Couldn't load the office settings.", { kind: "error" }); });
        }
        $("#ofAddMine").on("click", function () {
            var ip = $(this).data("ip"), cur = $("#ofIps").val().trim();
            if (!ip) return;
            $("#ofIps").val((cur ? cur + "\n" : "") + ip);
            $(this).prop("hidden", true);
        });
        $("#officeForm").on("submit", function (e) {
            e.preventDefault();
            var fd = new FormData(); fd.append("ips", $("#ofIps").val());
            fetch("/location/office", { method: "POST", body: fd, headers: { "RequestVerificationToken": Sahyog.antiforgery() } })
                .then(function (r) { return r.json().then(function (d) { return { ok: r.ok, d: d }; }); })
                .then(function (x) {
                    if (!x.ok) { Sahyog.toast(x.d.error || "Not saved.", { kind: "error", title: "Office address" }); return; }
                    document.getElementById("officeDialog").close();
                    Sahyog.toast(x.d.count ? "Office address saved. People connecting from it show as In office." : "Office address cleared.", { kind: "success", title: "Office address" });
                    SN.location && SN.location.checkIn(false);
                })
                .catch(function () { Sahyog.toast("Not saved. Check your connection.", { kind: "error" }); });
        });
    </script>
}
