@model FilesViewModel
@{
    ViewData["Title"] = "Files";
    ViewData["Section"] = "files";
    var me = User.UserGuid();
    var byMe = Model.Files.Count(f => f.UploaderId == me);
    var total = Model.Files.Sum(f => f.SizeBytes);
    var chats = Model.Files.Select(f => f.ChannelId).Distinct().Count();

    // file kind from its name and type: icon, colour, label, filter key
    (string Key, string Icon, string Label) Kind(SharedFileDto f)
    {
        var ext = System.IO.Path.GetExtension(f.FileName).TrimStart('.').ToLowerInvariant();
        var ct = f.ContentType.ToLowerInvariant();
        if (ct.StartsWith("image/")) return ("image", "fa-file-image-o", "Image");
        if (ct.StartsWith("video/")) return ("video", "fa-file-video-o", "Video");
        if (ct.StartsWith("audio/")) return ("audio", "fa-file-audio-o", "Audio");
        if (ext == "pdf") return ("pdf", "fa-file-pdf-o", "PDF");
        if (ext is "doc" or "docx" or "rtf" or "odt" or "txt" or "md") return ("doc", "fa-file-word-o", "Document");
        if (ext is "xls" or "xlsx" or "csv" or "ods") return ("sheet", "fa-file-excel-o", "Spreadsheet");
        if (ext is "ppt" or "pptx" or "odp") return ("slide", "fa-file-powerpoint-o", "Presentation");
        if (ext is "zip" or "rar" or "7z" or "gz" or "tar") return ("zip", "fa-file-archive-o", "Archive");
        if (ext is "cs" or "js" or "ts" or "json" or "xml" or "sql" or "html" or "css" or "py") return ("code", "fa-file-code-o", "Code");
        return ("other", "fa-file-o", ext.Length > 0 ? ext.ToUpperInvariant() : "File");
    }
    var kinds = Model.Files.Select(Kind).GroupBy(k => k.Key).Select(g => (Key: g.Key, Label: g.First().Label, Count: g.Count())).OrderByDescending(g => g.Count).ToList();
}

@{ var isAdmin = User.IsInRole(AppRoles.TenantAdmin); }
<main class="sn-page sn-page-fixed">
    <div class="sn-head glass">
        <action-header id="FilesHeader"
                       heading="Files"
                       subtitle="Every file shared with you or by you, and the chat it's in"
                       left-icon-css="bi bi-folder-fill" left-icon-size="24"
                       left-icon-gradient-start="#F59E0B" left-icon-gradient-mid="#EA580C" left-icon-gradient-end="#DB2777"
                       background-color="transparent" box-shadow="none"
                       refresh-color="#1D4ED8"
                       show-refresh="true" refresh-on-click="SN.reload()"
                       show-add="false" show-edit="false" show-delete="false" show-import="false"
                       show-export="false" show-save="false" show-submit="false" show-print="false">
        </action-header>
    </div>

    @if (TempData["HistoryMsg"] is string hm)
    {
        <div hidden data-toast="@hm" data-toast-kind="success"></div>
    }
    @if (TempData["HistoryError"] is string he)
    {
        <div hidden data-toast="@he" data-toast-kind="warn"></div>
    }
    @if (Model.NeedsSql)
    {
        <div hidden data-toast="Run database/23_CallsAndFiles.sql (or 99_ApplyAllUpdates.sql) to see your shared files here." data-toast-kind="warn" data-toast-title="One database step left"></div>
    }

    @* the four totals sit above the file list only; the Team panel (search, pins, Share) runs the full height beside them *@
    <div class="sn-calls-split sn-files-split">
    <div class="sn-calls-left">
    <div class="sn-grid-4">
        <div class="sn-stat glass"><span class="sn-stat-ic" style="background:rgba(245,158,11,.14);color:#d97706"><i class="fa fa-files-o"></i></span><div><div class="sn-eyebrow">Files</div><div class="sn-stat-val">@Model.Files.Count</div></div></div>
        <div class="sn-stat glass"><span class="sn-stat-ic" style="background:rgba(124,58,237,.12);color:#6d28d9"><i class="fa fa-upload"></i></span><div><div class="sn-eyebrow">Shared by you</div><div class="sn-stat-val">@byMe</div></div></div>
        <div class="sn-stat glass"><span class="sn-stat-ic" style="background:rgba(22,163,74,.12);color:#15803d"><i class="fa fa-download"></i></span><div><div class="sn-eyebrow">Shared with you</div><div class="sn-stat-val">@(Model.Files.Count - byMe)</div></div></div>
        <div class="sn-stat glass"><span class="sn-stat-ic" style="background:rgba(14,165,233,.12);color:#0284c7"><i class="fa fa-hdd-o"></i></span><div><div class="sn-eyebrow">Total size · @chats chats</div><div class="sn-stat-val">@UserExtensions.FormatBytes(total)</div></div></div>
    </div>

    <section class="sn-hist glass" id="fileHist" data-delete-url="/files/delete" data-noun="file" data-nouns="files">
        <div class="sn-hist-bar">
            <tab-control id="fileTabs" height="44px" font-size="13.5px" font-weight="600" active-font-weight="600" transition-duration=".38s"
                         background="rgba(255,255,255,.55)" active-background-color="#ffffff"
                         text-color="#475569" active-text-color="#0B1220" border-color="rgba(15,23,42,.08)">
                <tab id="all" text="All" icon="bi bi-folder2-open" badge="@Model.Files.Count.ToString()" active="true"></tab>
                <tab id="mine" text="Shared by you" icon="bi bi-box-arrow-up-right" badge="@byMe.ToString()"></tab>
                <tab id="theirs" text="Shared with you" icon="bi bi-box-arrow-in-down-left" badge="@((Model.Files.Count - byMe).ToString())"></tab>
            </tab-control>
            <label class="search sn-hist-search">
                <i class="fa fa-search" aria-hidden="true"></i>
                <input type="search" placeholder="Search file, person or group" aria-label="Search files" data-hist-search />
            </label>
            <div class="sn-hist-tools">
                <button type="button" class="sn-tool" data-select-toggle title="Pick files to remove from your list"><i class="fa fa-check-square-o" aria-hidden="true"></i> <span>Select</span></button>
                <button type="button" class="sn-tool danger" data-delete-selected hidden title="They stay in the chat"><i class="fa fa-eye-slash" aria-hidden="true"></i> Remove from my list (<span data-pick-count>0</span>)</button>
                <button type="button" class="sn-tool danger" data-delete-all title="Hides every file from your list. They stay in the chat and still use storage."><i class="fa fa-eye-slash" aria-hidden="true"></i> Clear my list</button>
                @if (isAdmin)
                {
                    <button type="button" class="sn-tool sn-tool-free" onclick="snFreeUpSpace()" title="Delete everyone's chat files in this workspace and free storage"><i class="fa fa-eraser" aria-hidden="true"></i> Free up space</button>
                }
            </div>
        </div>
        @if (kinds.Count > 1)
        {
            <div class="sn-hist-chips" aria-label="File type">
                <button type="button" class="on" data-type="">All types</button>
                @foreach (var k in kinds)
                {
                    <button type="button" data-type="@k.Key" class="t-@k.Key">@k.Label <span>@k.Count</span></button>
                }
            </div>
        }

        <div class="sn-hist-list">
            @foreach (var f in Model.Files)
            {
                var k = Kind(f);
                var mine = f.UploaderId == me;
                var canView = ShankhNaad.Web.Controllers.ChatController.CanShowInPlace(f.ContentType);
                var where = f.IsDirect ? (f.OtherName ?? "Someone") : f.ChannelName;
                <div class="sn-hrow sn-frow" data-id="@f.AttachmentId" data-label="@f.FileName"
                     data-fv-url="/chat/file/@f.AttachmentId" data-fv-name="@f.FileName" data-fv-type="@f.ContentType" data-fv-size="@f.SizeBytes" data-mine="@(mine ? "1" : "0")" data-kind="@(mine ? "mine" : "theirs")" data-type="@k.Key"
                     data-filter="@f.FileName @where @f.UploaderName" data-utc="@f.UploadedUtc.ToString("o")">
                    <label class="sn-hpick" title="Pick"><input type="checkbox" data-pick aria-label="Pick" /></label>
                    <span class="sn-ftile t-@k.Key"><i class="fa @k.Icon" aria-hidden="true"></i></span>
                    <div class="sn-hmain">
                        @if (canView)
                        {
                            <button type="button" class="ellipsis sn-fname" data-fv-view title="View @f.FileName">@f.FileName</button>
                        }
                        else
                        {
                            <a class="ellipsis sn-fname" href="/chat/file/@(f.AttachmentId)?dl=1" download="@f.FileName" title="Download @f.FileName">@f.FileName</a>
                        }
                        <small class="sn-hstat dim">@k.Label · @UserExtensions.FormatBytes(f.SizeBytes) · @(mine ? "shared by you" : $"shared by {f.UploaderName}")</small>
                    </div>
                    <span class="sn-fwhere" title="@(f.IsDirect ? $"Your chat with {where}" : $"The group {where}")">
                        @if (f.IsDirect && f.OtherId is Guid oid)
                        {
                            <span class="avatar av-28 tone-@f.OtherTone" data-user="@oid" data-presence="@oid">@Names.Initials(where)<i class="dot @(Model.Online.Contains(oid.ToString()) ? "on" : "")"></i></span>
                        }
                        else
                        {
                            <span class="avatar av-28 tone-0 hash-avatar group-avatar"><i class="fa fa-users" aria-hidden="true"></i></span>
                        }
                        <span class="ellipsis">@(f.IsDirect ? "with " : "in ")@where</span>
                    </span>
                    <time class="sn-htime" datetime="@f.UploadedUtc.ToString("o")" data-utc="@f.UploadedUtc.ToString("o")"></time>
                    <div class="sn-hact">
                        @if (canView)
                        {
                            <button type="button" class="sn-hbtn view" data-fv-view title="View"><i class="fa fa-eye" aria-hidden="true"></i><span>View</span></button>
                        }
                        <a class="sn-hbtn call" href="/chat/file/@(f.AttachmentId)?dl=1" download="@f.FileName" title="Download"><i class="fa fa-download" aria-hidden="true"></i><span>Download</span></a>
                        <a class="sn-hbtn chat" href="/chat/@f.ChannelId" title="Open the chat it was shared in"><i class="fa fa-comment" aria-hidden="true"></i><span>Chat</span></a>
                        <button type="button" class="sn-hbtn del" data-del-one title="@(mine ? "Delete" : "Remove from my list")" aria-label="@(mine ? "Delete" : "Remove from my list")"><i class="fa @(mine ? "fa-trash-o" : "fa-eye-slash")" aria-hidden="true"></i></button>
                    </div>
                </div>
            }
            <div class="sn-hist-empty" @(Model.Files.Count > 0 ? "hidden" : "")>
                <span class="sn-hist-empty-ic files"><i class="fa fa-folder-open-o" aria-hidden="true"></i></span>
                <b>No files yet</b>
                <p>Files you send or get in Chat (the paper-clip button) show up here.</p>
                <a class="sn-hbtn call" href="/chat"><i class="fa fa-comments-o" aria-hidden="true"></i><span>Go to Chat</span></a>
            </div>
            <div class="sn-hist-none" hidden>Nothing matches. Try another tab, type or name.</div>
        </div>
    </section>
    </div>

    <partial name="_TeamPanel" model="Model.TeamPanel" />
    </div>
</main>

@if (isAdmin)
{
    @* ---- workspace admin: free up space (everyone's chat files in this workspace) ---- *@
    <dialog id="freeSpaceDialog" class="sn-dialog glass-strong">
        <form method="post" asp-antiforgery="true" id="freeSpaceForm" action="/files/free-up" novalidate>
            <div class="sn-dlg-head">
                <div class="sn-dlg-title"><span class="sn-dlg-icon sn-dlg-icon-danger"><i class="fa fa-eraser" aria-hidden="true"></i></span><div><h2>Free up space</h2><p>Delete chat files for everyone in @User.TenantName()</p></div></div>
                <button type="button" class="sn-close" data-close aria-label="Close"><i class="fa fa-times" aria-hidden="true"></i></button>
            </div>
            <div class="sn-dlg-body">
                <div class="sn-fs-now"><span>Chat files now</span><b id="fsTotal">-</b></div>
                <span class="sn-hint"><i class="fa fa-info-circle" aria-hidden="true"></i> This deletes the files from every chat and group, for everyone, not just your list. Messages, meetings and recordings stay.</span>
                <div style="margin-top:14px">
                    <modern-radio-group id="fsAge" name="age" label="Delete files sent" selected-value="90" label-font-size="13.5px">
                        <modern-radio value="30" label="Over 30 days ago"></modern-radio>
                        <modern-radio value="90" label="Over 3 months ago"></modern-radio>
                        <modern-radio value="180" label="Over 6 months ago"></modern-radio>
                        <modern-radio value="365" label="Over a year ago"></modern-radio>
                        <modern-radio value="all" label="All files"></modern-radio>
                    </modern-radio-group>
                </div>
                <div class="sn-fs-result" id="fsResult" aria-live="polite">Checking…</div>
                <label class="sn-fs-agree"><input type="checkbox" id="fsAgree" /> I understand these files are deleted for everyone and can't be recovered.</label>
                <span class="sn-hint">Each chat message stays and says the file was removed.</span>
            </div>
            <div class="sn-dlg-foot">
                <span></span>
                <span style="display:flex;gap:10px">
                    <button type="button" class="cee-btn sn-btn-light" data-close>Cancel</button>
                    <button type="submit" class="cee-btn sn-btn-danger" id="fsSubmit" disabled><i class="fa fa-eraser" aria-hidden="true"></i> <span>Delete files</span></button>
                </span>
            </div>
        </form>
    </dialog>
}

@section Scripts {
    <script src="~/js/history.js" asp-append-version="true"></script>
    @if (isAdmin)
    {
        <script>
            (function () {
                var seq = 0, ready = false;
                function age() { return $('#freeSpaceForm input[name="age"]:checked').val() || "90"; }
                function paintSubmit() { $("#fsSubmit").prop("disabled", !(ready && $("#fsAgree").prop("checked"))); }
                function preview() {
                    var s = ++seq; ready = false; paintSubmit();
                    $("#fsResult").removeClass("none").text("Checking…");
                    $.getJSON("/files/free-up", { age: age() }).done(function (d) {
                        if (s !== seq) return;
                        $("#fsTotal").text(d.totalText + " in " + d.totalFiles + " file" + (d.totalFiles === 1 ? "" : "s"));
                        if (d.files === 0) { $("#fsResult").addClass("none").text("No files match. Nothing to delete."); return; }
                        $("#fsResult").text("This deletes " + d.files + " file" + (d.files === 1 ? "" : "s") + " for everyone and frees " + d.text + ".");
                        $("#fsSubmit").find("span").text("Delete " + d.files + " file" + (d.files === 1 ? "" : "s"));
                        ready = true; paintSubmit();
                    }).fail(function () { if (s === seq) $("#fsResult").addClass("none").text("Couldn't check the files. Try again."); });
                }
                window.snFreeUpSpace = function () {
                    $("#fsAgree").prop("checked", false);
                    $("#fsTotal").text("-");
                    $("#fsSubmit").find("span").text("Delete files");
                    SN.open("freeSpaceDialog");
                    preview();
                };
                $(document).on("change", '#freeSpaceForm input[name="age"]', preview);
                $("#fsAgree").on("change", paintSubmit);
                $("#freeSpaceForm").on("submit", function (e) {
                    if ($("#fsSubmit").prop("disabled")) { e.preventDefault(); return; }
                    $("#fsSubmit").prop("disabled", true).html('<i class="fa fa-spinner fa-spin" aria-hidden="true"></i> Deleting…');
                });
            })();
        </script>
    }
}
