<script id="busyJson" type="application/json">@Html.Raw(JsonSerializer.Serialize(busy))</script>
@* colleagues' names, so the calendar can show who is out of office on each day *@
<script id="teamJson" type="application/json">@Html.Raw(JsonSerializer.Serialize(Model.Team.Where(p => !p.Pending).Select(p => new { id = p.Id, name = p.Name })))</script>

@section Scripts {
    @* charts are only used on this page, so their scripts load only here *@
    <script src="~/lib/Mordern-Controls/JS/Chart.js-v4.5.1.js"></script>
    <script src="~/js/web-control/modern-donut-chart.js" asp-append-version="true"></script>
    <script>
        // ---- table heading: count badge + "live · upcoming · ended" line ----
        $(function () {
            SN.tableHeading("MeetingsTable", @events.Count, [
                { text: "@live live", dot: "live" },
                { text: "@upcomingCount upcoming", dot: "up" },
                { text: "@endedCount ended", dot: "ended" }
            ]);
        });

        // Action-header buttons that work on the selected row of the grid.
        function snJoinMeeting() {
            var row = SN.need("MeetingsTable", "a meeting");
            if (row) SN.go("/meetings/room/" + row.MeetingId);
        }
        var SN_HERE = location.pathname + location.search;
        // what the Delete button / 🗑 may do with each meeting on screen: cancel | delete | hide | "" (not yours)
        var SN_ACTS = @Html.Raw(JsonSerializer.Serialize(events.GroupBy(e => e.MeetingId).ToDictionary(g => g.Key.ToString(), g => new { act = ActKind(g.First()), series = g.First().Repeat is not null, title = g.First().Title, by = g.First().HostName, agenda = g.First().Agenda ?? "", allDay = g.First().IsAllDay, manage = CanDel(g.First()) && !g.First().IsCancelled, sStart = g.First().SeriesStartLocal.ToString("yyyy-MM-dd'T'HH:mm", inv), sMin = g.First().SeriesMinutes })));
        function snDeleteOne(id, title) {
            SN.confirmPost("/meetings/" + id + "/delete", {
                title: "Delete meeting",
                text: "Delete “" + title + "” for everyone? It's removed from everyone's calendar and nobody is emailed. Only the person who set it up (or a workspace admin) can do this.",
                confirmText: "Delete meeting",
                danger: true,
                fields: { returnUrl: SN_HERE }
            });
        }
        function snHideOne(id, title) {
            SN.confirmPost("/meetings/" + id + "/hide", {
                title: "Remove from my calendar",
                text: "Remove the cancelled meeting “" + title + "” from your calendar? Only you stop seeing it; others keep it until they remove it.",
                confirmText: "Remove",
                fields: { returnUrl: SN_HERE }
            });
        }
        // cancel: a window with an optional reason and "email everyone"
        var snDayName = function (iso) { var p = iso.split("-"); return new Date(+p[0], +p[1] - 1, +p[2]).toLocaleDateString([], { weekday: "short", day: "numeric", month: "short" }); };
        function snCancelOne(id, title, series, occ) {
            var dlg = document.getElementById("cancelDialog");
            var form = document.getElementById("cancelForm");
            var withDate = !!(series && occ);
            form.action = "/meetings/" + id + "/cancel";
            form.dataset.id = id;
            document.getElementById("cancelReturn").value = SN_HERE;
            document.getElementById("cancelDate").value = occ || "";
            document.getElementById("cancelScope").hidden = !withDate;
            if (withDate) {
                document.getElementById("cancelDateLabel").textContent = "Only " + snDayName(occ);
                form.querySelector('input[name="cancelScope"][value="date"]').checked = true;
            }
            var paint = function () {
                var dateOnly = withDate && form.querySelector('input[name="cancelScope"]:checked').value === "date";
                form.action = "/meetings/" + id + (dateOnly ? "/occurrence/cancel" : "/cancel");
                document.getElementById("cancelT").textContent = dateOnly ? "Cancel one meeting" : series ? "Cancel the whole series" : "Cancel meeting";
                document.getElementById("cancelWhat").textContent = dateOnly
                    ? "Cancel “" + title + "” on " + snDayName(occ) + "? It's removed from everyone's calendar; the other dates stay."
                    : series ? "Cancel every meeting in the series “" + title + "”? Past and future meetings in it are all marked cancelled."
                    : "Cancel “" + title + "”?";
                document.getElementById("cancelSubmit").lastElementChild.textContent = dateOnly ? "Cancel this date" : series ? "Cancel series" : "Cancel meeting";
            };
            form.querySelectorAll('input[name="cancelScope"]').forEach(function (r) { r.onchange = paint; });
            paint();
            document.getElementById("cancelNote").value = "";
            document.getElementById("cancelMail").checked = true;
            dlg.showModal();
            setTimeout(function () { document.getElementById("cancelNote").focus(); }, 60);
        }
        function snMeetingAct(act, id, title, series, occ) {
            if (act === "cancel") snCancelOne(id, title, series, occ);
            else if (act === "hide") snHideOne(id, title);
            else if (act === "delete") snDeleteOne(id, title);
        }
        function snCancelMeeting() {
            var row = SN.need("MeetingsTable", "a meeting (click it in the calendar)");
            if (!row) return;
            var a = SN_ACTS[row.MeetingId] || {};
            if (!a.act) { Sahyog.toast("Only " + (a.by || "the person who set it up") + " (or a workspace admin) can cancel this meeting. Once it's cancelled you can remove it from your calendar.", { kind: "info", title: "Not your meeting" }); return; }
            var sel = document.querySelector('#viewSchedule .selected[data-id="' + row.MeetingId + '"]');
            snMeetingAct(a.act, row.MeetingId, row.Title, a.series, sel ? sel.dataset.occ : null);
        }

        // ---- edit: the whole meeting (series), or only the selected date of a repeating meeting ----
        var snPad = function (n) { return String(n).padStart(2, "0"); };
        var snDur = function (x) { return x < 60 ? x + " min" : Math.floor(x / 60) + " h" + (x % 60 ? " " + (x % 60) + " min" : ""); };
        function snEditOne(el) {
            var id = el.getAttribute("data-id");
            var a = SN_ACTS[id] || {};
            if (!a.manage) { Sahyog.toast("Only " + (a.by || "the person who set it up") + " (or a workspace admin) can change this meeting.", { kind: "info", title: "Not your meeting" }); return; }
            if (!el.getAttribute("data-movable")) { Sahyog.toast("This meeting has ended, so it can't be changed.", { kind: "info", title: "Edit meeting" }); return; }
            var form = document.getElementById("editForm");
            form.action = "/meetings/" + id + "/edit";
            document.getElementById("editReturn").value = SN_HERE;
            document.getElementById("editOcc").value = el.dataset.occ || "";
            document.getElementById("editTitle").value = a.title || "";
            document.getElementById("editAgenda").value = a.agenda || "";
            document.getElementById("editNote").value = "";
            document.getElementById("editMail").checked = true;
            // the scheduler's own controls: flatpickr date, and dropdowns (picking an option sets the hidden value)
            var pick = function (ddId, value) {
                var $o = $("#" + ddId + " .ddwl-option").filter(function () { return String($(this).data("value")) === String(value); });
                if (!$o.length) {
                    // a time / length that isn't in the list (e.g. 18:15 or 50 minutes): add it, then pick it
                    $("#" + ddId + " .ddwl-options").append('<li data-value="' + value + '" class="ddwl-option">' + (ddId === "editMin" ? snDur(+value) : value) + "</li>");
                    $o = $("#" + ddId + " .ddwl-option").filter(function () { return String($(this).data("value")) === String(value); });
                }
                $o.first().trigger("click");
                $("#" + ddId).removeClass("open");
            };
            var setWhen = function (iso, min) {
                var p = iso.split(/[-T:]/), day = new Date(+p[0], +p[1] - 1, +p[2]);
                var di = document.getElementById("editDay");
                if (di && di._flatpickr) di._flatpickr.setDate(day, true); else if (di) di.value = snPad(day.getDate()) + "-" + snPad(day.getMonth() + 1) + "-" + day.getFullYear();
                pick("editTime", iso.slice(11, 16));
                pick("editMin", String(min));
            };
            var series = !!a.series, allDay = !!a.allDay;
            var scope = document.getElementById("editScope");
            scope.hidden = !series;
            if (series) {
                document.getElementById("editDateLabel").textContent = "Only " + snDayName(el.dataset.occ);
                form.querySelector('input[name="scope"][value="date"]').checked = true;
            }
            form.querySelectorAll(".sn-edit-timebox").forEach(function (b) { b.hidden = allDay; });
            var paint = function () {
                var dateOnly = series && form.querySelector('input[name="scope"]:checked').value === "date";
                form.querySelector(".sn-edit-series").hidden = dateOnly;
                document.getElementById("editTitle").required = !dateOnly;
                document.getElementById("editT").textContent = dateOnly ? "Move one meeting" : series ? "Edit the whole series" : "Edit meeting";
                var dl = document.querySelector('label[for="editDay"]');
                if (dl) dl.firstChild.nodeValue = dateOnly || !series ? "Date" : "First date of the series";
                document.getElementById("editWarn").hidden = dateOnly || !series;
                if (dateOnly) setWhen(el.dataset.start, +el.dataset.min); else if (series) setWhen(a.sStart, a.sMin); else setWhen(el.dataset.start, +el.dataset.min);
            };
            form.querySelectorAll('input[name="scope"]').forEach(function (r) { r.onchange = paint; });
            paint();
            document.getElementById("editDialog").showModal();
            setTimeout(function () { (series ? form.querySelector('input[name="scope"]:checked') : document.getElementById("editTitle")).focus(); }, 60);
        }
        // the Edit / Cancel buttons in a meeting's details window
        window.snMeetingFromDetails = function (act, id, occ, series) {
            var el = document.querySelector('#viewSchedule [data-id="' + id + '"][data-occ="' + occ + '"]') || document.querySelector('#viewSchedule [data-id="' + id + '"][data-occ]');
            var a = SN_ACTS[id] || {};
            if (act === "edit") {
                if (el) snEditOne(el); else Sahyog.toast("Open the meeting's week or day to edit it.", { kind: "info", title: "Edit meeting" });
            } else if (act === "cancel") {
                snMeetingAct(a.act || "cancel", id, a.title || "this meeting", series, occ);
            }
        };
        function snEditMeeting() {
            var row = SN.need("MeetingsTable", "a meeting (click it in the calendar)");
            if (!row) return;
            var el = document.querySelector('#viewSchedule .selected[data-id="' + row.MeetingId + '"]') || document.querySelector('#viewSchedule [data-id="' + row.MeetingId + '"][data-occ]');
            if (!el) { Sahyog.toast("Open the meeting in Day, Week, Month or Agenda view to edit it.", { kind: "info", title: "Edit meeting" }); return; }
            snEditOne(el);
        }

        // ---- drag and drop: confirm, then move (a repeating meeting: only that date) ----
        function snAskMove(el, newStartIso) {
            var id = el.getAttribute("data-id"), a = SN_ACTS[id] || {};
            var allDay = el.dataset.allday === "1";
            if (newStartIso === el.dataset.start || (allDay && newStartIso.slice(0, 10) === el.dataset.start.slice(0, 10))) return;
            var p = newStartIso.split(/[-T:]/), when = new Date(+p[0], +p[1] - 1, +p[2], +p[3] || 0, +p[4] || 0);
            if ((allDay ? new Date(+p[0], +p[1] - 1, +p[2] + 1) : when) < new Date(Date.now() - 60000)) {
                Sahyog.toast("That time has already passed. Drop it on a time from now on.", { kind: "warn", title: "Can't move there" }); return;
            }
            var fmt = function (iso) {
                var q = iso.split(/[-T:]/), d = new Date(+q[0], +q[1] - 1, +q[2], +q[3] || 0, +q[4] || 0);
                return d.toLocaleDateString([], { weekday: "short", day: "numeric", month: "short" }) + (allDay ? " · all day" : ", " + snPad(d.getHours()) + ":" + snPad(d.getMinutes()));
            };
            document.getElementById("moveWhat").textContent = "Move “" + (a.title || "this meeting") + "”" + (a.series ? " (only this date; the rest of the series stays)" : "") + "?";
            document.getElementById("moveFrom").textContent = fmt(el.dataset.start);
            document.getElementById("moveTo").textContent = fmt(newStartIso);
            document.getElementById("moveMail").checked = true;
            var dlg = document.getElementById("moveDialog"), go = document.getElementById("moveGo");
            go.disabled = false; go.lastElementChild.textContent = "Move";
            go.onclick = async function () {
                go.disabled = true; go.lastElementChild.textContent = "Moving…";
                var fd = new FormData();
                fd.append("date", el.dataset.occ || ""); fd.append("start", newStartIso); fd.append("minutes", el.dataset.min || "");
                fd.append("sendEmail", document.getElementById("moveMail").checked ? "true" : "false");
                try {
                    var r = await fetch("/meetings/" + id + "/move", { method: "POST", body: fd, headers: { "RequestVerificationToken": Sahyog.antiforgery ? Sahyog.antiforgery() : "" }, credentials: "same-origin" });
                    var d = await r.json().catch(function () { return {}; });
                    if (!r.ok) throw new Error(d.error || "The meeting wasn't moved. Try again.");
                    dlg.close();
                    if (window.SN && SN.nav) SN.nav.refresh(); else location.reload();
                } catch (err) {
                    go.disabled = false; go.lastElementChild.textContent = "Move";
                    Sahyog.toast(err.message, { kind: "warn", title: "Not moved" });
                }
            };
            dlg.showModal();
        }
        // every ended meeting in this period that you may delete
        var SN_ENDED = @Html.Raw(JsonSerializer.Serialize(events.Where(e => Status(e) == "Ended" && CanDel(e)).Select(e => e.MeetingId).Distinct()));
        function snDeleteEnded() {
            if (!SN_ENDED.length) { Sahyog.toast("There are no ended meetings you set up in this period.", { kind: "info", title: "Nothing to delete" }); return; }
            SN.confirmPost("/meetings/delete-many", {
                title: "Delete ended meetings",
                text: "Delete " + (SN_ENDED.length === 1 ? "the 1 ended meeting" : "all " + SN_ENDED.length + " ended meetings") + " you set up in this period? Upcoming and live meetings stay.",
                confirmText: "Delete " + SN_ENDED.length,
                danger: true,
                fields: { ids: SN_ENDED.join(","), returnUrl: SN_HERE }
            });
        }
        // the 🗑 on a meeting in the calendar
        // (caught first, so the click doesn't also select the meeting or open "Schedule")
        ["click", "keydown"].forEach(function (type) {
            document.addEventListener(type, function (e) {
                var pen = e.target.closest && e.target.closest(".sn-ev-edit");
                if (pen) {
                    if (type === "keydown" && e.key !== "Enter" && e.key !== " ") return;
                    e.preventDefault(); e.stopPropagation();
                    snEditOne(pen.closest("[data-id]"));
                    return;
                }
                var b = e.target.closest && e.target.closest(".sn-ev-del");
                if (!b) return;
                if (type === "keydown" && e.key !== "Enter" && e.key !== " ") return;
                e.preventDefault(); e.stopPropagation();
                var host = b.closest("[data-occ]");
                snMeetingAct(b.getAttribute("data-act") || "delete", b.getAttribute("data-del"), b.getAttribute("data-title"), b.getAttribute("data-series") === "1", host ? host.dataset.occ : null);
            }, true);
        });
        document.addEventListener("pointerdown", function (e) { if (e.target.closest && e.target.closest(".sn-ev-del, .sn-ev-edit")) e.stopPropagation(); }, true);
        document.addEventListener("dblclick", function (e) { if (e.target.closest && e.target.closest(".sn-ev-del, .sn-ev-edit")) { e.preventDefault(); e.stopPropagation(); } }, true);
        // ---- moving between periods and views: the content leaves, the page slides, the calendar rises in ----
        function snNav(url, dir, evt) {
            if (evt) evt.preventDefault();
            document.documentElement.classList.add("sn-leaving");
            if (dir) document.documentElement.classList.add("sn-leaving-" + dir);
            SN.goSmooth(url, dir, 90);
            return false;
        }
        // ---- jump to any month: click the period label, pick year + month ----
        (function () {
            var root = document.getElementById("jumpPicker");
            if (!root) return;
            var btn = document.getElementById("jumpBtn"), pop = document.getElementById("jumpPop");
            var yearEl = document.getElementById("jumpYear");
            var curY = +root.dataset.year, curM = +root.dataset.month;
            var today = root.dataset.today.split("-").map(Number);       // [y, m, d]
            var shownY = curY;
            function paint() {
                yearEl.textContent = shownY;
                pop.querySelectorAll("[data-month]").forEach(function (b) {
                    var m = +b.dataset.month;
                    b.classList.toggle("is-current", shownY === curY && m === curM);
                    b.classList.toggle("is-today", shownY === today[0] && m === today[1]);
                });
            }
            function open(on) {
                pop.hidden = !on;
                btn.setAttribute("aria-expanded", on ? "true" : "false");
                root.classList.toggle("open", on);
                if (on) { shownY = curY; paint(); var c = pop.querySelector(".is-current"); if (c) c.focus(); }
            }
            function go(y, m) {
                open(false);
                if (root.dataset.view === "month" && y === curY && m === curM) return;
                document.cookie = "sn-mview=month; path=/; max-age=31536000; samesite=lax";
                var dir = y * 12 + m < curY * 12 + curM ? "prev" : "next";
                snNav("/meetings?view=month&date=" + y + "-" + String(m).padStart(2, "0") + "-01", dir);
            }
            btn.addEventListener("click", function (e) { e.stopPropagation(); open(pop.hidden); });
            pop.addEventListener("click", function (e) {
                e.stopPropagation();
                var step = e.target.closest("[data-year-step]");
                if (step) { shownY += +step.dataset.yearStep; paint(); return; }
                var mb = e.target.closest("[data-month]");
                if (mb) { go(shownY, +mb.dataset.month); return; }
                if (e.target.closest("[data-jump-today]")) go(today[0], today[1]);
            });
            document.addEventListener("click", function () { if (!pop.hidden) open(false); });
            document.addEventListener("keydown", function (e) {
                if (pop.hidden) return;
                if (e.key === "Escape") { open(false); btn.focus(); }
                else if (e.key === "PageUp") { e.preventDefault(); shownY--; paint(); }
                else if (e.key === "PageDown") { e.preventDefault(); shownY++; paint(); }
            });
        })();

        $("#viewTabs").on("tabcontrol:select", function (e, id) {
            if (id === "@view") return;
            document.cookie = "sn-mview=" + id + "; path=/; max-age=31536000; samesite=lax";
            // the pill glides first, then the page changes
            SN.goSmooth("/meetings?view=" + id + "&date=@anchor.ToString("yyyy-MM-dd", inv)", "", 280);
            document.documentElement.classList.add("sn-leaving");
        });

        (function () {
            var NOW = new Date(@now.Year, @(now.Month - 1), @now.Day, @now.Hour, @now.Minute);
            var $cal = $("#viewSchedule");
            var READY_AT = Date.now() + 700;          // no "add" window while the page is still arriving
            var down = null;                           // where the press started
            $cal.on("pointerdown", function (e) { down = { x: e.clientX, y: e.clientY, target: e.target, t: Date.now() }; });
            function realClick(e) {
                if (Date.now() < READY_AT) return false;
                if (document.documentElement.classList.contains("sn-leaving")) return false;
                if (!down || !e.originalEvent || !e.originalEvent.isTrusted) return false;
                var moved = Math.abs(e.clientX - down.x) + Math.abs(e.clientY - down.y);
                var ok = moved < 8 && Date.now() - down.t < 800 && down.target === e.target;
                down = null;
                return ok;
            }

            // ---- one selection shared by the calendar and the grid ----
            function mark(id) { $cal.find(".sn-ev, .sn-mev, .sn-ad, .sn-ag-ev").removeClass("selected").filter("[data-id='" + id + "']").addClass("selected"); }
            $cal.on("click", ".sn-ev, .sn-mev, .sn-ad, .sn-ag-ev", function (e) {
                e.stopPropagation();
                var id = $(this).data("id");
                $("#MeetingsTable tr[data-row-id='" + id + "']").trigger("click");
                mark(id);
                // a click opens the meeting's details (who's coming, answers, Join / Start); joining is only by its Join button
                if (window.snShowDetails) snShowDetails(String(id), this.dataset.occ || "");
            });
            $cal.on("dblclick", ".sn-ev, .sn-mev, .sn-ad, .sn-ag-ev", function (e) { e.stopPropagation(); });
            // agenda: "Schedule one" on an empty day
            $cal.on("click", "[data-ag-add]", function (e) { e.stopPropagation(); openDay(this.closest(".sn-ag-day")); });
            $("#MeetingsTable").on("table:select", function (e, row) { mark(row.MeetingId); });

            // ---- click an empty slot or day: the Schedule window opens with that date and time ----
            function pad(n) { return String(n).padStart(2, "0"); }
            function parseDmy(dmy) { var p = dmy.split("-"); return new Date(+p[2], +p[1] - 1, +p[0]); }
            function nextHalfHour() { var m = NOW.getHours() * 60 + NOW.getMinutes(); m = Math.ceil((m + 1) / 30) * 30; return m >= 24 * 60 ? null : pad(Math.floor(m / 60)) + ":" + pad(m % 60); }
            window.snOpenSchedule = function (dmy, time, allDay, exactSlot) {
                var day = parseDmy(dmy);
                var when = new Date(day); var t = (time || "10:00").split(":"); when.setHours(+t[0], +t[1]);
                var slotStart = new Date(when);
                if (allDay) when.setHours(23, 59);
                if (when < new Date(NOW.getTime() - 5 * 60000)) {
                    Sahyog.toast("Pick a time from now on to schedule a meeting.", { kind: "info", title: "That time has passed" });
                    return;
                }
                // out of office: the whole day is blocked; on the day / week grid, so are the hours away (e.g. 4:00 pm – 5:00 pm)
                var me = document.body.dataset.me, S = window.Sahyog;
                var away = me && S && S.oooOn ? S.oooOn(me, day) : null;
                if (away) {
                    var hours = window.SN && SN.oooHoursOn ? SN.oooHoursOn(away, day) : "";
                    var hit = !hours || (exactSlot && S.oooDuring && S.oooDuring(me, slotStart, new Date(slotStart.getTime() + 30 * 60000)));
                    if (hit) {
                        S.toast((hours ? "You're out of office " + hours + " that day." : "You're out of office all day on " + day.toLocaleDateString([], { weekday: "short", day: "numeric", month: "short" }) + ".")
                            + " Change or turn off out of office to schedule a meeting then.", { kind: "warn", title: "Out of office" });
                        return;
                    }
                }
                var input = document.getElementById("mDate");
                if (input && input._flatpickr) input._flatpickr.setDate(day, true); else if (input) input.value = dmy;
                var $opt = $("#mTime .ddwl-option").filter(function () { return String($(this).data("value")) === time; });
                if ($opt.length) $opt.first().trigger("click");
                $("#mTime").removeClass("open");
                if (window.snSetAllDay) snSetAllDay(!!allDay);
                SN.open("scheduleDialog");
                setTimeout(function () { $("#mTitle").trigger("focus"); }, 350);
            };

            // time grid (day / week)
            var scroller = document.getElementById("schedScroll");
            if (scroller) {
                var startH = @startH;
                var hr = function () { return parseFloat(getComputedStyle(scroller).getPropertyValue("--hr")) || 56; };
                function slotAt(col, clientY) {
                    var y = clientY - col.getBoundingClientRect().top;
                    var halfHours = Math.max(0, Math.floor(y / (hr() / 2)));
                    var mins = startH * 60 + halfHours * 30;
                    if (mins >= 24 * 60) mins = 24 * 60 - 30;
                    return { top: halfHours * hr() / 2, time: pad(Math.floor(mins / 60)) + ":" + pad(mins % 60) };
                }
                $cal.on("mousemove", ".sn-sched-col", function (e) {
                    var hint = this.querySelector(".sn-slot-hint");
                    if (!hint) return;
                    if ($(e.target).closest(".sn-ev").length) { hint.classList.remove("on"); return; }
                    var s = slotAt(this, e.clientY);
                    hint.style.top = s.top + "px";
                    hint.querySelector("span").textContent = s.time;
                    hint.classList.add("on");
                });
                $cal.on("mouseleave", ".sn-sched-col", function () { var h = this.querySelector(".sn-slot-hint"); if (h) h.classList.remove("on"); });
                $cal.on("click", ".sn-sched-col", function (e) {
                    if ($(e.target).closest(".sn-ev").length || !realClick(e)) return;
                    snOpenSchedule(this.dataset.date, slotAt(this, e.clientY).time, false, true);
                });

                // drag a meeting to another time (or day column); a ghost shows where it will land
                var ghost = null, dragEl = null;
                var hideGhost = function () { if (ghost) { ghost.remove(); ghost = null; } };
                $cal.on("dragstart", ".sn-ev[data-movable]", function (e) {
                    dragEl = this;
                    var dt = e.originalEvent.dataTransfer;
                    dt.effectAllowed = "move";
                    try { dt.setData("text/plain", this.dataset.id); } catch (x) { }
                    this.classList.add("sn-dragging");
                });
                $cal.on("dragend", ".sn-ev[data-movable]", function () { this.classList.remove("sn-dragging"); hideGhost(); dragEl = null; });
                $cal.on("dragover", ".sn-sched-col", function (e) {
                    if (!dragEl || !dragEl.classList.contains("sn-ev")) return;
                    e.preventDefault();
                    e.originalEvent.dataTransfer.dropEffect = "move";
                    var s = slotAt(this, e.originalEvent.clientY);
                    if (!ghost) { ghost = document.createElement("div"); ghost.className = "sn-drop-ghost"; }
                    if (ghost.parentNode !== this) this.appendChild(ghost);
                    ghost.style.top = s.top + "px";
                    ghost.style.height = Math.max(18, (+dragEl.dataset.min / 60) * hr() - 2) + "px";
                    ghost.textContent = s.time + " · " + (SN_ACTS[dragEl.dataset.id] || {}).title;
                });
                $cal.on("dragleave", ".sn-sched-col", function (e) { if (!this.contains(e.originalEvent.relatedTarget)) hideGhost(); });
                $cal.on("drop", ".sn-sched-col", function (e) {
                    if (!dragEl || !dragEl.classList.contains("sn-ev")) return;
                    e.preventDefault();
                    var s = slotAt(this, e.originalEvent.clientY), p = this.dataset.date.split("-");
                    var el = dragEl;
                    hideGhost();
                    snAskMove(el, p[2] + "-" + p[1] + "-" + p[0] + "T" + s.time);
                });

                // open at the current time, the first meeting, or 08:00
                var first = $cal.find(".sn-now")[0] || $cal.find(".sn-ev")[0];
                scroller.style.scrollBehavior = "auto";
                scroller.scrollTop = Math.max(0, first ? first.offsetTop - hr() * 1.5 : (8 - startH) * hr());
                scroller.style.scrollBehavior = "";
            }

            // all-day row: click an empty spot to add an all-day event
            $cal.on("click", ".sn-allday-cell", function (e) {
                if ($(e.target).closest(".sn-ad").length || !realClick(e)) return;
                snOpenSchedule(this.dataset.date, "10:00", true);
            });

            // month
            function openDay(cell) {
                var dmy = cell.dataset.date;
                var isToday = parseDmy(dmy).toDateString() === NOW.toDateString();
                snOpenSchedule(dmy, isToday ? (nextHalfHour() || "23:30") : "10:00");
            }
            $cal.on("click", ".sn-mcell", function (e) {
                if ($(e.target).closest(".sn-mev, .sn-mday, .sn-mmore").length || !realClick(e)) return;
                openDay(this);
            });
            $cal.on("keydown", ".sn-mcell", function (e) {
                if (e.target === this && (e.key === "Enter" || e.key === " ")) { e.preventDefault(); openDay(this); }
            });

            // drag a meeting to another day (month view, and the all-day row of week / day): it keeps its time
            var dayDrag = null;
            $cal.on("dragstart", ".sn-mev[data-movable], .sn-ad[data-movable]", function (e) {
                dayDrag = this;
                e.originalEvent.dataTransfer.effectAllowed = "move";
                try { e.originalEvent.dataTransfer.setData("text/plain", this.dataset.id); } catch (x) { }
                this.classList.add("sn-dragging");
            });
            $cal.on("dragend", ".sn-mev[data-movable], .sn-ad[data-movable]", function () {
                this.classList.remove("sn-dragging"); dayDrag = null;
                $cal.find(".sn-drop-day").removeClass("sn-drop-day");
            });
            $cal.on("dragover", ".sn-mcell, .sn-allday-cell", function (e) {
                if (!dayDrag) return;
                e.preventDefault();
                e.originalEvent.dataTransfer.dropEffect = "move";
                if (!this.classList.contains("sn-drop-day")) { $cal.find(".sn-drop-day").removeClass("sn-drop-day"); this.classList.add("sn-drop-day"); }
            });
            $cal.on("dragleave", ".sn-mcell, .sn-allday-cell", function (e) { if (!this.contains(e.originalEvent.relatedTarget)) this.classList.remove("sn-drop-day"); });
            $cal.on("drop", ".sn-mcell, .sn-allday-cell", function (e) {
                if (!dayDrag) return;
                e.preventDefault();
                this.classList.remove("sn-drop-day");
                var p = this.dataset.date.split("-"), el = dayDrag;
                snAskMove(el, p[2] + "-" + p[1] + "-" + p[0] + "T" + el.dataset.start.slice(11, 16));
            });
        })();
    </script>
    <script src="~/js/meetings.js" asp-append-version="true"></script>
    <script src="~/js/meeting-details.js" asp-append-version="true"></script>
    <script>
        // ---- the red "now" line moves by itself; the page refreshes quietly so Live / Upcoming / Ended stay right ----
        (function () {
            var line = document.querySelector(".sn-now");
            var t0 = Date.now(), loadedAt = Date.now();
            var top0 = line ? parseFloat(line.getAttribute("data-top")) : NaN;
            var max = line ? parseFloat(line.getAttribute("data-max")) : NaN;
            function moveLine() {
                if (!line || isNaN(top0)) return;
                var h = top0 + (Date.now() - t0) / 3600000;
                if (h > max) { line.hidden = true; var l = document.querySelector(".sn-now-label"); if (l) l.hidden = true; return; }
                line.style.top = "calc(var(--hr) * " + h.toFixed(4) + ")";
                var label = document.querySelector(".sn-now-label"), d = new Date();
                if (label) { label.style.top = line.style.top; label.textContent = String(d.getHours()).padStart(2, "0") + ":" + String(d.getMinutes()).padStart(2, "0"); }
            }
            setInterval(moveLine, 30000);
            // a quiet refresh: only when the page is on screen and you're not in the middle of something
            function busy() {
                return !!document.querySelector("dialog[open], .sn-dialog[open], .mb-overlay.show")
                    || (document.activeElement && /INPUT|TEXTAREA|SELECT/.test(document.activeElement.tagName));
            }
            function refresh() { if (!document.hidden && !busy()) { if (window.SN && SN.nav) SN.nav.refresh(); else location.reload(); } }
            setInterval(function () { if (Date.now() - loadedAt > 5 * 60 * 1000) refresh(); }, 60 * 1000);
            // a new day starts: show it
            var now = new Date(), midnight = new Date(now.getFullYear(), now.getMonth(), now.getDate() + 1, 0, 0, 5);
            setTimeout(refresh, midnight - now);
            // coming back to the tab after a while
            document.addEventListener("visibilitychange", function () { if (!document.hidden && Date.now() - loadedAt > 5 * 60 * 1000) refresh(); });
        })();
</script>
}
