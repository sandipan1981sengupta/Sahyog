@model MeetingsViewModel
@using System.Globalization
@using System.Text.Json
@{
    ViewData["Title"] = "Meetings";
    ViewData["Section"] = "meetings";
    var f = Model.Form;
    var weekEnd = Model.WeekStart.AddDays(6);
    var now = Model.NowLocal;
    var thisWeek = MeetingCalendar.WeekOf(DateOnly.FromDateTime(now));
    var weekKey = Model.WeekStart == thisWeek ? "this" : Model.WeekStart < thisWeek ? "prev" : "next";
    var inv = CultureInfo.InvariantCulture;

    string Status(CalendarEventVm e) => e.IsCancelled ? "Cancelled" : e.EndLocal <= now ? "Ended" : e.StartLocal <= now ? "Live" : "Upcoming";
    var isAdmin = User.IsInRole(AppRoles.TenantAdmin);
    bool CanDel(CalendarEventVm e) => e.IsHost || isAdmin;
    string By(CalendarEventVm e) => e.IsHost ? "you" : e.HostName;
    // what the 🗑 on a meeting does: a cancelled one is removed from my calendar (anyone);
    // the host / an admin cancels an upcoming meeting or a series (everyone is emailed) and deletes a single ended one
    string ActKind(CalendarEventVm e) => e.IsCancelled ? "hide" : !CanDel(e) ? "" : e.Repeat is null && e.EndLocal <= now ? "delete" : "cancel";
    string ActTip(string k, CalendarEventVm e) => k switch { "hide" => "Remove from my calendar", "delete" => "Delete meeting", _ => e.Repeat is null ? "Cancel meeting" : "Cancel the whole series" };
    // hover text: when, who set it up, and whether it's cancelled
    string EvTip(CalendarEventVm e) => $"{e.Title} · {(e.IsAllDay ? "all day" : e.StartLocal.ToString("HH:mm", inv) + "–" + e.EndLocal.ToString("HH:mm", inv))} · set up by {By(e)}"
        + (e.Repeat is null ? "" : $" · {e.Repeat}")
        + (e.IsMoved ? " · moved (only this date)" : "")
        + (e.IsCancelled || e.Accepted + e.Maybe + e.Declined + e.Waiting == 0 ? "" : $"\n✓ {e.Accepted} accepted · ? {e.Maybe} maybe · ✕ {e.Declined} declined · {e.Waiting} no response")
        + string.Concat(e.Answers.Select(x => $"\n{(x.Response == MeetingResponse.Declined ? "✕" : "?")} {x.Name}{(string.IsNullOrWhiteSpace(x.Note) ? "" : ": " + x.Note)}"))
        + (e.MyResponse == MeetingResponse.Declined ? "\nYou declined" : e.MyResponse == MeetingResponse.Maybe ? "\nYou said maybe" : "")
        + (CanMove(e) ? " · drag to move" : "")
        + (e.IsCancelled ? $" · CANCELLED{(e.CancelledBy is null ? "" : " by " + e.CancelledBy)}{(string.IsNullOrWhiteSpace(e.CancelNote) ? "" : ": " + e.CancelNote)}" : $" · {Status(e)}");
    const string TrashSvg = "<svg viewBox='0 0 24 24' width='14' height='14' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'><path d='M4 7h16' /><path d='M10 11v6M14 11v6' /><path d='M6 7l1 12a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2l1-12' /><path d='M9 7V4.5A1.5 1.5 0 0 1 10.5 3h3A1.5 1.5 0 0 1 15 4.5V7' /></svg>";
    const string BanSvg = "<svg viewBox='0 0 24 24' width='14' height='14' fill='none' stroke='currentColor' stroke-width='2.2' stroke-linecap='round' aria-hidden='true'><circle cx='12' cy='12' r='8.5' /><path d='M6 6l12 12' /></svg>";
    // the host / an admin can move (drag and drop) and edit a meeting that hasn't ended and isn't cancelled
    bool CanMove(CalendarEventVm e) => CanDel(e) && !e.IsCancelled && e.EndLocal > now;
    const string PenSvg = "<svg viewBox='0 0 24 24' width='13' height='13' fill='none' stroke='currentColor' stroke-width='2.2' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'><path d='M4 20h4L19 9l-4-4L4 16z' /><path d='M14 6l4 4' /></svg>";
    Microsoft.AspNetCore.Html.IHtmlContent ActBtn(CalendarEventVm e)
    {
        var k = ActKind(e);
        var t = System.Net.WebUtility.HtmlEncode(e.Title);
        var edit = CanMove(e) ? $"<span class='sn-ev-edit' role='button' tabindex='0' data-edit='{e.MeetingId}' data-tip='Edit' aria-label='Edit {t}'>{PenSvg}</span>" : "";
        if (k.Length == 0) return new Microsoft.AspNetCore.Html.HtmlString(edit);
        var tip = k == "cancel" && e.Repeat is not null ? "Cancel this date or the series" : ActTip(k, e);
        return new Microsoft.AspNetCore.Html.HtmlString(edit + $"<span class='sn-ev-del act-{k}' role='button' tabindex='0' data-act='{k}' data-del='{e.MeetingId}' data-title='{t}' data-series='{(e.Repeat is null ? "" : "1")}' data-tip='{tip}' aria-label='{tip}: {t}'>{(k == "cancel" ? BanSvg : TrashSvg)}</span>");
    }
    // what a meeting on the calendar carries for edit / move / cancel-this-date (and drag and drop when it can move)
    // ✕ 1  ? 2 on a meeting: people who declined / said maybe for that date (hover for their reasons)
    Microsoft.AspNetCore.Html.IHtmlContent AnsBadges(CalendarEventVm e) => e.IsCancelled || (e.Declined + e.Maybe == 0)
        ? Microsoft.AspNetCore.Html.HtmlString.Empty
        : new Microsoft.AspNetCore.Html.HtmlString((e.Declined > 0 ? $"<span class='sn-ans no' aria-label='{e.Declined} declined'>✕{e.Declined}</span>" : "")
            + (e.Maybe > 0 ? $"<span class='sn-ans maybe' aria-label='{e.Maybe} maybe'>?{e.Maybe}</span>" : ""));
    string MineCls(CalendarEventVm e) => e.MyResponse == MeetingResponse.Declined ? "i-declined" : e.MyResponse == MeetingResponse.Maybe ? "i-maybe" : "";
    Microsoft.AspNetCore.Html.IHtmlContent EvData(CalendarEventVm e) => new Microsoft.AspNetCore.Html.HtmlString(
        $"data-occ='{e.OccurrenceDate.ToString("yyyy-MM-dd", inv)}' data-start='{e.StartLocal.ToString("yyyy-MM-dd'T'HH:mm", inv)}' data-min='{(int)(e.EndLocal - e.StartLocal).TotalMinutes}'"
        + $" data-series='{(e.Repeat is null ? "" : "1")}' data-allday='{(e.IsAllDay ? "1" : "")}'"
        + (CanMove(e) ? " draggable='true' data-movable='1'" : ""));
    bool Weekend(DayOfWeek d) => d == DayOfWeek.Saturday || d == DayOfWeek.Sunday;
    var periodWord = Model.View switch { "day" => "Today", "month" => "This month", "agenda" => "These 7 days", "list" => "This week", _ => "This week" };
    string DurText(int m) => m < 60 ? $"{m} min" : m % 60 == 0 ? $"{m / 60} hr" : $"{m / 60} hr {m % 60} min";

    // Rows for <modern-table>: one row per meeting this week.
    var events = Model.Days.SelectMany(d => d.Events).OrderBy(e => e.StartLocal).ToList();
    var rows = events.Select(e => new Dictionary<string, object>
    {
        ["MeetingId"] = e.MeetingId.ToString(),
        ["Title"] = e.Title,
        ["Day"] = e.StartLocal.ToString("ddd dd MMM", inv),
        ["Time"] = e.IsAllDay ? "All day" : $"{e.StartLocal.ToString("HH:mm", inv)} – {e.EndLocal.ToString("HH:mm", inv)}",
        ["Duration"] = e.IsAllDay ? (e.ShowAsFree ? "All day · free" : "All day · busy") : DurText((int)(e.EndLocal - e.StartLocal).TotalMinutes),
        ["Host"] = e.IsHost ? "You" : e.HostName,
        ["People"] = e.People.Count,
        ["Role"] = e.IsHost ? "Host" : "Invited",
        ["Repeat"] = e.Repeat ?? "Once",
        ["Status"] = Status(e)
    }).ToList();

    var live = events.Count(e => Status(e) == "Live");
    var upcomingCount = events.Count(e => Status(e) == "Upcoming");
    var endedCount = events.Count(e => Status(e) == "Ended");
    var upcoming = events.Count(e => Status(e) == "Upcoming");
    var ended = events.Count(e => Status(e) == "Ended");

    var durations = new[] { 15, 30, 45, 60, 90, 120, 180, 240, 300, 360, 480, 600, 720 }.Where(d => d <= Model.Limits.MaxMeetingMinutes).ToList();
    if (durations.Count == 0) durations.Add(Model.Limits.MaxMeetingMinutes);
    var durationItems = durations.Select(d => (d.ToString(inv), DurText(d))).ToList();
    var timeItems = Enumerable.Range(0, 48).Select(i => new TimeOnly(i / 2, (i % 2) * 30))
        .Select(t => (t.ToString("HH:mm", inv), t.ToString("HH:mm", inv))).ToList();
    var formTime = new TimeOnly(f.Time.Hour, f.Time.Minute >= 30 ? 30 : 0).ToString("HH:mm", inv);

    var busy = events.Where(e => !e.IsCancelled && !(e.IsAllDay && e.ShowAsFree)).Select(e => new
    {
        date = e.StartLocal.ToString("dd-MM-yyyy", inv),
        start = e.IsAllDay ? 0 : e.StartLocal.Hour + e.StartLocal.Minute / 60.0,
        end = e.IsAllDay || e.EndLocal.Date > e.StartLocal.Date ? 24 : e.EndLocal.Hour + e.EndLocal.Minute / 60.0,
        title = e.Title,
        allDay = e.IsAllDay
    });
    var hasFormErrors = !ViewData.ModelState.IsValid;

    // ---- day / week scheduler: the whole day, 00:00 to 24:00 ----
    // (the grid scrolls inside its card and opens at the current time, the first meeting, or 08:00)
    double HourOf(DateTime d) => d.Hour + d.Minute / 60.0;
    var startH = 0;
    var endH = 24;

    // side-by-side lanes for meetings that overlap on the same day
    (CalendarEventVm Ev, int Lane, int Lanes)[] LaneLayout(List<CalendarEventVm> dayEvents)
    {
        var sorted = dayEvents.OrderBy(e => e.StartLocal).ThenByDescending(e => e.EndLocal).ToList();
        var result = new List<(CalendarEventVm, int, int)>();
        var cluster = new List<(CalendarEventVm Ev, int Lane)>();
        var laneEnds = new List<DateTime>();
        DateTime clusterEnd = DateTime.MinValue;
        void Flush()
        {
            var n = Math.Max(1, laneEnds.Count);
            foreach (var c in cluster) result.Add((c.Ev, c.Lane, n));
            cluster.Clear(); laneEnds.Clear();
        }
        foreach (var e in sorted)
        {
            if (cluster.Count > 0 && e.StartLocal >= clusterEnd) Flush();
            var lane = laneEnds.FindIndex(end => end <= e.StartLocal);
            if (lane < 0) { laneEnds.Add(e.EndLocal); lane = laneEnds.Count - 1; } else laneEnds[lane] = e.EndLocal;
            cluster.Add((e, lane));
            clusterEnd = cluster.Count == 1 ? e.EndLocal : (e.EndLocal > clusterEnd ? e.EndLocal : clusterEnd);
        }
        Flush();
        return result.ToArray();
    }
    var nowTop = Model.NowHour >= startH && Model.NowHour <= endH ? Model.NowHour - startH : -1;

    // ---- period navigation: Day / Week / Month / List ----
    var view = Model.View;
    var anchor = Model.Anchor;
    var today = DateOnly.FromDateTime(now);
    var rangeEnd = Model.RangeStart.AddDays(Model.Days.Count - 1);
    var prevDate = view switch { "day" => anchor.AddDays(-1), "month" => anchor.AddMonths(-1), "agenda" => anchor.AddDays(-ShankhNaad.Web.Controllers.MeetingsController.AgendaDays), _ => anchor.AddDays(-7) };
    var nextDate = view switch { "day" => anchor.AddDays(1), "month" => anchor.AddMonths(1), "agenda" => anchor.AddDays(ShankhNaad.Web.Controllers.MeetingsController.AgendaDays), _ => anchor.AddDays(7) };
    string PUrl(string v, DateOnly d) => $"/meetings?view={v}&date={d.ToString("yyyy-MM-dd", inv)}";
    var rangeLabel = view switch
    {
        "day" => anchor.ToString("dddd, d MMMM yyyy", inv),
        "month" => anchor.ToString("MMMM yyyy", inv),
        "agenda" => Model.RangeStart.Month == rangeEnd.Month
            ? $"{Model.RangeStart.Day} – {rangeEnd.ToString("d MMMM yyyy", inv)}"
            : $"{Model.RangeStart.ToString("d MMM", inv)} – {rangeEnd.ToString("d MMM yyyy", inv)}",
        _ => Model.WeekStart.Month == weekEnd.Month
            ? $"{Model.WeekStart.Day} – {weekEnd.ToString("d MMMM yyyy", inv)}"
            : $"{Model.WeekStart.ToString("d MMM", inv)} – {weekEnd.ToString("d MMM yyyy", inv)}"
    };
    var isCurrent = view switch
    {
        "day" => anchor == today,
        "month" => anchor.Year == today.Year && anchor.Month == today.Month,
        "agenda" => anchor == today,
        _ => Model.WeekStart == thisWeek
    };
    var timeGrid = view is "day" or "week";
    var anyAllDay = Model.Days.Any(d => d.Events.Any(e => e.IsAllDay));
    var gridDays = timeGrid ? Model.Days : new List<CalendarDayVm>();
}

<main class="sn-page">
    <div class="sn-head glass">
        <action-header id="MeetingsHeader"
                       heading="Meetings"
                       subtitle="@($"{rangeLabel} · {Model.Limits.PlanName} plan · up to {Model.Limits.MaxMeetingParticipants} people · {Model.Limits.MaxMeetingMinutes} min")"
                       left-icon-css="bi bi-calendar-week-fill" left-icon-size="26"
                       left-icon-gradient-start="#2563EB" left-icon-gradient-mid="#7C3AED" left-icon-gradient-end="#DB2777"
                       background-color="transparent" box-shadow="none"
                       refresh-color="#1D4ED8" add-color="#1D4ED8" delete-color="#DC2626" export-color="#15803D" print-color="#334155"
                       show-refresh="true" refresh-on-click="SN.reload()"
                       show-add="true" add-text="Schedule" add-on-click="SN.open('scheduleDialog')"
                       show-edit="true" edit-text="Edit" edit-color="#7C3AED" edit-on-click="snEditMeeting()"
                       show-delete="true" delete-text="Delete" delete-on-click="snCancelMeeting()"
                       show-import="false"
                       show-export="true" export-on-click="SN.exportTable('MeetingsTable','meetings')"
                       show-save="false" show-submit="false"
                       show-print="true" print-on-click="SN.print()">
            <action-btn text="Join" icon-css="bi bi-box-arrow-in-right" icon-color="#16A34A" tooltip="Join the selected meeting" on-click="snJoinMeeting()"></action-btn>
            <action-btn text="Delete ended" icon-css="bi bi-calendar-x-fill" icon-color="#DC2626" tooltip="Delete every ended meeting you set up in this period" on-click="snDeleteEnded()"></action-btn>
            <action-btn text="Meet now" icon-css="bi bi-camera-video-fill" icon-color="#DB2777" tooltip="Start a meeting right now" on-click="document.getElementById('meetNowForm').submit()"></action-btn>
        </action-header>
        <form method="post" asp-antiforgery="true" action="/meetings/instant" id="meetNowForm" hidden></form>
    </div>

    <div class="sn-toolbar">
        <div class="sn-toolbar-left">
            <div class="sn-navgroup" role="group" aria-label="Change period">
                <button type="button" class="sn-nav-btn" onclick="snNav('@PUrl(view, prevDate)', 'prev')" aria-label="Previous" title="Previous"><i class="fa fa-chevron-left" aria-hidden="true"></i></button>
                <button type="button" class="sn-today-btn @(isCurrent ? "is-current" : "")" onclick="snNav('@PUrl(view, today)', '@(anchor > today ? "prev" : "next")')">Today</button>
                <button type="button" class="sn-nav-btn" onclick="snNav('@PUrl(view, nextDate)', 'next')" aria-label="Next" title="Next"><i class="fa fa-chevron-right" aria-hidden="true"></i></button>
            </div>
            @* click the period to jump to any month: pick a year, then a month *@
            <div class="sn-jump" id="jumpPicker" data-view="@view" data-year="@anchor.Year" data-month="@anchor.Month" data-today="@today.ToString("yyyy-MM-dd", inv)">
                <button type="button" class="sn-week-label sn-jump-btn" id="jumpBtn" aria-haspopup="dialog" aria-expanded="false" title="Go to a month">
                    <i class="bi bi-calendar3" aria-hidden="true"></i>
                    <span>@rangeLabel</span>
                    <i class="fa fa-caret-down sn-jump-caret" aria-hidden="true"></i>
                </button>
                <div class="sn-jump-pop glass-strong" id="jumpPop" role="dialog" aria-label="Go to a month" hidden>
                    <div class="sn-jump-head">
                        <button type="button" class="sn-nav-btn" data-year-step="-1" aria-label="Previous year"><i class="fa fa-chevron-left" aria-hidden="true"></i></button>
                        <strong id="jumpYear">@anchor.Year</strong>
                        <button type="button" class="sn-nav-btn" data-year-step="1" aria-label="Next year"><i class="fa fa-chevron-right" aria-hidden="true"></i></button>
                    </div>
                    <div class="sn-jump-months" id="jumpMonths">
                        @for (var mi = 1; mi <= 12; mi++)
                        {
                            <button type="button" data-month="@mi">@(new DateTime(2000, mi, 1).ToString("MMM", inv))</button>
                        }
                    </div>
                    <div class="sn-jump-foot">
                        <button type="button" class="sn-link" data-jump-today>This month</button>
                        <span class="muted small">Opens the month view</span>
                    </div>
                </div>
            </div>
            @if (live > 0)
            {
                <span class="sn-chip"><span class="sn-dot" style="background:#16a34a"></span>@live live now</span>
            }
        </div>
        <tab-control id="viewTabs" height="40px" font-size="13px" font-weight="600" active-font-weight="600" transition-duration=".32s"
                     background="rgba(255,255,255,.55)" active-background-color="#ffffff"
                     text-color="#475569" active-text-color="#0B1220" border-color="rgba(15,23,42,.08)">
            <tab id="day" text="Day" active="@(view == "day")"></tab>
            <tab id="week" text="Week" active="@(view == "week")"></tab>
            <tab id="month" text="Month" active="@(view == "month")"></tab>
            <tab id="agenda" text="Agenda" active="@(view == "agenda")"></tab>
            <tab id="list" text="List" active="@(view == "list")"></tab>
        </tab-control>
    </div>

    @if (TempData["MeetingMsg"] is string mmsg)
    {
        <div hidden data-toast="@mmsg" data-toast-kind="success"></div>
    }
    @if (TempData["MeetingError"] is string merr)
    {
        <div hidden data-toast="@merr" data-toast-kind="warn"></div>
    }
    @if (Model.JustScheduled is not null)
    {
        <div hidden data-toast="@($"{Model.JustScheduled.Title} is scheduled and the invites are on their way.")"
             data-toast-kind="success" data-toast-title="Meeting scheduled" data-toast-ms="9000"
             data-toast-copy="@(Model.JustScheduledGuestUrl ?? "")" data-toast-action-text="Copy guest link" data-toast-copied="Guest link copied"></div>
    }

    <div class="sn-row sn-meet-row" style="flex:1 1 auto">
        <div class="sn-grow sn-views" data-view="@view">
            @if (timeGrid)
            {
                @* ---------- Day / Week: time grid. Click an empty slot to schedule there. ---------- *@
                <section id="viewSchedule" class="sn-view sn-sched glass @(view == "day" ? "is-day" : "")" style="--h0:@startH;--hours:@(endH - startH);--cols:@gridDays.Count" aria-label="Schedule" data-start="@startH">
                    <div class="sn-sched-head">
                        <div class="sn-sched-corner"><i class="fa fa-clock-o" aria-hidden="true"></i></div>
                        @foreach (var d in gridDays)
                        {
                            <a class="sn-sched-dayhead @(d.IsToday ? "today" : "") @(Weekend(d.Date.DayOfWeek) ? "weekend" : "")" data-date="@d.Date.ToString("dd-MM-yyyy", inv)" href="@PUrl("day", d.Date)" onclick="return snNav(this.href, '', event)" title="Open this day">
                                <span>@d.Date.ToString(view == "day" ? "dddd" : "ddd", inv)</span><b>@d.Date.Day</b>
                                @if (d.Events.Count > 0) { <em>@d.Events.Count</em> }
                            </a>
                        }
                    </div>
                    @if (anyAllDay)
                    {
                        <div class="sn-allday">
                            <div class="sn-allday-label">All day</div>
                            @foreach (var d in gridDays)
                            {
                                <div class="sn-allday-cell" data-date="@d.Date.ToString("dd-MM-yyyy", inv)">
                                    @foreach (var ev in d.Events.Where(x => x.IsAllDay))
                                    {
                                        <button type="button" class="sn-ad tone-@ev.Tone @(ev.ShowAsFree ? "free" : "busy") st-@Status(ev).ToLowerInvariant() @(ev.IsCancelled ? "is-cancelled" : "")" @EvData(ev) data-id="@ev.MeetingId"
                                                title="@EvTip(ev) · @(ev.ShowAsFree ? "free" : "busy")">
                                            <i class="fa @(ev.IsCancelled ? "fa-calendar-times-o" : ev.ShowAsFree ? "fa-sun-o" : "fa-ban")" aria-hidden="true"></i> <span>@(ev.IsCancelled ? "Cancelled: " : "")@ev.Title</span>
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                    }
                    <div class="sn-sched-scroll" id="schedScroll">
                        <div class="sn-sched-grid">
                            <div class="sn-sched-times">
                                @for (var h = startH; h < endH; h++)
                                {
                                    <span>@($"{h:00}:00")</span>
                                }
                                @if (nowTop >= 0 && gridDays.Any(x => x.IsToday))
                                {
                                    @* the current time, next to the red line *@
                                    <b class="sn-now-label" style="top:calc(var(--hr) * @nowTop.ToString("0.###", inv))">@now.ToString("HH:mm", inv)</b>
                                }
                            </div>
                            @foreach (var d in gridDays)
                            {
                                <div class="sn-sched-col @(Weekend(d.Date.DayOfWeek) ? "weekend" : "") @(d.IsToday ? "today" : "") @(d.Date < today ? "past" : "") @(d.Events.Any(x => x.IsAllDay && !x.ShowAsFree) ? "busy-day" : "")" data-date="@d.Date.ToString("dd-MM-yyyy", inv)">
                                    @foreach (var (ev, lane, lanes) in LaneLayout(d.Events.Where(x => !x.IsAllDay).ToList()))
                                    {
                                        var st = Status(ev);
                                        var top = HourOf(ev.StartLocal) - startH;
                                        var endHr = ev.EndLocal.Date > ev.StartLocal.Date ? 24 : HourOf(ev.EndLocal);
                                        var len = Math.Max(.4, endHr - HourOf(ev.StartLocal));
                                        var w = 100.0 / lanes;
                                        <button type="button" class="sn-ev tone-@ev.Tone st-@st.ToLowerInvariant() @(len < .75 ? "short" : "") @(len < .5 ? "tiny" : "") @(ActKind(ev).Length > 0 ? "can-del" : "") @(ev.IsCancelled ? "is-cancelled" : "") @MineCls(ev)"
                                                @EvData(ev) data-id="@ev.MeetingId"
                                                style="top:calc(var(--hr) * @top.ToString("0.###", inv));height:calc(var(--hr) * @len.ToString("0.###", inv) - 3px);left:calc(@((lane * w).ToString("0.###", inv))% + 3px);width:calc(@w.ToString("0.###", inv)% - 6px)"
                                                title="@EvTip(ev)">
                                            <b class="sn-ev-title">@if (st == "Live") { <em class="sn-ev-live">Live</em> }@if (ev.IsCancelled) { <em class="sn-ev-cancel">Cancelled</em> }@ev.Title</b>
                                            <span class="sn-ev-time">@ev.StartLocal.ToString("HH:mm", inv) – @ev.EndLocal.ToString("HH:mm", inv)@if (ev.Repeat is not null) { <i class="fa fa-repeat sn-ev-rep" aria-hidden="true" title="@ev.Repeat"></i> }@if (ev.IsMoved) { <i class="fa fa-share sn-ev-moved" aria-hidden="true" title="Moved (only this date)"></i> }</span>
                                            <span class="sn-ev-meta"><i class="fa fa-user-o" aria-hidden="true"></i> By @By(ev) · @ev.People.Count @(ev.People.Count == 1 ? "person" : "people") @AnsBadges(ev)</span>
                                            @ActBtn(ev)
                                        </button>
                                    }
                                    @if (d.IsToday && nowTop >= 0)
                                    {
                                        <div class="sn-now" style="top:calc(var(--hr) * @nowTop.ToString("0.###", inv))" data-top="@nowTop.ToString("0.####", inv)" data-max="@(endH - startH)"><i></i></div>
                                    }
                                    <div class="sn-slot-hint" aria-hidden="true"><i class="fa fa-plus"></i> <span></span></div>
                                </div>
                            }
                        </div>
                    </div>
                </section>
            }
            else if (view == "month")
            {
                @* ---------- Month: one cell per day. Click a day to schedule on it. ---------- *@
                <section id="viewSchedule" class="sn-view sn-month glass" aria-label="Month">
                    <div class="sn-month-head">
                        @foreach (var dn in new[] { "Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun" })
                        {
                            <span>@dn</span>
                        }
                    </div>
                    <div class="sn-month-grid" style="--weeks:@(Model.Days.Count / 7)">
                        @foreach (var d in Model.Days)
                        {
                            var outside = d.Date.Month != anchor.Month;
                            var shown = d.Events.OrderByDescending(x => x.IsAllDay).ThenBy(x => x.StartLocal).Take(3).ToList();
                            <div class="sn-mcell @(Weekend(d.Date.DayOfWeek) ? "weekend" : "") @(d.IsToday ? "today" : "") @(outside ? "outside" : "") @(d.Date < today ? "past" : "") @(d.Events.Any(x => x.IsAllDay && !x.ShowAsFree) ? "busy-day" : "")" data-date="@d.Date.ToString("dd-MM-yyyy", inv)" tabindex="0" role="button" aria-label="@d.Date.ToString("dddd d MMMM", inv): @d.Events.Count meetings. Press Enter to schedule.">
                                <div class="sn-mcell-top">
                                    <a class="sn-mday" href="@PUrl("day", d.Date)" onclick="return snNav(this.href, '', event)" title="Open this day">@d.Date.Day</a>
                                    <span class="sn-madd" aria-hidden="true"><i class="fa fa-plus"></i></span>
                                </div>
                                @foreach (var ev in shown)
                                {
                                    var st = Status(ev);
                                    <button type="button" class="sn-mev tone-@ev.Tone st-@st.ToLowerInvariant() @(ev.IsAllDay ? (ev.ShowAsFree ? "allday free" : "allday busy") : "") @(ev.IsCancelled ? "is-cancelled" : "") @MineCls(ev)" @EvData(ev) data-id="@ev.MeetingId"
                                            title="@EvTip(ev)">
                                        <i></i><span class="t">@(ev.IsAllDay ? "All day" : ev.StartLocal.ToString("HH:mm", inv))</span> <span class="n">@ev.Title</span>@if (!ev.IsHost && !ev.IsCancelled) { <span class="by">· @ev.HostName</span> }@if (ev.IsCancelled) { <span class="x">Cancelled</span> }@AnsBadges(ev)
                                        @ActBtn(ev)
                                    </button>
                                }
                                @if (d.Events.Count > shown.Count)
                                {
                                    <a class="sn-mmore" href="@PUrl("day", d.Date)" onclick="return snNav(this.href, '', event)">+@(d.Events.Count - shown.Count) more</a>
                                }
                            </div>
                        }
                    </div>
                </section>
            }
            else if (view == "agenda")
            {
                @* ---------- Agenda: day by day, each meeting with its time, who set it up, the people and the agenda ---------- *@
                <section id="viewSchedule" class="sn-view sn-agenda glass" aria-label="Agenda, day by day">
                    @if (!events.Any(e => !e.IsCancelled))
                {
                    <div class="sn-next-hint" role="status">
                        <span class="sn-next-hint-ic"><i class="fa fa-calendar-o" aria-hidden="true"></i></span>
                        <span><b>No meetings @(view == "list" ? "this week" : "in these 7 days")</b></span>
                        @if (Model.NextAfter is CalendarEventVm na)
                        {
                            <span class="sn-next-hint-next">Next: <b>@na.StartLocal.ToString("ddd d MMM", inv)@(na.IsAllDay ? " · all day" : ", " + na.StartLocal.ToString("HH:mm", inv))</b> · @na.Title <small>(set up by @By(na))</small></span>
                            <a class="sn-next-hint-go" href="@PUrl(view, DateOnly.FromDateTime(na.StartLocal))" onclick="return snNav(this.href, 'next', event)">Go to that @(view == "list" ? "week" : "day") <i class="fa fa-arrow-right" aria-hidden="true"></i></a>
                        }
                        else
                        {
                            <span class="muted">Nothing scheduled in the next 6 months.</span>
                        }
                    </div>
                }

                    @foreach (var d in Model.Days)
                    {
                        var dayEvents = d.Events.OrderByDescending(x => x.IsAllDay).ThenBy(x => x.StartLocal).ToList();
                        var dmy = d.Date.ToString("dd-MM-yyyy", inv);
                        <div class="sn-ag-day @(d.IsToday ? "today" : "") @(d.Date < today ? "past" : "") @(Weekend(d.Date.DayOfWeek) ? "weekend" : "")" data-date="@dmy">
                            <a class="sn-ag-date" href="@PUrl("day", d.Date)" onclick="return snNav(this.href, '', event)" title="Open this day">
                                <small>@d.Date.ToString("ddd", inv)</small><b>@d.Date.Day</b><small>@d.Date.ToString("MMM", inv)</small>
                                @if (d.IsToday) { <em>Today</em> }
                            </a>
                            <div class="sn-ag-list">
                                @if (dayEvents.Count == 0)
                                {
                                    <p class="sn-ag-empty"><span>No meetings</span>@if (d.Date >= today) { <text> · </text><button type="button" class="sn-link" data-ag-add="@dmy">Schedule one</button> }</p>
                                }
                                @foreach (var ev in dayEvents)
                                {
                                    var st = Status(ev);
                                    var others = ev.People.Skip(1).ToList();
                                    <article class="sn-ag-ev tone-@ev.Tone st-@st.ToLowerInvariant() @(ev.IsCancelled ? "is-cancelled" : "") @MineCls(ev)" @EvData(ev) data-id="@ev.MeetingId" tabindex="0" title="@EvTip(ev)">
                                        <div class="sn-ag-time">
                                            @if (ev.IsAllDay) { <b>All day</b> }
                                            else { <b>@ev.StartLocal.ToString("HH:mm", inv)</b><small>@ev.EndLocal.ToString("HH:mm", inv)</small> }
                                        </div>
                                        <div class="sn-ag-main">
                                            <div class="sn-ag-title">
                                                <b>@ev.Title</b>
                                                @if (st == "Live") { <span class="sn-ag-badge live">Live</span> }
                                                @if (ev.IsCancelled) { <span class="sn-ag-badge cancelled">Cancelled</span> }
                                                @if (st == "Ended") { <span class="sn-ag-badge ended">Ended</span> }
                                                @if (ev.Repeat is not null) { <span class="sn-ag-badge rep"><i class="fa fa-repeat" aria-hidden="true"></i> @ev.Repeat</span> }
                                                @if (ev.IsMoved) { <span class="sn-ag-badge moved"><i class="fa fa-share" aria-hidden="true"></i> Moved</span> }
                                            </div>
                                            <div class="sn-ag-meta">
                                                <span><i class="fa fa-user-o" aria-hidden="true"></i> Set up by <b>@By(ev)</b></span>
                                                <span><i class="fa fa-users" aria-hidden="true"></i> @ev.People.Count @(ev.People.Count == 1 ? "person" : "people")</span>
                                                @if (!ev.IsAllDay) { <span><i class="fa fa-clock-o" aria-hidden="true"></i> @DurText((int)(ev.EndLocal - ev.StartLocal).TotalMinutes)</span> }
                                            </div>
                                            @if (!ev.IsCancelled && ev.Accepted + ev.Maybe + ev.Declined + ev.Waiting > 0)
                                            {
                                                <div class="sn-ag-answers">
                                                    <span class="a-yes"><i></i>@ev.Accepted accepted</span>
                                                    @if (ev.Maybe > 0) { <span class="a-maybe"><i></i>@ev.Maybe maybe</span> }
                                                    @if (ev.Declined > 0) { <span class="a-no"><i></i>@ev.Declined declined</span> }
                                                    @if (ev.Waiting > 0) { <span class="a-wait"><i></i>@ev.Waiting no response</span> }
                                                    @if (ev.MyResponse != MeetingResponse.None) { <span class="a-mine">You: @(ev.MyResponse == MeetingResponse.Accepted ? "accepted" : ev.MyResponse == MeetingResponse.Maybe ? "maybe" : "declined")</span> }
                                                </div>
                                                @if (ev.Answers.Count > 0)
                                                {
                                                    <ul class="sn-ag-reasons">
                                                        @foreach (var x in ev.Answers)
                                                        {
                                                            <li class="@(x.Response == MeetingResponse.Declined ? "no" : "maybe")"><b>@(x.Response == MeetingResponse.Declined ? "✕" : "?") @x.Name</b>@if (!string.IsNullOrWhiteSpace(x.Note)) { <span>“@x.Note”</span> } else { <span class="muted">no reason given</span> }</li>
                                                        }
                                                    </ul>
                                                }
                                            }
                                            @if (ev.IsCancelled)
                                            {
                                                <div class="sn-ag-cancel"><i class="fa fa-calendar-times-o" aria-hidden="true"></i> <span>Cancelled</span>@(ev.CancelledBy is null ? "" : " by " + ev.CancelledBy)@if (!string.IsNullOrWhiteSpace(ev.CancelNote)) { <q>@ev.CancelNote</q> }</div>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(ev.Agenda))
                                            {
                                                <p class="sn-ag-agenda">@ev.Agenda</p>
                                            }
                                            @if (others.Count > 0)
                                            {
                                                <div class="sn-ag-people">
                                                    <span class="stack-avatars">
                                                        @foreach (var pp in others.Take(6))
                                                        {
                                                            <span class="avatar av-28 tone-@(pp.Tone) ring-white" title="@pp.Name">@pp.Initials</span>
                                                        }
                                                    </span>
                                                    <span class="muted small">@string.Join(", ", others.Take(4).Select(x => x.Name))@(others.Count > 4 ? $" and {others.Count - 4} more" : "")</span>
                                                </div>
                                            }
                                        </div>
                                        <div class="sn-ag-acts">
                                            @if (!ev.IsCancelled && st != "Ended")
                                            {
                                                <a class="cee-btn sn-btn-light sn-ag-join" href="/meetings/room/@ev.MeetingId" onclick="event.stopPropagation()"><i class="fa fa-video-camera" aria-hidden="true"></i> Join</a>
                                            }
                                            @ActBtn(ev)
                                        </div>
                                    </article>
                                }
                            </div>
                        </div>
                    }
                </section>
            }

            @* ---------- List (Template 1 modern-table) ---------- *@
            <section id="viewList" class="sn-view sn-view-list @(view == "list" ? "is-on" : "")" aria-label="Meeting list">
                @if (view == "list" && !events.Any(e => !e.IsCancelled))
                {
                    <div class="sn-next-hint" role="status">
                        <span class="sn-next-hint-ic"><i class="fa fa-calendar-o" aria-hidden="true"></i></span>
                        <span><b>No meetings @(view == "list" ? "this week" : "in these 7 days")</b></span>
                        @if (Model.NextAfter is CalendarEventVm na)
                        {
                            <span class="sn-next-hint-next">Next: <b>@na.StartLocal.ToString("ddd d MMM", inv)@(na.IsAllDay ? " · all day" : ", " + na.StartLocal.ToString("HH:mm", inv))</b> · @na.Title <small>(set up by @By(na))</small></span>
                            <a class="sn-next-hint-go" href="@PUrl(view, DateOnly.FromDateTime(na.StartLocal))" onclick="return snNav(this.href, 'next', event)">Go to that @(view == "list" ? "week" : "day") <i class="fa fa-arrow-right" aria-hidden="true"></i></a>
                        }
                        else
                        {
                            <span class="muted">Nothing scheduled in the next 6 months.</span>
                        }
                    </div>
                }
            <modern-table id="MeetingsTable" name="SelectedMeeting"
                          grid-name="@(view == "list" ? "Meeting list" : "Meetings in this period")" icon="calendar" icon-background-color="linear-gradient(115deg,#2563EB,#DB2777)" icon-color="#fff"
                          show-grid-name-and-icon="true"
                          searchable="true" search-placeholder="Search meetings..."
                          show-filter-button="true" filter-row-open="false"
                          column-toggle="true" selectable="true" enable-paging="true" page-size="50"
                          is-animated-scrolling="true" row-height="52px" header-height="42px"
                          row-id-field="MeetingId" table-height="100%"
                          items="rows">
                <column field="MeetingId" header="Id" visible="false" filterable="false" sortable="false"></column>
                <column field="Title" header="Meeting" width="240px"></column>
                <column field="Day" header="Day" width="120px"></column>
                <column field="Time" header="Time" width="130px"></column>
                <column field="Duration" header="Duration" width="100px"></column>
                <column field="Host" header="Set up by" width="170px"></column>
                <column field="Repeat" header="Repeats" width="150px"></column>
                <column field="People" header="People" width="90px" cell-align="right" header-align="right"></column>
                <column field="Role" header="You are" type="badge" width="110px">
                    <badge value="Host" color="#DBEAFE"></badge>
                    <badge value="Invited" color="#FCE7F3"></badge>
                </column>
                <column field="Status" header="Status" type="badge" width="120px">
                    <badge value="Live" color="#DCFCE7"></badge>
                    <badge value="Upcoming" color="#E0E7FF"></badge>
                    <badge value="Ended" color="#E2E8F0"></badge>
                    <badge value="Cancelled" color="#FEE2E2"></badge>
                </column>
            </modern-table>
            </section>
        </div>

        <div class="sn-side">
            @* ---- meetings in this period by status: a segmented gauge like the Team page ---- *@
            @{
                var totalEv = live + upcoming + ended;
                const double ArcLen = 263.89;            // half circle, radius 84
                const double Gap = 5;                    // space between the coloured parts
                var parts = new[] { ("live", live, "gLive"), ("up", upcoming, "gUp"), ("ended", ended, "gEnded") }.Where(x => x.Item2 > 0).ToList();
                var usable = ArcLen - Gap * Math.Max(0, parts.Count - 1);
                double pos = 0;
                var segs = new List<(string Key, string Grad, double Start, double Len)>();
                foreach (var (key, n, grad) in parts)
                {
                    var len = totalEv == 0 ? 0 : usable * n / totalEv;
                    segs.Add((key, grad, pos, len));
                    pos += len + Gap;
                }
                var hours = events.Where(e => !e.IsAllDay && !e.IsCancelled).Sum(e => Math.Max(0, (e.EndLocal - e.StartLocal).TotalMinutes)) / 60.0;
                var hoursText = hours < 1 ? $"{Math.Round(hours * 60)} min" : $"{hours:0.#} h";
                var donePct = totalEv == 0 ? 0 : (int)Math.Round(ended * 100.0 / totalEv);
                string F(double v) => v.ToString("0.##", inv);
            }
            <section class="sn-gauge-card glass sn-mstat" aria-label="@periodWord: @live live, @upcoming upcoming, @ended ended">
                <header class="sn-gauge-head">
                    <span class="sn-gauge-ic meet"><i class="fa fa-calendar-check-o" aria-hidden="true"></i></span>
                    <div class="sn-gauge-title">
                        <h3>Meetings</h3>
                        <small>@live live · @upcoming upcoming · @ended ended</small>
                    </div>
                    <span class="sn-gauge-pill">@periodWord</span>
                </header>
                <div class="sn-gauge">
                    <svg viewBox="0 0 200 112" aria-hidden="true">
                        <defs>
                            <linearGradient id="gLive" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#22C55E" /><stop offset="1" stop-color="#10B981" /></linearGradient>
                            <linearGradient id="gUp" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#2563EB" /><stop offset=".6" stop-color="#7C3AED" /><stop offset="1" stop-color="#DB2777" /></linearGradient>
                            <linearGradient id="gEnded" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#64748B" /><stop offset="1" stop-color="#94A3B8" /></linearGradient>
                        </defs>
                        <path class="sn-gauge-track" d="M16 100 A84 84 0 0 1 184 100" />
                        @foreach (var g in segs)
                        {
                            <path class="sn-gauge-value sn-mseg @g.Key" d="M16 100 A84 84 0 0 1 184 100" stroke="url(#@g.Grad)"
                                  stroke-dasharray="@F(Math.Max(.01, g.Len)) 1000" stroke-dashoffset="@F(-g.Start)" />
                        }
                    </svg>
                    <div class="sn-gauge-center">
                        <b>@totalEv</b>
                        <small>@(totalEv == 1 ? "meeting" : "meetings") · @donePct% done</small>
                    </div>
                </div>
                <div class="sn-gauge-stats">
                    <div class="@(live > 0 ? "is-live" : "")"><span class="sn-gs-label"><i class="sn-gs-dot live"></i><span class="sn-gs-text">Live</span></span><b>@live</b></div>
                    <div><span class="sn-gs-label"><i class="sn-gs-dot up"></i><span class="sn-gs-text">Upcoming</span></span><b>@upcoming</b></div>
                    <div><span class="sn-gs-label"><i class="sn-gs-dot ended"></i><span class="sn-gs-text">Ended</span></span><b>@ended</b></div>
                </div>
                <div class="sn-mstat-foot">
                    <span><i class="fa fa-clock-o" aria-hidden="true"></i> @hoursText in meetings</span>
                    <span><i class="fa fa-user" aria-hidden="true"></i> @events.Count(e => e.IsHost) set up by you</span>
                </div>
            </section>

            @* ---- calls in this period: the same kind of gauge, for calls made from Chat ---- *@
            @{
                var pc = Model.PeriodCalls ?? new List<CallHistoryDto>();
                var meId = User.UserGuid();
                var cAnswered = pc.Count(x => x.Outcome is 1 or 2);
                var cMissed = pc.Count(x => x.CallerId != meId && x.Outcome is 3 or 5);
                var cOther = pc.Count - cAnswered - cMissed;
                var cTotal = pc.Count;
                var cIn = pc.Count(x => x.CallerId != meId);
                var cOut = cTotal - cIn;
                var talk = pc.Where(x => x.AnsweredUtc is not null).Sum(x => Math.Max(0, ((x.EndedUtc ?? DateTime.UtcNow) - x.AnsweredUtc!.Value).TotalSeconds));
                var talkTs = TimeSpan.FromSeconds(talk);
                var talkText = talkTs.TotalHours >= 1 ? $"{(int)talkTs.TotalHours}h {talkTs.Minutes}m" : talkTs.TotalMinutes >= 1 ? $"{talkTs.Minutes}m {talkTs.Seconds}s" : $"{talkTs.Seconds}s";
                var cPct = cTotal == 0 ? 0 : (int)Math.Round(cAnswered * 100.0 / cTotal);
                var cParts = new[] { ("ok", cAnswered, "gCallOk"), ("miss", cMissed, "gCallMiss"), ("other", cOther, "gCallOther") }.Where(x => x.Item2 > 0).ToList();
                var cUsable = 263.89 - 5 * Math.Max(0, cParts.Count - 1);
                double cPos = 0;
                var cSegs = new List<(string Key, string Grad, double Start, double Len)>();
                foreach (var (key, n, grad) in cParts)
                {
                    var len = cTotal == 0 ? 0 : cUsable * n / cTotal;
                    cSegs.Add((key, grad, cPos, len));
                    cPos += len + 5;
                }
                string CF(double v) => v.ToString("0.##", inv);
            }
            <section class="sn-gauge-card glass sn-mstat sn-cstat" aria-label="@periodWord calls: @cAnswered answered, @cMissed missed, @cOther not connected">
                <header class="sn-gauge-head">
                    <span class="sn-gauge-ic call"><i class="fa fa-phone" aria-hidden="true"></i></span>
                    <div class="sn-gauge-title">
                        <h3>Calls</h3>
                        <small>@cIn incoming · @cOut outgoing</small>
                    </div>
                    <span class="sn-gauge-pill">@periodWord</span>
                </header>
                @if (Model.PeriodCalls is null)
                {
                    <p class="sn-cstat-note">Run <b>database/23_CallsAndFiles.sql</b> to see your calls here.</p>
                }
                <div class="sn-gauge">
                    <svg viewBox="0 0 200 112" aria-hidden="true">
                        <defs>
                            <linearGradient id="gCallOk" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#22C55E" /><stop offset="1" stop-color="#0EA5E9" /></linearGradient>
                            <linearGradient id="gCallMiss" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#F43F5E" /><stop offset="1" stop-color="#DC2626" /></linearGradient>
                            <linearGradient id="gCallOther" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#F59E0B" /><stop offset="1" stop-color="#94A3B8" /></linearGradient>
                        </defs>
                        <path class="sn-gauge-track" d="M16 100 A84 84 0 0 1 184 100" />
                        @foreach (var g in cSegs)
                        {
                            <path class="sn-gauge-value sn-cseg @g.Key" d="M16 100 A84 84 0 0 1 184 100" stroke="url(#@g.Grad)"
                                  stroke-dasharray="@CF(Math.Max(.01, g.Len)) 1000" stroke-dashoffset="@CF(-g.Start)" />
                        }
                    </svg>
                    <div class="sn-gauge-center">
                        <b>@cTotal</b>
                        <small>@(cTotal == 1 ? "call" : "calls") · @cPct% answered</small>
                    </div>
                </div>
                <div class="sn-gauge-stats">
                    <div><span class="sn-gs-label"><i class="sn-gs-dot ok"></i><span class="sn-gs-text">Answered</span></span><b>@cAnswered</b></div>
                    <div class="@(cMissed > 0 ? "is-missed" : "")"><span class="sn-gs-label"><i class="sn-gs-dot miss"></i><span class="sn-gs-text">Missed</span></span><b>@cMissed</b></div>
                    <div><span class="sn-gs-label"><i class="sn-gs-dot other"></i><span class="sn-gs-text">No answer</span></span><b>@cOther</b></div>
                </div>
                <div class="sn-mstat-foot">
                    <span><i class="fa fa-clock-o" aria-hidden="true"></i> @talkText talking</span>
                    <a class="sn-cstat-link" href="/calls">Open Calls <i class="fa fa-arrow-right" aria-hidden="true"></i></a>
                </div>
            </section>

            <section class="sn-gauge-card glass sn-upnext" aria-label="Up next">
                <header class="sn-gauge-head">
                    <span class="sn-gauge-ic next"><i class="fa fa-bolt" aria-hidden="true"></i></span>
                    <div class="sn-gauge-title">
                        <h3>Up next</h3>
                        <small>Your next meeting in the coming 24 hours</small>
                    </div>
                </header>
                @if (Model.UpNext is CalendarEventVm next)
                {
                    <div class="sn-next">
                        <span class="sn-eyebrow" style="color:@(Model.UpNextMinutes <= 0 ? "#15803d" : "#475569")">@(Model.UpNextMinutes <= 0 ? "Happening now" : Model.UpNextMinutes < 60 ? $"Starts in {Model.UpNextMinutes} min" : next.StartLocal.ToString("ddd HH:mm", inv))</span>
                        <strong>@next.Title</strong>
                        <span class="muted small">@next.StartLocal.ToString("HH:mm", inv) – @next.EndLocal.ToString("HH:mm", inv) · set up by @By(next)</span>
                        <div class="sn-next-foot">
                        <span class="stack-avatars">
                            @foreach (var p in next.People.Take(5))
                            {
                                <span class="avatar av-32 tone-@(p.Tone) ring-white" title="@p.Name">@p.Initials</span>
                            }
                            @if (next.People.Count > 5)
                            {
                                <span class="avatar av-32 tone-5 ring-white">+@(next.People.Count - 5)</span>
                            }
                        </span>
                        <a class="cee-btn cee-btn-gradient sn-join-btn" href="/meetings/room/@next.MeetingId"><i class="fa fa-video-camera" aria-hidden="true"></i> Join</a>
                        </div>
                    </div>
                }
                else
                {
                    <div class="sn-upnext-empty">
                        <i class="fa fa-coffee" aria-hidden="true"></i>
                        <span>Nothing in the next 24 hours.<br /><button type="button" class="sn-link" onclick="SN.open('scheduleDialog')">Schedule a meeting</button></span>
                    </div>
                }
            </section>
        </div>
    </div>
</main>

@* ---------- Schedule a meeting (glass pop-up, Template 1 inputs) ---------- *@
<dialog id="scheduleDialog" class="sn-dialog wide glass-strong" data-open-on-load="@(hasFormErrors ? "true" : "false")">
    <form method="post" asp-antiforgery="true" action="/meetings/schedule" id="scheduleForm" novalidate>
        <div class="sn-dlg-head">
            <div class="sn-dlg-title">
                <span class="sn-dlg-icon"><i class="fa fa-calendar-plus-o" aria-hidden="true"></i></span>
                <div><h2>Schedule a meeting</h2><p>Invites go out by email with a calendar file.</p></div>
            </div>
            <button type="button" class="sn-close" data-close aria-label="Close"><i class="fa fa-times" aria-hidden="true"></i></button>
        </div>

        <div class="sn-dlg-body">
            <div asp-validation-summary="All" class="sn-errors"></div>
            <div class="sn-form-grid">
                <modern-group-box title="Meeting | details" header-bg-color="transparent" content-bg-color="transparent" border-color="rgba(255,255,255,.75)" radius="22px" content-layout="block">
                    <div class="sn-form-grid">
                        <div class="full">
                            <modern-input id="mTitle" name="Form.Title" label="Title" mandatory="true" value="@f.Title" max-length="150"
                                          placeholder="e.g. Weekly planning" label-font-size="13.5px"></modern-input>
                        </div>
                        <modern-datepicker-with-label id="mDate" name="Form.DateText" label="Date" required="true"
                                                      value="@f.Date.ToString("dd-MM-yyyy", inv)" height="42px"></modern-datepicker-with-label>
                        <div class="sn-allday-toggle">
                            <modern-checkbox id="mAllDay" name="Form.AllDay" label="All-day event" desc-text="Takes the whole day" is-toggle-button="true" checked="@f.AllDay" label-font-size="13.5px"></modern-checkbox>
                        </div>

                        @* timed meeting: start + length *@
                        <div class="full sn-reveal @(f.AllDay ? "is-collapsed" : "")" id="timeFields">
                            <div class="sn-reveal-in">
                                <div class="sn-form-grid">
                                    <modern-dropdown-with-label id="mTime" name="Form.Time" label="Start time" required="true"
                                                                value="@formTime" items="timeItems" menu-height="220px"></modern-dropdown-with-label>
                                    <modern-dropdown-with-label id="mDuration" name="Form.DurationMinutes" label="Duration"
                                                                value="@f.DurationMinutes.ToString(inv)" items="durationItems" menu-height="220px"></modern-dropdown-with-label>
                                    <div class="full sn-hint"><i class="fa fa-info-circle" aria-hidden="true"></i> Your @Model.Limits.PlanName plan allows meetings up to @DurText(Model.Limits.MaxMeetingMinutes). For a longer block, turn on <b>All-day event</b>.</div>
                                </div>
                            </div>
                        </div>

                        @* all-day: busy or free *@
                        <div class="full sn-reveal @(f.AllDay ? "" : "is-collapsed")" id="showAsFields">
                            <div class="sn-reveal-in">
                                <modern-radio-group id="mShowAs" name="Form.ShowAs" label="Show as" selected-value="@(f.ShowAs == "free" ? "free" : "busy")" label-font-size="13.5px">
                                    <modern-radio value="busy" label="Busy · blocks the whole day"></modern-radio>
                                    <modern-radio value="free" label="Free · a note at the top of the day"></modern-radio>
                                </modern-radio-group>
                            </div>
                        </div>

                        <div class="full">
                            <span class="mi-label" style="display:block;font-size:13.5px;font-weight:600;margin-bottom:8px">Availability</span>
                            <span class="sn-free ok" id="freeText"><i class="fa fa-check-circle"></i> You're free at this time</span>
                        </div>
                        <div class="full">
                            <modern-radio-group id="mRepeat" name="Form.Recurrence" label="Repeat" selected-value="@f.Recurrence.ToString()" label-font-size="13.5px">
                                <modern-radio value="None" label="Once"></modern-radio>
                                <modern-radio value="Weekly" label="Weekly"></modern-radio>
                                <modern-radio value="Daily" label="Weekdays"></modern-radio>
                                <modern-radio value="Custom" label="Pick days"></modern-radio>
                            </modern-radio-group>
                        </div>

                        @* repeat details: which days (Pick days only) and the last day *@
                        <div class="full sn-reveal @(f.Recurrence == MeetingRecurrence.None ? "is-collapsed" : "")" id="repeatFields">
                            <div class="sn-reveal-in">
                                <div class="sn-repeat-box">
                                    <div class="sn-reveal @(f.Recurrence == MeetingRecurrence.Custom ? "" : "is-collapsed")" id="repeatDaysFields">
                                        <div class="sn-reveal-in">
                                            <div class="sn-repeat-row">
                                                <span class="sn-repeat-label">Repeat on</span>
                                                <span class="sn-day-presets">
                                                    <button type="button" class="sn-link" data-days="1,3,5">Mon · Wed · Fri</button>
                                                    <button type="button" class="sn-link" data-days="2,4">Tue · Thu</button>
                                                    <button type="button" class="sn-link" data-days="">Clear</button>
                                                </span>
                                            </div>
                                            <div class="sn-daypick" role="group" aria-label="Repeat on these days">
                                                @foreach (var (dow, shortName, longName) in new[] { (1, "Mon", "Monday"), (2, "Tue", "Tuesday"), (3, "Wed", "Wednesday"), (4, "Thu", "Thursday"), (5, "Fri", "Friday"), (6, "Sat", "Saturday"), (0, "Sun", "Sunday") })
                                                {
                                                    <label class="sn-daychip" title="@longName">
                                                        <input type="checkbox" name="Form.RepeatDays" value="@dow" checked="@f.RepeatDays.Contains(dow)" />
                                                        <span>@shortName</span>
                                                    </label>
                                                }
                                            </div>
                                        </div>
                                    </div>

                                    <div class="sn-form-grid sn-repeat-end">
                                        <modern-checkbox id="mRepeatEnds" name="Form.RepeatEnds" label="Ends on a date" desc-text="Off: repeats with no end" is-toggle-button="true" checked="@f.RepeatEnds" label-font-size="13.5px"></modern-checkbox>
                                        <div class="sn-reveal @(f.RepeatEnds ? "" : "is-collapsed")" id="repeatUntilFields">
                                            <div class="sn-reveal-in">
                                                <modern-datepicker-with-label id="mUntil" name="Form.RepeatUntilText" label="Last day"
                                                                              value="@f.RepeatUntilText" placeholder="Pick the last day" height="42px"></modern-datepicker-with-label>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="sn-repeat-summary" id="repeatSummary" aria-live="polite"></div>
                                </div>
                            </div>
                        </div>
                        <div class="full">
                            <modern-input id="mAgenda" name="Form.Agenda" label="Agenda" multiline="true" rows="3" value="@f.Agenda"
                                          max-length="2000" placeholder="What will you cover?" label-font-size="13.5px"></modern-input>
                        </div>
                    </div>
                </modern-group-box>

                <div style="display:flex;flex-direction:column;gap:14px;min-width:0">
                    <modern-group-box title="People | invited" css-class="sn-fill" header-bg-color="transparent" content-bg-color="transparent" border-color="rgba(255,255,255,.75)" radius="22px" content-layout="block">
                        @if (Model.Team.Count > 0)
                        {
                            var invitePicker = new PeoplePickerVm
                            {
                                Id = "invitePeople", People = Model.Team, FieldName = "Form.InviteeIds",
                                Picked = f.InviteeIds, Title = "Invite", CssClass = "sn-pp-compact"
                            };
                            <partial name="_PeoplePicker" model="invitePicker" />
                        }
                        else
                        {
                            <div class="sn-people-empty">
                                <span class="sn-insp-empty-ic"><i class="fa fa-user-plus" aria-hidden="true"></i></span>
                                <strong>No one else is in this workspace yet</strong>
                                <span>@(User.IsInRole(AppRoles.TenantAdmin) ? "Invite outside people by email below, or add your team first." : "Invite outside people by email below. Your admin can add team members.")</span>
                                @if (User.IsInRole(AppRoles.TenantAdmin))
                                {
                                    <a class="cee-btn sn-btn-light sn-btn-sm" href="/team?add=1"><i class="fa fa-user-plus" aria-hidden="true"></i> Add people to the team</a>
                                }
                            </div>
                        }
                        <div class="sn-guests">
                            <span class="mi-label" style="display:block;font-size:13.5px;font-weight:600;margin-bottom:8px">Guests from outside</span>
                            <div class="sn-chipbox" id="guestBox">
                                <input type="email" id="guestEntry" placeholder="Type an email and press Enter" autocomplete="off" aria-label="Guest email" />
                            </div>
                            <input type="hidden" id="mGuests" name="Form.GuestEmails" value="@f.GuestEmails" />
                            <span class="sn-hint" id="guestHint">They get the guest link by email. Press Enter or comma after each address.</span>
                        </div>
                    </modern-group-box>

                    <modern-group-box title="Meeting | options" header-bg-color="transparent" content-bg-color="transparent" border-color="rgba(255,255,255,.75)" radius="22px" content-layout="block">
                        <div class="sn-form-grid">
                            <modern-checkbox id="mLobby" name="Form.LobbyEnabled" label="Lobby" desc-text="Host admits guests" is-toggle-button="true" checked="@f.LobbyEnabled" label-font-size="13.5px"></modern-checkbox>
                            <modern-checkbox id="mGuestLink" name="Form.GuestLinkEnabled" label="Guest link" desc-text="Outside people can join" is-toggle-button="true" checked="@f.GuestLinkEnabled" label-font-size="13.5px"></modern-checkbox>
                            <modern-checkbox id="mCaptions" name="Form.CaptionsOn" label="Captions" desc-text="Live subtitles" is-toggle-button="true" checked="@f.CaptionsOn" label-font-size="13.5px"></modern-checkbox>
                            <modern-checkbox id="mEmail" name="Form.SendEmail" label="Email invites" desc-text="With .ics calendar file" is-toggle-button="true" checked="@f.SendEmail" label-font-size="13.5px"></modern-checkbox>
                        </div>
                    </modern-group-box>
                </div>
            </div>
        </div>

        <div class="sn-dlg-foot">
            <span class="muted small"><i class="fa fa-shield"></i> @Model.Limits.PlanName plan: up to @Model.Limits.MaxMeetingParticipants people, @Model.Limits.MaxMeetingMinutes min per meeting</span>
            <span style="display:flex;gap:10px">
                <button type="button" class="cee-btn sn-btn-light" data-close>Cancel</button>
                <button type="submit" class="cee-btn cee-btn-gradient"><i class="fa fa-check" aria-hidden="true"></i> Save &amp; send invites</button>
            </span>
        </div>
    </form>
</dialog>

@* ---- cancel a meeting (a repeating one: the whole series). Everyone invited gets an email with a calendar cancellation. ---- *@
<dialog id="cancelDialog" class="sn-dialog glass-strong sn-cancel-dlg" aria-labelledby="cancelT">
    <form method="post" asp-antiforgery="true" action="/meetings" id="cancelForm">
        <div class="sn-dlg-head">
            <div class="sn-dlg-title">
                <span class="sn-dlg-icon sn-cancel-ic"><i class="fa fa-calendar-times-o" aria-hidden="true"></i></span>
                <div><h2 id="cancelT">Cancel meeting</h2><p>It stays on everyone's calendar, marked Cancelled.</p></div>
            </div>
            <button type="button" class="sn-close" data-close aria-label="Close"><i class="fa fa-times" aria-hidden="true"></i></button>
        </div>
        <div class="sn-dlg-body sn-cancel-body">
            <p class="sn-cancel-what" id="cancelWhat"></p>
            <div class="sn-scope" id="cancelScope" hidden role="radiogroup" aria-label="What to cancel">
                <label class="sn-scope-opt"><input type="radio" name="cancelScope" value="date" checked /> <span><b id="cancelDateLabel">Only this meeting</b><small>The rest of the series stays</small></span></label>
                <label class="sn-scope-opt"><input type="radio" name="cancelScope" value="series" /> <span><b>The whole series</b><small>Every meeting in it, marked cancelled</small></span></label>
            </div>
            <input type="hidden" name="date" id="cancelDate" />
            <label class="sn-field-label" for="cancelNote">Reason <span class="muted">(optional, everyone sees it)</span></label>
            <textarea id="cancelNote" name="note" class="sn-textarea" rows="3" maxlength="500" placeholder="e.g. Moving this to next week"></textarea>
            <label class="sn-ooo-noend sn-cancel-mail"><input type="checkbox" id="cancelMail" name="sendEmail" value="true" checked /> <span>Email everyone invited, with a calendar cancellation for Outlook / Google Calendar</span></label>
            <input type="hidden" name="sendEmail" value="false" />
            <input type="hidden" name="returnUrl" id="cancelReturn" />
            <p class="sn-cancel-hint"><i class="fa fa-info-circle" aria-hidden="true"></i> Each person can then remove it from their own calendar with the 🗑 on the meeting.</p>
        </div>
        <div class="sn-dlg-foot">
            <span style="display:flex;gap:10px;margin-left:auto">
                <button type="button" class="cee-btn sn-btn-light" data-close>Keep meeting</button>
                <button type="submit" class="cee-btn sn-btn-danger-soft sn-cancel-go" id="cancelSubmit"><i class="fa fa-ban" aria-hidden="true"></i> <span>Cancel meeting</span></button>
            </span>
        </div>
    </form>
</dialog>

@* ---- edit a meeting: the whole meeting (series), or only one date of a repeating meeting ---- *@
<dialog id="editDialog" class="sn-dialog glass-strong sn-edit-dlg" aria-labelledby="editT">
    <form method="post" asp-antiforgery="true" action="/meetings" id="editForm">
        <div class="sn-dlg-head">
            <div class="sn-dlg-title">
                <span class="sn-dlg-icon sn-edit-ic"><i class="fa fa-pencil" aria-hidden="true"></i></span>
                <div><h2 id="editT">Edit meeting</h2><p>Everyone invited gets an email with the change.</p></div>
            </div>
            <button type="button" class="sn-close" data-close aria-label="Close"><i class="fa fa-times" aria-hidden="true"></i></button>
        </div>
        <div class="sn-dlg-body sn-edit-body">
            <div class="sn-scope" id="editScope" hidden role="radiogroup" aria-label="What to change">
                <label class="sn-scope-opt"><input type="radio" name="scope" value="date" checked /> <span><b id="editDateLabel">Only this meeting</b><small>Move this date; the rest stays</small></span></label>
                <label class="sn-scope-opt"><input type="radio" name="scope" value="series" /> <span><b>The whole series</b><small>Title, agenda and time of every meeting</small></span></label>
            </div>
            <input type="hidden" name="date" id="editOcc" />
            <div class="sn-edit-series">
                <label class="sn-field-label" for="editTitle">Title</label>
                <input type="text" id="editTitle" name="title" class="sn-input sn-edit-in" maxlength="150" autocomplete="off" />
                <label class="sn-field-label" for="editAgenda">Agenda</label>
                <textarea id="editAgenda" name="agenda" class="sn-textarea" rows="3" maxlength="2000"></textarea>
            </div>
            @* the same rounded date picker and dropdowns as "Schedule a meeting" *@
            <div class="sn-edit-when">
                <div class="sn-edit-daybox">
                    <modern-datepicker-with-label id="editDay" name="day" label="Date" required="true" value="@today.ToString("dd-MM-yyyy", inv)" height="42px"></modern-datepicker-with-label>
                </div>
                <div class="sn-edit-timebox">
                    <modern-dropdown-with-label id="editTime" name="time" label="Start time" required="true" value="10:00" items="timeItems" menu-height="220px"></modern-dropdown-with-label>
                </div>
                <div class="sn-edit-timebox">
                    <modern-dropdown-with-label id="editMin" name="minutes" label="Duration" value="60" items="durationItems" menu-height="220px"></modern-dropdown-with-label>
                </div>
            </div>
            <p class="sn-edit-warn" id="editWarn" hidden><i class="fa fa-info-circle" aria-hidden="true"></i> Changing the series time puts dates that were moved one by one back on the series time.</p>
            <label class="sn-field-label" for="editNote">Note for everyone <span class="muted">(optional)</span></label>
            <input type="text" id="editNote" name="note" class="sn-input sn-edit-in" maxlength="300" placeholder="e.g. Clash with the client call" autocomplete="off" />
            <label class="sn-ooo-noend sn-cancel-mail"><input type="checkbox" id="editMail" name="sendEmail" value="true" checked /> <span>Email everyone invited, with a calendar update</span></label>
            <input type="hidden" name="sendEmail" value="false" />
            <input type="hidden" name="returnUrl" id="editReturn" />
        </div>
        <div class="sn-dlg-foot">
            <span style="display:flex;gap:10px;margin-left:auto">
                <button type="button" class="cee-btn sn-btn-light" data-close>Cancel</button>
                <button type="submit" class="cee-btn cee-btn-gradient" id="editSubmit"><i class="fa fa-check" aria-hidden="true"></i> <span>Save changes</span></button>
            </span>
        </div>
    </form>
</dialog>

@* ---- confirm a drag and drop move ---- *@
<dialog id="moveDialog" class="sn-dialog glass-strong sn-move-dlg" aria-labelledby="moveT">
    <div class="sn-dlg-head">
        <div class="sn-dlg-title">
            <span class="sn-dlg-icon sn-edit-ic"><i class="fa fa-arrows" aria-hidden="true"></i></span>
            <div><h2 id="moveT">Move meeting</h2><p id="moveSub">Everyone invited gets an email with the new time.</p></div>
