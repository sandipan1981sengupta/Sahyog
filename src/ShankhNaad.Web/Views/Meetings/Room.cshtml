@model RoomViewModel
@using System.Text.Json
@{
    Layout = null;
    var config = new
    {
        meetingId = Model.MeetingId,
        domain = Model.Join.Domain,
        roomName = Model.Join.RoomName,
        jwt = Model.Join.Token,
        displayName = Model.DisplayName,
        isModerator = Model.IsModerator,
        isGuest = Model.IsGuest,
        lobby = Model.LobbyEnabled,
        captions = Model.CaptionsOn,
        maxHeight = Model.MaxVideoHeight,
        leaveUrl = Model.LeaveUrl,
        oneToOne = Model.OneToOne,
        startCameraOff = Model.StartCameraOff,
        userId = Model.IsGuest ? null : User.UserGuid().ToString(),
        offlineNote = Model.OfflineNote,
        callWith = Model.CallWithName is null ? null : new { name = Model.CallWithName, initials = Model.CallWithInitials, tone = Model.CallWithTone },
        chatId = Model.IsGuest ? null : Model.ChatChannelId,
        chatName = Model.CallWithName ?? Model.ChannelName,
        canRingAgain = !Model.IsGuest && (Model.ChannelName is not null || Model.OneToOne)
    };
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#070B18" />
    <title>@Model.Title · ShankhNaad</title>
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" />
    @* colour emoji that look the same on every computer (Windows has no flags and misses newer emoji); only the parts in use download *@
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Color+Emoji&display=swap" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @* Safari (Mac) and iPhone / iPad: lighter effects over the video (see css/safari.css, part 7) *@
    <script>
        (function () {
            // the room follows the theme chosen in the app (Light, Kesari, Dark, CloudWheel); the video stays dark
            var root = document.documentElement, t = null;
            try {
                t = localStorage.getItem("sn-theme3");
                if (!t) { var old = localStorage.getItem("sn-theme"); if (old === "dark") t = "cloudwheel"; else if (old === "light") t = "light"; }
            } catch (e) { }
            if (t !== "dark" && t !== "light" && t !== "cloudwheel" && t !== "kesari") t = window.matchMedia && matchMedia("(prefers-color-scheme: dark)").matches ? "cloudwheel" : "light";
            root.setAttribute("data-theme", t === "light" || t === "kesari" ? "light" : "dark");
            root.setAttribute("data-skin", t);
            if (t === "dark") root.classList.add("sn-carbon");
            var bar = document.querySelector('meta[name="theme-color"]');
            if (bar) bar.setAttribute("content", t === "dark" ? "#0B0B0C" : t === "cloudwheel" ? "#070B18" : t === "kesari" ? "#FFF4E8" : "#E6ECFB");
            if (t === "kesari") { var ic = document.querySelector('link[rel="icon"]'); if (ic) ic.setAttribute("href", "/images/logo-kesari.svg"); }

            var ua = navigator.userAgent || "";
            var touchMac = /Macintosh/.test(ua) && navigator.maxTouchPoints > 1;
            if ((/AppleWebKit/.test(ua) && !/Chrome|Chromium|Edg|OPR|Android/.test(ua)) || /iPhone|iPad|iPod/.test(ua) || touchMac)
                document.documentElement.classList.add("sn-webkit");
        })();
    </script>
    <link rel="stylesheet" href="~/css/safari.css" asp-append-version="true" />
    @* the room in Light, Kesari and Dark (generated by tools/gen_room_themes.py) *@
    <link rel="stylesheet" href="~/css/room-themes.css" asp-append-version="true" />
</head>
<body class="room-body">
    @* studio background: slow aurora light, fine grain and a soft vignette *@
    <div class="studio-bg" aria-hidden="true"><i class="a1"></i><i class="a2"></i><i class="a3"></i><b class="grain"></b><b class="vignette"></b></div>
    @Html.AntiForgeryToken()

    <div class="room">
        <header class="room-head">
            <div class="row gap-12">
                <button type="button" class="btn-icon glass-dark-btn" id="backBtn" aria-label="Leave meeting">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6" /></svg>
                </button>
                <span class="room-mark" aria-hidden="true"><img src="~/favicon.svg" alt="" width="22" height="22" /></span>
                <div>
                    <h1 class="room-title">@Model.Title</h1>
                    <span class="room-sub"><i class="sub-dot"></i>@(Model.ChannelName is null ? (Model.IsGuest ? "Guest" : "ShankhNaad meeting") : Model.ChannelName)</span>
                </div>
            </div>

            <div class="island">
                <span class="live-badge"><i class="rec-dot"></i>LIVE</span>
                <span class="timer" id="timer">00:00</span>
                <span class="island-sep"></span>
                <span class="secure" title="Calls are encrypted in transit"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l7 3v5c0 4.5-3 8.2-7 10-4-1.8-7-5.5-7-10V6l7-3z" /><path d="M9 12l2 2 4-4" /></svg>Encrypted</span>
                <span class="island-sep"></span>
                <span class="signal" id="signal" role="img" aria-label="Connection: checking" title="Connection: checking"><i></i><i></i><i></i><i></i></span>
                <span class="island-sep"></span>
                <span class="island-pill people-pill" title="People in this call · plan limit"><span class="avatar-stack" id="avatarStack"></span><span><span id="peopleCount">1</span><small> / @Model.MaxParticipants</small></span></span>
            </div>

            @* while you share: what you share, for how long, Change and Stop (the browser adds its own bar too) *@
            <div class="share-pill" id="sharePill" role="status" hidden>
                <span class="sp-info"><i class="sp-dot" aria-hidden="true"></i><b>Sharing</b><span id="sharePillWhat">your screen</span><span class="sp-time" id="sharePillTime">00:00</span></span>
                <button type="button" class="sp-change" id="shareChangeBtn" title="Share something else">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 3l4 4-4 4M3 11V9a2 2 0 0 1 2-2h16M7 21l-4-4 4-4M21 13v2a2 2 0 0 1-2 2H3" /></svg>
                    <span>Change</span>
                </button>
                <button type="button" class="sp-stop" id="shareStopBtn">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="5" y="5" width="14" height="14" rx="2" /></svg>
                    <span>Stop sharing</span>
                </button>
            </div>

            <div class="row gap-8">
                @if (Model.GuestUrl is string guestUrl && Model.IsModerator)
                {
                    <input type="hidden" id="guestUrl" value="@guestUrl" />
                    <button type="button" class="guest-btn" data-copy="#guestUrl" title="Copy a link outside people can use to join"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.5.5l3-3a5 5 0 0 0-7-7l-1.7 1.7" /><path d="M14 11a5 5 0 0 0-7.5-.5l-3 3a5 5 0 0 0 7 7l1.7-1.7" /></svg><span>Copy guest link</span></button>
                }
            </div>
        </header>

        <div class="room-main">
            <section class="stage" aria-label="Meeting video">
                <div id="jaas" class="stage-video"></div>
                <div class="react-layer" id="reactLayer" aria-live="polite"></div>
                <div class="stage-chip" id="speakerChip" hidden><span class="avatar av-28" id="speakerAv" aria-hidden="true"></span><span id="speakerName"></span><span class="eq" aria-hidden="true"><i></i><i></i><i></i></span></div>
                @* your own camera, small: Jitsi's thumbnail column is hidden (drag it to any corner) — js/room.js "self view" *@
                <div class="self-view" id="selfView" hidden>
                    <video id="selfVideo" muted playsinline autoplay aria-label="Your camera"></video>
                    <span class="sv-name"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><rect x="9" y="2" width="6" height="12" rx="3" /><path d="M5 10a7 7 0 0 0 14 0" /></svg>You</span>
                    <button type="button" class="sv-hide" id="selfHide" aria-label="Hide your own video" title="Hide your own video"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg></button>
                </div>
                <button type="button" class="self-show" id="selfShow" hidden>Show my video</button>
                @* alone in the call: who is being rung, Ring again / Add people / Copy guest link, and a quick device check *@
                <div class="stage-wait" id="stageWait" hidden>
                    <div class="sw-card">
                        <div class="sw-rings"><i></i><i></i><i></i><span class="avatar av-96" id="waitAv"></span></div>
                        <h2 id="waitTitle">Waiting for others to join</h2>
                        <p id="waitNote">They'll appear here as soon as they join.</p>
                        <div class="sw-acts">
                            <button type="button" class="sw-btn primary" id="waitRing" hidden><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z" /></svg>Ring again</button>
                            <button type="button" class="sw-btn" id="waitAdd" hidden><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="8" r="3.5" /><path d="M2.5 20a6.5 6.5 0 0 1 13 0M19 8v6M16 11h6" /></svg>Add people</button>
                            <button type="button" class="sw-btn" id="waitLink" hidden><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.5.5l3-3a5 5 0 0 0-7-7l-1.7 1.7" /><path d="M14 11a5 5 0 0 0-7.5-.5l-3 3a5 5 0 0 0 7 7l1.7-1.7" /></svg>Copy guest link</button>
                        </div>
                    </div>
                    <div class="sw-check" aria-label="Your devices">
                        <span>Before they join</span>
                        <b id="chkMic">Mic on</b>
                        <b id="chkCam">Camera on</b>
                        <b id="chkNet">Network: checking</b>
                    </div>
                </div>
                <button type="button" class="panel-peek" id="panelPeek" aria-label="Show the side panel" title="Show the side panel (P)" hidden>
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 6l-6 6 6 6" /></svg>
                    <span><b id="peekCount">1</b> in call</span>
                </button>
                @* chat made bigger: the video shrinks to this corner; this brings it back *@
                <div class="share-tip" id="shareTip" role="note" hidden>
                    <div class="st-head">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18h6M10 21h4M12 3a6 6 0 0 0-3.6 10.8c.7.5 1.1 1.3 1.1 2.2h5c0-.9.4-1.7 1.1-2.2A6 6 0 0 0 12 3z" /></svg>
                        <b>Your browser added its own bar</b>
                    </div>
                    <p>Click <b>Hide</b> on it at the bottom of your screen. You can stop sharing from here at any time.</p>
                    <button type="button" id="shareTipOk">Got it</button>
                </div>
                <button type="button" class="stage-restore" id="stageRestore" title="Back to the video">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7" /></svg>
                    <span>Back to video</span>
                </button>
                <div class="stage-loading" id="stageLoading">
                    <div class="orbit"><i></i><i></i><i></i><span class="avatar av-96 tone-@(Model.Tone)">@Model.Initials</span></div>
                    <p>Connecting you to the meeting…</p>
                    <p class="hint">Allow camera and microphone when your browser asks.</p>
                </div>
            </section>

            <div class="panel-scrim" id="panelScrim" aria-hidden="true"></div>
            <aside class="room-panel" id="roomPanel" aria-label="Side panel">
                @* the panel shows one view at a time — People, Chat or Inbox — opened from the buttons in the controls below *@
                <div class="panel-head">
                    <h2 class="ph-t" data-for="people">People <span class="pt-n" id="peopleCount2">1</span></h2>
                    <h2 class="ph-t" data-for="chat" hidden>Chat <span class="pt-n new" id="chatUnread" hidden>0</span></h2>
                    @if (!Model.IsGuest)
                    {
                        <h2 class="ph-t" data-for="msgs" hidden>Inbox <span class="pt-n new" id="msgsUnread" hidden>0</span></h2>
                    }
                    <button type="button" class="panel-pop-btn" id="panelPopBtn" aria-label="Open in a separate window" title="Open in a separate window (keep chatting while you share your screen)">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="7" width="13" height="13" rx="2" /><path d="M14 3h7v7M21 3l-9 9" /></svg>
                    </button>
                    <button type="button" class="panel-max-btn" id="panelMaxBtn" aria-pressed="false" aria-label="Make the chat bigger" title="Make the chat bigger (the video gets small)">
                        <svg class="pm-grow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7" /></svg>
                        <svg class="pm-shrink" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 14h6v6M20 10h-6V4M14 10l7-7M3 21l7-7" /></svg>
                    </button>
                    <small class="ph-sub" id="paneSub">In this call</small>
                </div>
                <div class="pane" id="panePeople">
                <div id="peopleList" class="people-list"></div>
                @if (!Model.IsGuest)
                {
                    <button type="button" class="add-people-btn" id="addPeopleBtn" title="Ring team members into this call">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="8" r="3.5" /><path d="M2.5 20a6.5 6.5 0 0 1 13 0" /><path d="M19 8v6M16 11h6" /></svg>
                        <span>Add people</span>
                    </button>
                    @* who joined, when, for how long: print it, download it, attach it to the chat (AttendanceController) *@
                    <button type="button" class="add-people-btn att-open-btn" id="attOpenBtn" title="Attendance sheet: who joined this call, when and for how long">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="3" width="14" height="18" rx="2" /><path d="M9 3v3h6V3M9 11l1.5 1.5L13 10M9 16h6" /></svg>
                        <span>Attendance sheet</span>
                    </button>
                }
                @if (Model.LobbyEnabled && Model.IsModerator)
                {
                    <p class="hint">Guests wait in the lobby. You'll see a prompt to let them in.</p>
                }
                </div>

                <div class="pane pane-chat" id="paneChat" hidden>
                    @if (!Model.IsGuest && Model.ChatChannelId is not null)
                    {
                        @* a call started from a chat: that chat (its history, files, edit / reply …) is one click away *@
                        <button type="button" class="cc-linked" id="ccLinked">
                            <span class="cc-linked-ic" aria-hidden="true">💬</span>
                            <span class="cc-linked-t"><b>Your chat with @(Model.CallWithName ?? Model.ChannelName ?? "this team")</b><small>All your earlier messages and files. This Chat below is only for this call.</small></span>
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6" /></svg>
                        </button>
                    }
                    <div class="cc-list" id="ccList" aria-live="polite">
                        <div class="cc-empty" id="ccEmpty">
                            <span class="cc-empty-ic" aria-hidden="true">💬</span>
                            <b>Chat with everyone in the call</b>
                            <small>Messages and files you send here are seen by everyone in this call@(Model.IsGuest ? "." : ", and stay with the meeting.")</small>
                        </div>
                    </div>
                    <form class="cc-compose" id="ccForm" autocomplete="off">
                        @if (!Model.IsGuest)
                        {
                            <label class="cc-attach" title="Share a file with everyone in the call">
                                <input type="file" id="ccFile" hidden />
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5l-8.6 8.6a5.5 5.5 0 0 1-7.8-7.8l8.6-8.6a3.7 3.7 0 0 1 5.2 5.2L9.8 17.5a1.8 1.8 0 0 1-2.6-2.6l7.9-7.9" /></svg>
                            </label>
                        }
                        <button type="button" class="cc-emo-btn" data-emoji-for="ccInput" aria-label="Add an emoji" title="Emoji">
                                <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M8.5 14.5a4.5 4.5 0 0 0 7 0M9 9.5h.01M15 9.5h.01" /></svg>
                            </button>
                            <input type="text" id="ccInput" maxlength="2000" placeholder="Message everyone…" aria-label="Message everyone in the call" />
                        <button type="submit" class="cc-send" aria-label="Send" title="Send (Enter)">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 2L11 13" /><path d="M22 2l-7 20-4-9-9-4 20-7z" /></svg>
                        </button>
                    </form>
                    <div class="cc-drop" id="ccDrop" hidden>Drop to share with everyone</div>
                </div>

                @if (!Model.IsGuest)
                {
                    @* Messages: your chats (list), and one chat opened (read and reply) — js/room.js "Messages" *@
                    <div class="pane pane-msgs" id="paneMsgs" hidden>
                        <div class="mx-list" id="mxList" aria-label="Your chats">
                            <div class="mx-empty">Loading your chats…</div>
                        </div>
                        <div class="mx-chat" id="mxChat" hidden>
                            <div class="mx-head">
                                <button type="button" class="mx-back" id="mxBack" aria-label="Back to your chats" title="Back">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6" /></svg>
                                </button>
                                <span class="avatar av-32" id="mxAv"></span>
                                <b id="mxName"></b>
                                <button type="button" class="mx-callchat" id="mxCallChat" hidden title="Call chat: the chat of this call only (everyone in the call, guests too)" aria-label="Call chat: the chat of this call only">Call chat<i id="mxCallChatN" hidden></i></button>
                                <a class="mx-open" id="mxOpen" href="/chat" target="_blank" rel="noopener" title="Open in Chat (new tab)" aria-label="Open in Chat in a new tab">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 4h6v6M20 4l-9 9M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5" /></svg>
                                </a>
                            </div>
                            <div class="mx-msgs" id="mxMsgs" aria-live="polite"></div>
                            @* replying to / editing a message: shown above the box, ✕ cancels *@
                            <div class="mx-ctx" id="mxCtx" hidden>
                                <span class="mx-ctx-t"><b id="mxCtxTitle"></b><small id="mxCtxText"></small></span>
                                <button type="button" class="mx-ctx-x" id="mxCtxX" aria-label="Cancel" title="Cancel (Esc)">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
                                </button>
                            </div>
                            <form class="cc-compose mx-compose" id="mxForm" autocomplete="off">
                                <label class="cc-attach" title="Attach a file (or paste / drop it here)">
                                    <input type="file" id="mxFile" multiple hidden />
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5l-8.6 8.6a5.5 5.5 0 0 1-7.8-7.8l8.6-8.6a3.7 3.7 0 0 1 5.2 5.2L9.8 17.5a1.8 1.8 0 0 1-2.6-2.6l7.9-7.9" /></svg>
                                </label>
                                <button type="button" class="cc-emo-btn" data-emoji-for="mxInput" aria-label="Add an emoji" title="Emoji">
                                <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M8.5 14.5a4.5 4.5 0 0 0 7 0M9 9.5h.01M15 9.5h.01" /></svg>
                            </button>
                            <input type="text" id="mxInput" maxlength="4000" placeholder="Reply…" aria-label="Your reply" />
                                <button type="submit" class="cc-send" aria-label="Send" title="Send (Enter)">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 2L11 13" /><path d="M22 2l-7 20-4-9-9-4 20-7z" /></svg>
                                </button>
                            </form>
                        </div>
                    </div>
                }
            </aside>
        </div>

        <footer class="dock" aria-label="Meeting controls">
            <div class="dock-item"><button type="button" class="dock-btn" id="micBtn" aria-pressed="false" aria-label="Mute microphone">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="2" width="6" height="12" rx="3" /><path d="M5 10a7 7 0 0 0 14 0M12 17v4M8 21h8" /><path class="slash" d="M3 3l18 18" /></svg>
            </button><span id="micLabel">Mute</span></div>
            <div class="dock-item"><button type="button" class="dock-btn" id="camBtn" aria-pressed="false" aria-label="Turn camera off">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="6" width="13" height="12" rx="3" /><path d="M16 10l5-3v10l-5-3z" /><path class="slash" d="M3 3l18 18" /></svg>
            </button><span id="camLabel">Stop video</span></div>
            <div class="dock-item"><button type="button" class="dock-btn" id="shareBtn" aria-pressed="false" aria-label="Share your screen">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="13" rx="3" /><path d="M8 21h8M12 17v4M12 13V8M9.5 10.5L12 8l2.5 2.5" /></svg>
            </button><span id="shareLabel">Share</span></div>
            @if (!Model.IsGuest)
            {
                @* Hold: mic, camera and the call's sound off for a moment (e.g. to answer another call) *@
                <div class="dock-item"><button type="button" class="dock-btn" id="holdBtn" aria-pressed="false" aria-label="Put the call on hold" title="Put the call on hold">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M10 9v6M14 9v6" /></svg>
                </button><span id="holdLabel">Hold</span></div>
            }
            <div class="dock-item"><button type="button" class="dock-btn" id="handBtn" aria-pressed="false" aria-label="Raise hand">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 11V6a2 2 0 0 0-4 0M14 10V4a2 2 0 0 0-4 0v2M10 10.5V6a2 2 0 0 0-4 0v8" /><path d="M18 8a2 2 0 1 1 4 0v6a8 8 0 0 1-8 8h-2c-2.8 0-4.5-.9-6-2.4l-3.6-3.6a2 2 0 0 1 2.8-2.8L7 15" /></svg>
            </button><span id="handLabel">Raise</span></div>
            <div class="dock-item react-wrap"><button type="button" class="dock-btn" id="reactBtn" aria-expanded="false" aria-label="React" title="React (R)">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M8.5 14.5a4.5 4.5 0 0 0 7 0" /><path d="M9 9.5h.01M15 9.5h.01" /></svg>
            </button><span>React</span>
                <div class="react-tray" id="reactTray" role="menu" aria-label="Reactions" hidden>
                    <button type="button" role="menuitem" data-emoji="👍" title="Like">👍</button>
                    <button type="button" role="menuitem" data-emoji="👏" title="Applause">👏</button>
                    <button type="button" role="menuitem" data-emoji="❤️" title="Love">❤️</button>
                    <button type="button" role="menuitem" data-emoji="😂" title="Laugh">😂</button>
                    <button type="button" role="menuitem" data-emoji="😮" title="Surprised">😮</button>
                    <button type="button" role="menuitem" data-emoji="🎉" title="Celebrate">🎉</button>
                    <button type="button" role="menuitem" data-emoji="🙌" title="Well done">🙌</button>
                    <button type="button" role="menuitem" data-emoji="🙏" title="Thank you">🙏</button>
                </div>
            </div>
            <div class="dock-item"><button type="button" class="dock-btn" id="panelBtn" aria-pressed="false" aria-label="People in the call (P)" title="People (P)">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="8" r="3.5" /><path d="M2.5 20a6.5 6.5 0 0 1 13 0" /><path d="M16 4.5a3.5 3.5 0 0 1 0 7" /><path d="M18 14a6 6 0 0 1 3.5 6" /></svg>
            </button><span id="panelLabel">People</span></div>
            <div class="dock-item"><button type="button" class="dock-btn" id="chatBtn" aria-pressed="false" aria-label="Chat with everyone in the call" title="Chat (C)">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a8 8 0 0 1-11.6 7.1L4 20.5l1.4-4.6A8 8 0 1 1 21 12z" /><path d="M8.5 11h7M8.5 14h4" /></svg>
                <span class="dock-badge" id="chatBadge" hidden>0</span>
            </button><span>Chat</span></div>
            @if (!Model.IsGuest)
            {
                <div class="dock-item"><button type="button" class="dock-btn" id="inboxBtn" aria-pressed="false" aria-label="Inbox: your other chats (M)" title="Inbox (M)">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 12h-6l-2 3h-4l-2-3H2" /><path d="M5.5 5h13l3.5 7v6a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2v-6z" /></svg>
                    <span class="dock-badge" id="msgsBadge" hidden>0</span>
                </button><span>Inbox</span></div>
            }
            <div class="dock-item"><button type="button" class="dock-btn" id="ccBtn" aria-pressed="false" aria-label="Live captions">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="5" width="20" height="14" rx="4" /><path d="M10 10.5a2.5 2.5 0 1 0 0 3M17 10.5a2.5 2.5 0 1 0 0 3" /></svg>
            </button><span>Captions</span></div>
            <div class="dock-item"><button type="button" class="dock-btn" id="tileBtn" aria-pressed="false" aria-label="Switch between speaker and grid view">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7.5" height="7.5" rx="2" /><rect x="13.5" y="3" width="7.5" height="7.5" rx="2" /><rect x="3" y="13.5" width="7.5" height="7.5" rx="2" /><rect x="13.5" y="13.5" width="7.5" height="7.5" rx="2" /></svg>
            </button><span>Grid</span></div>
            <div class="dock-item"><button type="button" class="dock-btn" id="fullBtn" aria-pressed="false" aria-label="Full screen (F)" title="Full screen (F)">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path class="fs-open" d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5" /><path class="fs-close" d="M9 4v5H4M15 4v5h5M9 20v-5H4M15 20v-5h5" /></svg>
            </button><span id="fullLabel">Full screen</span></div>
            <span class="dock-sep" aria-hidden="true"></span>
            <div class="dock-item"><button type="button" class="leave-btn" id="leaveBtn">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 17l5-5-5-5M15 12H3M21 4v16" /></svg>Leave
            </button><span>End for me</span></div>
        </footer>
    </div>
    <div class="toasts" id="toasts" aria-live="polite"></div>

    @* ---- Add people: ring team members into this call ---- *@
    <dialog class="add-dlg" id="addDlg" aria-labelledby="addDlgTitle">
        <div class="add-dlg-head">
            <span class="add-dlg-ic"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="8" r="3.5" /><path d="M2.5 20a6.5 6.5 0 0 1 13 0" /><path d="M19 8v6M16 11h6" /></svg></span>
            <div><h2 id="addDlgTitle">Add people to this call</h2><p>Pick team members. Their screen rings and they join with Accept.</p></div>
            <button type="button" class="add-dlg-x" data-close aria-label="Close">&times;</button>
        </div>
        <label class="add-dlg-search">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="M20 20l-3.5-3.5" /></svg>
            <input type="search" id="addSearch" placeholder="Search your team" aria-label="Search your team" autocomplete="off" />
        </label>
        <div class="add-dlg-list" id="addList" role="listbox" aria-multiselectable="true"><p class="add-dlg-empty">Loading your team…</p></div>
        <div class="add-dlg-foot">
            <span id="addPicked">Nobody picked yet</span>
            <button type="button" class="add-dlg-cancel" data-close>Cancel</button>
            <button type="button" class="add-dlg-ring" id="addRing" disabled>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z" /></svg>
                <span id="addRingText">Ring</span>
            </button>
        </div>
    </dialog>

    @if (!Model.IsGuest)
    {
    @* ---- Attendance sheet: who joined this call, when and for how long ---- *@
    <dialog class="add-dlg att-dlg" id="attDlg" aria-labelledby="attDlgTitle">
        <div class="add-dlg-head">
            <span class="add-dlg-ic att-ic"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="3" width="14" height="18" rx="2" /><path d="M9 3v3h6V3M9 11l1.5 1.5L13 10M9 16h6" /></svg></span>
            <div><h2 id="attDlgTitle">Attendance sheet</h2><p id="attSub">Who joined this call, when and for how long. It updates while the call goes on.</p></div>
            <button type="button" class="add-dlg-x" data-close aria-label="Close">&times;</button>
        </div>
        <div class="att-chips" id="attChips"></div>
        <div class="att-list" id="attList"><p class="add-dlg-empty">Loading…</p></div>
        <div class="add-dlg-foot att-foot">
            <button type="button" class="add-dlg-cancel att-act" id="attPrint" title="Open a page made for printing (or Save as PDF)">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9V3h12v6" /><rect x="3" y="9" width="18" height="8" rx="2" /><path d="M7 14h10v7H7z" /></svg>Print</button>
            <a class="add-dlg-cancel att-act" id="attDownload" href="#" title="Download as an Excel file">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v12M7 11l5 5 5-5M4 20h16" /></svg>Download Excel</a>
            <button type="button" class="add-dlg-ring" id="attShare" title="Attach the Excel sheet to the call chat and to the chat this call was started from">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.5l-8.5 8.5a6 6 0 0 1-8.5-8.5l9-9a4 4 0 0 1 5.7 5.7l-9 9a2 2 0 0 1-2.8-2.8l8.3-8.3" /></svg>
                <span>Attach to chat</span>
            </button>
        </div>
    </dialog>
    }

    <script id="roomConfig" type="application/json">@Html.Raw(JsonSerializer.Serialize(config))</script>
    @if (!Model.IsGuest)
    {
        <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
    }
    <script src="@Model.Join.ScriptUrl"></script>
    <script src="~/js/tooltip.js" asp-append-version="true"></script>
    <script src="~/js/emoji-picker.js" asp-append-version="true"></script>
    <script src="~/js/room.js" asp-append-version="true"></script>
</body>
</html>
