@inject ShankhNaad.Web.Infrastructure.AssetBundles Bundles
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#E6ECFB" />
    <title>@(ViewData["Title"] is string t ? $"{t} · ShankhNaad" : "ShankhNaad")</title>
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="~/icons/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;600;700;800;900&family=Inter:wght@400;500;600;700&display=swap" />
    @* The sign-in pages open in the theme chosen last in the app (kept on this device until it is changed),
       set before the styles load so there is no flash. Safari / iPhone / iPad get a lighter glass setup (css/safari.css). *@
    <script>
        (function () {
            var root = document.documentElement, t = null;
            try {
                t = localStorage.getItem("sn-theme3");
                if (!t) { var old = localStorage.getItem("sn-theme"); if (old === "dark") t = "cloudwheel"; else if (old === "light") t = "light"; }
            } catch (e) { }
            if (t !== "dark" && t !== "light" && t !== "cloudwheel" && t !== "kesari") t = window.matchMedia && matchMedia("(prefers-color-scheme: dark)").matches ? "cloudwheel" : "light";
            root.setAttribute("data-theme", t === "light" || t === "kesari" ? "light" : "dark");
            root.setAttribute("data-skin", t);
            if (t === "dark") root.classList.add("sn-carbon");
            var bar = document.querySelector('meta[name="theme-color"]');
            if (bar) bar.setAttribute("content", t === "dark" ? "#0B0B0C" : t === "cloudwheel" ? "#0B1020" : t === "kesari" ? "#FFF4E8" : "#E6ECFB");
            if (t === "kesari") { var ic = document.querySelector('link[rel="icon"]'); if (ic) ic.setAttribute("href", "/images/logo-kesari.svg"); }

            var ua = navigator.userAgent || "", touchMac = /Macintosh/.test(ua) && navigator.maxTouchPoints > 1;
            if ((/AppleWebKit/.test(ua) && !/Chrome|Chromium|Edg|OPR|Android/.test(ua)) || /iPhone|iPad|iPod/.test(ua) || touchMac)
                root.classList.add("sn-webkit");
        })();
    </script>
    @* the sign-in pages' styles in one file (Infrastructure/AssetBundles.cs) *@
    @Bundles.Tags("auth.css")
</head>
<body class="auth-body sn-body">
    <div class="sn-backdrop" aria-hidden="true">
        <span class="blob b1"></span><span class="blob b2"></span>
        <span class="orb o2"></span><span class="orb o4"></span>
    </div>
    <main class="auth-wrap">
        @RenderBody()
    </main>
    <script src="~/js/sn-nav.js" asp-append-version="true"></script>
    <script src="~/lib/Mordern-Controls/JS/jquery-3.7.1.min.js"></script>
    @Bundles.Tags("auth.js")
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
