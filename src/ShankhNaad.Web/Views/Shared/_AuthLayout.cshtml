<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#2563EB" />
    <title>@(ViewData["Title"] is string t ? $"{t} · ShankhNaad" : "ShankhNaad")</title>
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="~/icons/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;600;700;800;900&family=Inter:wght@400;500;600;700&display=swap" />
    <link rel="stylesheet" href="~/lib/Mordern-Controls/bootstrap-icon/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/lib/Mordern-Controls/font-awesome-4.7.0/css/font-awesome.min.css" />
    <link rel="stylesheet" href="~/css/Theme/controls-theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/buttons.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/web-control/modern-input.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/web-control/modern-checkbox.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/web-control/tab-control.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/web-control/cee-group-box-modern.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/web-control/messagebox.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/shankhnaad.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/shankhnaad-auth.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/safari.css" asp-append-version="true" />
    @* Safari / iPhone / iPad: a lighter glass setup (css/safari.css) *@
    <script>
        (function () {
            var ua = navigator.userAgent || "", touchMac = /Macintosh/.test(ua) && navigator.maxTouchPoints > 1;
            if ((/AppleWebKit/.test(ua) && !/Chrome|Chromium|Edg|OPR|Android/.test(ua)) || /iPhone|iPad|iPod/.test(ua) || touchMac)
                document.documentElement.classList.add("sn-webkit");
        })();
    </script>
</head>
<body class="auth-body sn-body">
    <div class="sn-backdrop" aria-hidden="true">
        <span class="blob b1"></span><span class="blob b2"></span>
        <span class="orb o2"></span><span class="orb o4"></span>
    </div>
    <main class="auth-wrap">
        @RenderBody()
    </main>
    <script src="~/lib/Mordern-Controls/JS/jquery-3.7.1.min.js"></script>
    <script src="~/js/web-control/modern-input.js" asp-append-version="true"></script>
    <script src="~/js/web-control/modern-checkbox.js" asp-append-version="true"></script>
    <script src="~/js/web-control/tab-control.js" asp-append-version="true"></script>
    <script src="~/js/web-control/messagebox.js" asp-append-version="true"></script>
    <script src="~/js/toast.js" asp-append-version="true"></script>
    <script src="~/js/pwa-install.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
