@inject ShankhNaad.Web.Infrastructure.AssetBundles Bundles
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#2563EB" />
    <title>@(ViewData["Title"] is string t ? $"{t} · ShankhNaad" : "ShankhNaad")</title>
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="~/icons/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;600;700;800;900&family=Inter:wght@400;500;600;700&display=swap" />
    @* the sign-in pages' styles in one file (Infrastructure/AssetBundles.cs) *@
    @Bundles.Tags("auth.css")
    @* Safari / iPhone / iPad: a lighter glass setup (css/safari.css) *@
    <script>
        (function () {
            var ua = navigator.userAgent || "", touchMac = /Macintosh/.test(ua) && navigator.maxTouchPoints > 1;
            if ((/AppleWebKit/.test(ua) && !/Chrome|Chromium|Edg|OPR|Android/.test(ua)) || /iPhone|iPad|iPod/.test(ua) || touchMac)
                document.documentElement.classList.add("sn-webkit");
        })();
    </script>
</head>
<body class="auth-body sn-body">
    <div class="sn-backdrop" aria-hidden="true">
        <span class="blob b1"></span><span class="blob b2"></span>
        <span class="orb o2"></span><span class="orb o4"></span>
    </div>
    <main class="auth-wrap">
        @RenderBody()
    </main>
    <script src="~/js/sn-nav.js" asp-append-version="true"></script>
    <script src="~/lib/Mordern-Controls/JS/jquery-3.7.1.min.js"></script>
    @Bundles.Tags("auth.js")
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
