@inject ShankhNaad.Web.Infrastructure.AssetBundles Bundles
@{
    var section = ViewData["Section"] as string ?? "";
    var isTenantAdmin = User.IsInRole(AppRoles.TenantAdmin);
    var isSuperAdmin = User.IsInRole(AppRoles.SuperAdmin);
    var roleText = isSuperAdmin ? "CloudWheel super admin" : isTenantAdmin ? "Workspace admin" : "Member";
    var workspace = isSuperAdmin ? "CloudWheel Ltd" : User.TenantName();
    var version = System.Reflection.Assembly.GetEntryAssembly()?.GetName().Version?.ToString(3) ?? "1.0.0";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#2563EB" />
    <title>@(ViewData["Title"] is string t ? $"{t} · ShankhNaad" : "ShankhNaad")</title>
    @* Theme (light / dark) is applied before anything paints, so there is no flash. *@
    <script>
        (function () {
            var root = document.documentElement;
            var t = null;
            try { t = localStorage.getItem("sn-theme"); } catch (e) { }
            if (t !== "dark" && t !== "light") t = window.matchMedia && matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
            root.setAttribute("data-theme", t);

            // Safari (Mac) and every browser on iPhone / iPad use WebKit: it redraws frosted glass far more slowly,
            // so css/safari.css gives it a lighter, still-glassy setup (see that file).
            var ua = navigator.userAgent || "";
            var touchMac = /Macintosh/.test(ua) && navigator.maxTouchPoints > 1;          // iPad asking for the desktop site
            var webkit = (/AppleWebKit/.test(ua) && !/Chrome|Chromium|Edg|OPR|Android/.test(ua)) || /iPhone|iPad|iPod/.test(ua) || touchMac;
            if (webkit) root.classList.add("sn-webkit");

            // Background spheres keep moving from where they were on the last page (no jump on every page change).
            root.style.setProperty("--sn-orb-t", "-" + ((Date.now() / 1000) % 600).toFixed(2) + "s");

            // Page arrival in three steps, so the animation runs on its own and the data never fights it:
            //   1. the page frame slides in (view transition)   2. header and cards rise in
            //   3. only then the data (table rows, gauges, chat messages) fades in, row by row.
            var reduce = window.matchMedia && matchMedia("(prefers-reduced-motion: reduce)").matches;
            var started = false, gen = 0, timers = [];
            function later(fn, ms) { timers.push(setTimeout(fn, ms)); }
            function arrive(vt) {
                if (started || reduce) return;
                started = true;
                var my = ++gen;                                     // a newer arrival cancels this one
                root.classList.add("sn-arriving", "sn-data-wait");
                var shown = false;
                function showData() {
                    if (shown || my !== gen) return;
                    shown = true;
                    root.classList.remove("sn-data-wait");
                    root.classList.add("sn-data-in");
                    root.setAttribute("data-arrived", "1");
                    document.dispatchEvent(new Event("sn:arrived"));   // toast.js shows waiting messages now
                    later(function () { if (my === gen) root.classList.remove("sn-data-in", "sn-arriving"); }, 1700);
                }
                later(showData, 1200);                              // safety net: data always appears
                if (vt && vt.finished) vt.finished.then(function () { later(showData, 40); }, showData);
                else if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", function () { later(showData, 340); });
                else later(showData, 340);
            }
            // partial page loads (js/sn-nav.js) run the same arrival for the page they swap in
            window.SN = window.SN || {};
            SN._arrive = function (vt) {
                timers.forEach(function (t) { clearTimeout(t); }); timers = [];
                gen++;
                root.classList.remove("sn-arriving", "sn-data-wait", "sn-data-in");
                started = false;
                arrive(vt);
            };

            // Safari: its page swap (view transition) snapshots the page and makes it jerky, so it is skipped
            // and the page frame rises in with plain CSS instead (css/safari.css part 4). Cards and data
            // then arrive exactly as in Edge / Chrome.
            if (webkit) {
                window.addEventListener("pagereveal", function (e) { if (e.viewTransition) e.viewTransition.skipTransition(); });
                root.classList.add("sn-no-vt");
                arrive(null);
                return;
            }

            window.addEventListener("pagereveal", function (e) {
                var dir = null;
                try { dir = sessionStorage.getItem("sn-dir"); sessionStorage.removeItem("sn-dir"); } catch (x) { }
                if (e.viewTransition) {
                    root.classList.add("sn-arrive");
                    if (dir && e.viewTransition.types) e.viewTransition.types.add(dir);
                }
                arrive(e.viewTransition);
            });
            if (!("onpagereveal" in window)) { root.classList.add("sn-no-vt"); arrive(null); }
        })();
    </script>
    @* Partial page loads: links and forms swap only the middle of the page (and prefetch rail pages on hover). *@
    <script src="~/js/sn-nav.js" asp-append-version="true"></script>
    @* Edge/Chrome: show the new page only once the whole page (and its scripts) is in, so the tab highlight
       and table are already in place when the page change starts. Other browsers ignore this. *@
    <link rel="expect" href="#sn-ready" blocking="render" />
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" />
    @* Desktop app (installable web app) *@
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="~/icons/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;600;700;800;900&family=Inter:wght@400;500;600;700&display=swap" />

    @* All styles of the workspace pages in one file (Infrastructure/AssetBundles.cs: same files, same order) *@
    @Bundles.Tags("layout.css")
    @await RenderSectionAsync("Head", required: false)
</head>
<body class="sn-body" data-me="@(isSuperAdmin ? "" : User.UserId())">
    <div class="sn-backdrop" aria-hidden="true">
        <span class="blob b1"></span><span class="blob b2"></span><span class="blob b3"></span>
        <span class="orb o1"></span><span class="orb o2"></span><span class="orb o3"></span><span class="orb o4"></span><span class="orb o5"></span>
    </div>
    @Html.AntiForgeryToken()

    <script src="~/lib/Mordern-Controls/JS/jquery-3.7.1.min.js"></script>

    <div class="shell sn-shell">
        @* "rail" class is kept: site.js starts the live connection only when it finds .rail *@
        <div class="rail sn-rail glass">
            <report-rail id="MainRail"
                         rail-width="88px"
                         rail-height="auto"
                         show-logo="true"
                         logo-image-url="/images/logo.svg"
                         logo-background="linear-gradient(115deg, #2563EB 0%, #DB2777 100%)"
                         logo-width="50px"
                         logo-height="50px"
                         logo-border-radius="16px"
                         divider-width="40px"
                         divider-color="rgba(15,23,42,.12)"
                         background-color="transparent"
                         selection-color="rgba(255,255,255,.85)"
                         active-icon-color="#BE185D"
                         active-label-color="#0B1220"
                         active-bar-color="linear-gradient(180deg, #2563EB, #DB2777)"
                         icon-size="20px"
                         label-font-size="11.5px"
                         label-font-weight="600">
                @if (!isSuperAdmin)
                {
                    <rail-item key="chat" label="Chat" icon="comments-o" href="/chat" active="@(section == "chat")"></rail-item>
                    <rail-item key="calls" label="Calls" icon="phone" href="/calls" active="@(section == "calls")"></rail-item>
                    <rail-item key="meetings" label="Meetings" icon="calendar" href="/meetings" active="@(section == "meetings")"></rail-item>
                    <rail-item key="files" label="Files" icon="folder-open" href="/files" active="@(section == "files")"></rail-item>
                    @* everyone in the workspace can see the team; only admins can change it (see TeamController) *@
                    <rail-item key="team" label="Team" icon="users" href="/team" active="@(section == "team")"></rail-item>
                }
                @if (isSuperAdmin)
                {
                    <rail-item key="admin" label="Clients" icon="shield" href="/admin" active="@(section == "admin")"></rail-item>
                }
            </report-rail>

            <div class="sn-rail-foot">
                <button type="button" class="sn-rail-btn sn-alerts-btn" id="alertsBtn" hidden aria-label="Turn on call alerts" title="Turn on call alerts">
                    <i class="fa fa-bell-o" style="font-size:19px" aria-hidden="true"></i>
                </button>
            </div>
        </div>

        <div class="sn-col">
            @* ---------- top bar: Template 1 strip-header with the user menu ---------- *@
            <div class="sn-topbar glass">
                <strip-header heading="@workspace"
                              subheading="@(isSuperAdmin ? "ShankhNaad · all client workspaces" : "ShankhNaad workspace")"
                              icon-src="/images/workspace.svg"
                              icon-size="42"
                              icon-image-size="58%"
                              icon-background-color="rgba(255,255,255,.65)"
                              icon-border-color="rgba(255,255,255,.95)"
                              icon-border-width="1"
                              heading-font-size="18"
                              heading-font-weight="800"
                              heading-font-family="Roboto, system-ui, sans-serif"
                              heading-gradient-start="#1D4ED8"
                              heading-gradient-mid="#6D28D9"
                              heading-gradient-end="#BE185D"
                              heading-gradient-start-hold-percent="20"
                              heading-gradient-mid-stop-percent="65"
                              heading-fallback-color="#1D4ED8"
                              subheading-font-size="12"
                              subheading-font-weight="600"
                              subheading-font-family="Roboto, system-ui, sans-serif"
                              subheading-gradient-start="#334155"
                              subheading-gradient-end="#334155"
                              background-transparent="true"
                              padding="0 6px 0 4px"
                              border-radius="22px"
                              user-name="@User.DisplayName()"
                              user-initials="@User.Initials()"
                              login-time="@roleText"
                              user-avatar-size="40"
                              help-text="About ShankhNaad"
                              show-install="true"
                              install-text="Install desktop app"
                              chevron-background-color="#2563EB">
                    <button type="button" class="sn-theme-btn" onclick="SN.toggleTheme(event)" aria-label="Switch light or dark theme" title="Light / dark theme">
                        <i class="fa fa-moon-o sn-ic-moon" aria-hidden="true"></i><i class="fa fa-sun-o sn-ic-sun" aria-hidden="true"></i>
                    </button>
                    <span class="sn-pill" id="snConn" data-state="wait"><span class="sn-pill-dot"></span><span>Connecting…</span></span>
                    <span class="sn-pill"><i class="fa fa-clock-o" aria-hidden="true"></i><span id="snClock"></span></span>
                </strip-header>
            </div>
            <form method="post" asp-antiforgery="true" action="/account/logout" id="logoutForm" hidden></form>

            <div class="sn-body-row">
                <script data-sn-skip>SN.nav && SN.nav.begin();</script>
                @RenderBody()
                <script data-sn-skip>SN.nav && SN.nav.pause();</script>
            </div>
        </div>
    </div>

    @* ---------- About ShankhNaad ---------- *@
    <dialog id="aboutDialog" class="sn-dialog glass-strong" aria-labelledby="aboutTitle">
        <div>
            <div class="sn-about-head">
                <button type="button" class="sn-close" data-close aria-label="Close" style="position:absolute;right:16px;top:16px"><i class="fa fa-times" aria-hidden="true"></i></button>
                <img src="~/favicon.svg" alt="" width="84" height="84" class="sn-about-logo" />
                <h2 id="aboutTitle" class="sn-about-title">SHANKHNAAD</h2>
                <div class="muted small">Team chat and video meetings · by CloudWheel Ltd</div>
                <span class="sn-pill">Version @version</span>
            </div>
            <div class="sn-dlg-body" style="gap:8px">
                <div class="sn-kv"><span>Licensed to</span><b>CloudWheel Ltd</b></div>
                <div class="sn-kv"><span>Workspace</span><b>@workspace</b></div>
                <div class="sn-kv"><span>Signed in as</span><b>@User.DisplayName() · @roleText</b></div>
                <div class="sn-kv"><span>Running as</span><b data-running-as>Web browser</b></div>
                <div class="sn-verse-box">
                    <em>Sam gacchadhvam sam vadadhvam, sam vo manamsi janatam.</em>
                    <span>“Walk together, speak together, let your minds be in harmony.” — Rig Veda 10.191.2</span>
                </div>
            </div>
            <div class="sn-dlg-foot">
                <span class="muted small">© @DateTime.UtcNow.Year CloudWheel Ltd</span>
                <span style="display:flex;gap:10px">
                    <button type="button" class="cee-btn sn-btn-light" data-install-only onclick="document.getElementById('aboutDialog').close();document.getElementById('installDialog').showModal()"><i class="fa fa-desktop"></i> Desktop app</button>
                    <button type="button" class="cee-btn cee-btn-gradient" data-close>Close</button>
                </span>
            </div>
        </div>
    </dialog>

    @* ---------- Install as a desktop app ---------- *@
    <dialog id="installDialog" class="sn-dialog glass-strong" aria-labelledby="installTitle" style="width:min(640px, calc(100vw - 32px))">
        <div>
            <div class="sn-dlg-head">
                <div class="sn-dlg-title">
                    <span class="sn-dlg-icon"><i class="fa fa-desktop" aria-hidden="true"></i></span>
                    <div><h2 id="installTitle">Use ShankhNaad as a desktop app</h2><p>Install once. It opens in its own window, without the browser.</p></div>
                </div>
                <button type="button" class="sn-close" data-close aria-label="Close"><i class="fa fa-times" aria-hidden="true"></i></button>
            </div>
            <div class="sn-dlg-body">
                <div class="sn-perks">
                    <div><span class="sn-perk-ic"><i class="fa fa-window-maximize"></i></span><span><b>Its own window and taskbar icon</b><small>Pin it next to Outlook and Excel</small></span></div>
                    <div><span class="sn-perk-ic"><i class="fa fa-bell-o"></i></span><span><b>Calls ring on your desktop</b><small>Windows notifications for incoming calls</small></span></div>
                    <div><span class="sn-perk-ic"><i class="fa fa-arrows-alt"></i></span><span><b>Opens fast, full screen meetings</b><small>No tabs or address bar in the way</small></span></div>
                    <div><span class="sn-perk-ic"><i class="fa fa-refresh"></i></span><span><b>Always up to date</b><small>Updates itself from your server</small></span></div>
                </div>
                <div class="sn-steps">
                    <span><b>1</b>Press Install app</span>
                    <span><b>2</b>Confirm in the browser box</span>
                    <span><b>3</b>Pin it to the taskbar</span>
                </div>
            </div>
            <div class="sn-dlg-foot">
                <span class="muted small">Works in Chrome and Edge on Windows and Mac</span>
                <span style="display:flex;gap:10px">
                    <button type="button" class="cee-btn sn-btn-light" data-close>Not now</button>
                    <button type="button" class="cee-btn cee-btn-gradient" onclick="SN.installApp()"><i class="fa fa-download"></i> Install app</button>
                </span>
            </div>
        </div>
    </dialog>

    @* ---- incoming call: a ringing card at the bottom right, like Microsoft Teams ---- *@
    <div class="sn-call" id="callOverlay" role="alertdialog" aria-labelledby="callWho" aria-describedby="callTitle" hidden>
        <div class="sn-call-top">
            <span class="sn-call-app"><i class="fa fa-video-camera" aria-hidden="true"></i> Incoming video call</span>
            <button type="button" class="sn-call-mute" id="callSilence" title="Silence the ring" aria-label="Silence the ring"><i class="fa fa-bell-slash" aria-hidden="true"></i></button>
        </div>
        <div class="sn-call-who">
            <span class="sn-call-rings"><i></i><i></i><i></i><span class="avatar av-56" id="callAvatar">?</span></span>
            <span class="sn-call-text">
                <b id="callWho">Someone</b>
                <small id="callTitle">is calling you</small>
            </span>
        </div>
        <div class="sn-call-actions">
            <span class="sn-call-decline-wrap">
                <button type="button" class="sn-call-btn decline" id="callDecline" title="Decline"><i class="fa fa-phone" aria-hidden="true"></i><span>Decline</span></button>
                <button type="button" class="sn-call-more" id="callDeclineMore" title="Decline with a message" aria-label="Decline with a message" aria-expanded="false"><i class="fa fa-comment" aria-hidden="true"></i></button>
            </span>
            <a class="sn-call-btn accept" id="callAccept" href="#" title="Accept with video"><i class="fa fa-video-camera" aria-hidden="true"></i><span>Accept</span></a>
        </div>
        @* decline with a quick message; it's also posted in your chat with the caller *@
        <div class="sn-call-replies" id="callReplies" hidden>
            <button type="button" class="sn-call-reply">Can't talk now. I'll call you back.</button>
            <button type="button" class="sn-call-reply">In a meeting, will call you later.</button>
            <button type="button" class="sn-call-reply">Call me in 10 minutes.</button>
            <button type="button" class="sn-call-reply">Please message me instead.</button>
            <span class="sn-call-own"><input type="text" id="callReplyText" maxlength="300" placeholder="Write a message…" aria-label="Your message" /><button type="button" id="callReplySend" aria-label="Decline and send"><i class="fa fa-paper-plane" aria-hidden="true"></i></button></span>
        </div>
        <span class="sn-call-timer" id="callTimer" aria-hidden="true"></span>
    </div>
    <div class="toasts" id="toasts" aria-live="polite"></div>

    @* Template 1 control scripts, in one file (Infrastructure/AssetBundles.cs) *@
    @Bundles.Tags("controls.js")

    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
    @* ShankhNaad's own scripts, in one file: toast, tooltip, mobile, site, meeting-alerts, shankhnaad, people-picker, pwa-install *@
    @Bundles.Tags("app.js")
    @* The page's own scripts. Kept in one box so a partial page load can find and run them again. *@
    <script data-sn-skip>SN.nav && SN.nav.resume();</script>
    <div id="sn-page-scripts" hidden>@await RenderSectionAsync("Scripts", required: false)</div>
    <script data-sn-skip>SN.nav && SN.nav.endSync();</script>
    <span id="sn-ready" hidden></span>
</body>
</html>
